@layout()
@slot('title')
<title>Sign Up</title>
@endslot

<div class="relative z-10 min-h-screen overflow-hidden flex items-center justify-center px-4 py-4">
  <div class="absolute inset-0">
    <img src="resources/images/welcome/header3.png" class="w-full h-full object-cover" alt="">
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-[#1E3D19]/85 via-[#728B6F]/65 to-[#6B8C6C]/85"></div>
    <div class="absolute top-10 left-10 w-56 h-56 bg-[#EDE7D6]/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-10 right-10 w-72 h-72 bg-white/5 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute inset-0 backdrop-blur-[2px]"></div>
  </div>

  <a href="/" class="absolute top-5 left-5 z-30 group inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-xl border border-white/10 text-[#EDE7D6] text-sm font-semibold shadow-[0_10px_30px_rgba(0,0,0,0.2)] hover:bg-[#EDE7D6] hover:text-[#1E3D19] transition-all duration-300">
    <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="M15 19l-7-7 7-7"></path>
    </svg>
    Back
  </a>

  <div class="relative z-20 w-full max-w-5xl">
    <div class="absolute -inset-2 bg-gradient-to-r from-white/10 via-[#EDE7D6]/10 to-white/10 blur-3xl rounded-[3rem] opacity-90"></div>

    <div class="relative bg-white/10 backdrop-blur-3xl border border-white/10 rounded-[3rem] px-6 py-7 md:px-8 md:py-8 shadow-[0_35px_120px_rgba(0,0,0,0.35)] overflow-hidden">
      <div class="absolute -top-20 -left-20 w-60 h-60 bg-[#EDE7D6]/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-[#1E3D19]/20 rounded-full blur-3xl"></div>
      <div class="absolute inset-0 rounded-[3rem] bg-gradient-to-br from-white/10 via-transparent to-white/5 pointer-events-none"></div>

      <div class="relative z-10 grid lg:grid-cols-[0.95fr_1.05fr] gap-8 items-center">
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white/10 backdrop-blur-xl border border-white/10 shadow-lg mb-5">
            <div class="w-2 h-2 rounded-full bg-[#EDE7D6] animate-pulse"></div>
            <span class="text-xs font-bold tracking-[0.18em] text-white/80 uppercase">Join Plant Bud</span>
          </div>

          <div class="mb-6 flex justify-center lg:justify-start">
            <a href="/" class="relative group inline-flex items-center justify-center">
              <div class="absolute inset-0 bg-[#EDE7D6]/10 rounded-full blur-2xl scale-125 group-hover:scale-150 transition duration-500"></div>

              <div class="relative w-24 h-24 rounded-full bg-white/10 backdrop-blur-xl border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.3)] flex items-center justify-center group-hover:-translate-y-1 group-hover:scale-105 transition duration-500">
                <img src="resources/images/essential/logo.png" class="w-16 drop-shadow-[0_10px_25px_rgba(0,0,0,0.3)]" alt="">
              </div>
            </a>
          </div>

          <h1 class="text-3xl md:text-4xl xl:text-5xl font-black text-white leading-tight drop-shadow-xl">
            Welcome to <span class="text-[#EDE7D6]">Plant Bud</span>
          </h1>

          <div class="w-20 h-1 bg-[#EDE7D6] rounded-full mt-5 mx-auto lg:mx-0"></div>

          <p class="mt-5 text-white/85 text-sm md:text-base font-semibold leading-relaxed max-w-lg mx-auto lg:mx-0">
            Choose how you want to register and start your journey with a greener and healthier lifestyle.
          </p>

          <p class="mt-5 text-white/70 text-sm font-semibold">
            Already have an account?
            <a href="/login" class="text-[#EDE7D6] font-black hover:text-white transition">
              Log in here
            </a>
          </p>
        </div>

        <div class="grid gap-4">
          <a href="/signup/client" class="group relative overflow-hidden rounded-[2rem] bg-[#EDE7D6] text-[#1E3D19] px-6 py-5 shadow-[0_20px_60px_rgba(0,0,0,0.18)] hover:-translate-y-1 hover:scale-[1.01] hover:shadow-[0_25px_80px_rgba(0,0,0,0.22)] transition-all duration-500">
            <div class="absolute -top-8 -right-8 w-24 h-24 bg-white/40 rounded-full blur-2xl"></div>

            <div class="relative flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-white shadow-lg flex items-center justify-center shrink-0 group-hover:rotate-6 group-hover:scale-110 transition duration-500">
                <img src="resources/images/register/clients.png" class="w-8" alt="">
              </div>

              <div class="flex-1">
                <h2 class="text-xl font-black leading-tight">Register as Client</h2>

                <p class="mt-1 text-[#2F3E2D]/75 text-sm font-bold leading-relaxed">
                  Find gardeners and manage your plant care needs.
                </p>

                <div class="mt-3 inline-flex items-center gap-2 text-xs font-black tracking-wide uppercase">
                  Get Started

                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M5 12h14"></path>
                    <path d="M13 5l7 7-7 7"></path>
                  </svg>
                </div>
              </div>
            </div>
          </a>

          <a href="/signup/gardener" class="group relative overflow-hidden rounded-[2rem] bg-[#EDE7D6] text-[#1E3D19] px-6 py-5 shadow-[0_20px_60px_rgba(0,0,0,0.18)] hover:-translate-y-1 hover:scale-[1.01] hover:shadow-[0_25px_80px_rgba(0,0,0,0.22)] transition-all duration-500">
            <div class="absolute -bottom-8 -left-8 w-24 h-24 bg-[#1E3D19]/10 rounded-full blur-2xl"></div>

            <div class="relative flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-white shadow-lg flex items-center justify-center shrink-0 group-hover:-rotate-6 group-hover:scale-110 transition duration-500">
                <img src="resources/images/register/gardeners.png" class="w-8" alt="">
              </div>

              <div class="flex-1">
                <h2 class="text-xl font-black leading-tight">Register as Gardener</h2>

                <p class="mt-1 text-[#2F3E2D]/75 text-sm font-bold leading-relaxed">
                  Offer your gardening services and grow your profile.
                </p>

                <div class="mt-3 inline-flex items-center gap-2 text-xs font-black tracking-wide uppercase">
                  Start Growing

                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M5 12h14"></path>
                    <path d="M13 5l7 7-7 7"></path>
                  </svg>
                </div>
              </div>
            </div>
          </a>

          <a href="/signup/nursery" class="group relative overflow-hidden rounded-[2rem] bg-[#EDE7D6] text-[#1E3D19] px-6 py-5 shadow-[0_20px_60px_rgba(0,0,0,0.18)] hover:-translate-y-1 hover:scale-[1.01] hover:shadow-[0_25px_80px_rgba(0,0,0,0.22)] transition-all duration-500">
            <div class="absolute -top-8 -left-8 w-24 h-24 bg-[#1E3D19]/10 rounded-full blur-2xl"></div>

            <div class="relative flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-white shadow-lg flex items-center justify-center shrink-0 group-hover:rotate-6 group-hover:scale-110 transition duration-500">
                <img src="resources/images/register/nursery.png" class="w-8" alt="">
              </div>

              <div class="flex-1">
                <h2 class="text-xl font-black leading-tight">Register as Nursery</h2>

                <p class="mt-1 text-[#2F3E2D]/75 text-sm font-bold leading-relaxed">
                  Showcase your plants and nursery services to customers.
                </p>

                <div class="mt-3 inline-flex items-center gap-2 text-xs font-black tracking-wide uppercase">
                  Open Store

                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M5 12h14"></path>
                    <path d="M13 5l7 7-7 7"></path>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
@end
