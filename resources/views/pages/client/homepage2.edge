        <div class="flex items-center gap-4">

            <div class="w-14 h-14 rounded-2xl bg-[#113E14]
                    flex items-center justify-center shadow-lg">

                <img src="resources/images/essential/logo.png" alt="">

            </div>

            <div>
                <h1 class="text-2xl font-bold">
                    <span class="text-[#48AE4D]">PLANT-BUD</span>
                </h1>

                <p class="text-sm text-[#636863]">
                    Be the plant's best bud
                </p>
            </div>
        </div>

        
        <nav class="hidden lg:flex items-center gap-10 text-[15px] font-medium">
            <a href="#" class="hover:text-[#48AE4D] transition">Inicio</a>
            <a href="#" class="hover:text-[#48AE4D] transition">Categorías</a>
            <a href="#" class="hover:text-[#48AE4D] transition">Escaneo</a>
            <a href="#" class="hover:text-[#48AE4D] transition">Diseño Jardín</a>
            <a href="#" class="hover:text-[#48AE4D] transition">Comunidad</a>
        </nav>

       
        <div class="flex items-center gap-5">

            
            <div class="hidden md:flex bg-[#D3DCD3]/70 rounded-2xl px-4 py-2 items-center gap-2">
                <svg class="w-5 h-5 text-[#636863]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-4.35-4.35M10 18a8 8 0 100-16 8 8 0 000 16z" />
                </svg>

                <input type="text" placeholder="Buscar plantas..."
                    class="bg-transparent outline-none text-sm placeholder:text-[#636863]">

            </div>

            <img src="resources/images/homepagee/escaneo-3.jpg"
                class="w-12 h-12 rounded-2xl border-2 border-white shadow-lg object-cover">
        </div>
    </div>


    
    <section class="relative z-10 px-8 pt-16">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
                <h1 class="text-6xl text-white leading-[1.1] font-abril mb-8">
                    Discover,
                    tend and design
                    your ideal garden.
                </h1>

                <p class="text-gray text-lg leading-relaxed max-w-xl mb-10 font-poppins">
                    Explore ornamental, succulent and vegetable plants.
                    Design stunning gardens, connect with fellow gardeners
                    and use artificial intelligence to scan plants.
                </p>

                
                <div class="flex flex-wrap gap-5">
                    <button class="bg-[#113E14] text-white px-8 py-4
                         rounded-2xl shadow-xl hover:scale-105
                         transition">
                         scan plant
                    </button>

                    <button class="bg-white/60 backdrop-blur-xl border border-white/40
                         px-8 py-4 rounded-2xl shadow-lg hover:bg-white transition">
                         Explore categories
                    </button>
                </div>

                
                <div class="flex flex-wrap gap-10 mt-14">

                    <div>
                        <h3 class="text-4xl font-bold">3222</h3>
                        <p class="text-[#636863]">Especies</p>
                    </div>

                    <div>
                        <h3 class="text-4xl font-bold">222</h3>
                        <p class="text-[#636863]">Gardeners</p>
                    </div>

                    <div>
                        <h3 class="text-4xl font-bold">4000</h3>
                        <p class="text-[#636863]">Nurseries</p>
                    </div>
                </div>
            </div>

            
            <div class="relative">
                <img src="resources/images/homepagee/escaneo-333.jpg"
                    class="w-full h-[650px] object-cover rounded-[40px] shadow-2xl">

                
                <div class="absolute -bottom-10 left-10 bg-white/70
                    backdrop-blur-2xl border border-white/40
                    rounded-[30px] p-6 shadow-2xl w-[320px]">

                    <div class="flex items-center gap-4">

                        <div class="w-16 h-16 rounded-2xl bg-[#48AE4D]/20
                        flex items-center justify-center text-3xl">
                        </div>


                        <div>

                            <h3 class="font-semibold text-lg">
                                Smart scanning
                            </h3>

                            <p class="text-sm text-[#636863]">

                                automatically identifies the plant species
                            </p>

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>


    <section class="relative z-10 px-8 py-28">

        <div class="flex items-center justify-between mb-12">
            <div>
                <h2 class="text-5xl font-abril text-white mb-3">
                    Categories
                </h2>

                <p class="text-[#636863] font-poppins">
                    Discover different types of plants
                </p>
            </div>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">

            <div class="group relative overflow-hidden rounded-[35px] shadow-2xl h-[500px]">
                <img src="resources/images/homepagee/plant-1.png"
                    class="w-full h-full object-cover group-hover:scale-110 transition duration-700">

                <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
                <div class="absolute bottom-8 left-8 text-white">

                    <h3 class="text-4xl font-abril mb-3">
                        Ornamentals
                    </h3>

                    <p class="text-white/80 mb-5 font-poppins">
                        Flowers and decorative plants
                    </p>

                    <button class="bg-white text-[#113E14]
                         px-6 py-3 rounded-2xl font-medium">

                        Explore
                    </button>
                </div>
            </div>


            <div class="group relative overflow-hidden rounded-[35px] shadow-2xl h-[500px]">

                <img src="resources/images/homepagee/succulents.png"
                    class="w-full h-full object-cover group-hover:scale-110 transition duration-700">

                <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>

                <div class="absolute bottom-8 left-8 text-white">

                    <h3 class="text-4xl font-abril mb-3">
                        Succulents
                    </h3>

                    <p class="text-white/80 mb-5 font-poppins">
                        Minimalist and durable
                    </p>

                    <button class="bg-white text-[#113E14]
                         px-6 py-3 rounded-2xl font-medium">

                        Explore
                    </button>
                </div>
            </div>


            <div class="group relative overflow-hidden rounded-[35px] shadow-2xl h-[500px]">
                <img src="resources/images/homepagee/horticultural.png"
                    class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
                <div class="absolute bottom-8 left-8 text-white">
                    <h3 class="text-4xl font-abril mb-3">
                        Horticultural
                    </h3>

                    <p class="text-white/80 mb-5 font-poppins">
                        Vegetable gardens and natural crops
                    </p>

                    <button class="bg-white text-[#113E14]
                         px-6 py-3 rounded-2xl font-medium">

                        Explore
                    </button>
                </div>
            </div>
        </div>
    </section>


    <section class="relative z-10 px-8 pb-28">
        <div class="bg-[#113E14] rounded-[40px] overflow-hidden shadow-2xl">
            <div class="grid lg:grid-cols-2 items-center">

                <div class="p-14 text-white">
                    <div class="inline-flex bg-white/10 px-5 py-2 rounded-full mb-8 font-poppins">
                        Artificial Intelligence
                    </div>
                    <h2 class="text-5xl font-abril leading-tight mb-8">
                        Scan any plant
                        and find out everything about it.
                    </h2>

                    <p class="text-[#D3DCD3] text-lg leading-relaxed mb-10">
                        Identifies species, diseases, water requirements,
                        fertilisation and care recommendations.
                    </p>

                    <button class="bg-[#48AE4D] px-8 py-4 rounded-2xl
