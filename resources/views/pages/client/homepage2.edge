                    </p>

                    <div class="flex items-center gap-6 text-sm text-[#636863]">

                        <span>❤️ 210</span>
                        <span>💬 32</span>

                    </div>

                </div>

            </div>

            <!-- Post -->
            <div class="bg-white/60 backdrop-blur-2xl border border-white/40
