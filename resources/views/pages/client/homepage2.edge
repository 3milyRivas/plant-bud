                <div class="text-5xl mb-6">
                    <img src="resources/img/phot.jpg" alt="plant-icon" class="h-18 w-18">
                </div>

                <h3 class="text-2xl font-semibold mb-4">
                    Gardeners
                </h3>

                <p class="text-[#636863] leading-relaxed mb-8">
                    Contact gardening specialists
                    and get personalised advice.
                </p>

                <button class="text-[#48AE4D] font-semibold">
                    Find gardeners →
                </button>

            </div>


            <div class="bg-white/60 backdrop-blur-2xl border border-white/40
                  rounded-[32px] p-8 shadow-xl hover:-translate-y-2 transition">

                <div class="text-5xl mb-6">
                    <img src="resources/img/img4.png" alt="nuersery" class="h-18 w-18">
                </div>

                <h3 class="text-2xl font-semibold mb-4">
                    Nurseries
                </h3>

                <p class="text-[#636863] leading-relaxed mb-8">
