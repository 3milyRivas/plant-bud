                        Scan now
                    </button>

                </div>


                <img src="resources/images/homepagee/plant-6.png" class="w-full h-full object-cover">
            </div>
        </div>
    </section>


    <section class="relative z-10 px-8 pb-28">
        <div class="grid lg:grid-cols-3 gap-8">
            <div class="bg-white/60 backdrop-blur-2xl border border-white/40
                  rounded-[32px] p-8 shadow-xl hover:-translate-y-2 transition">

                <div class="text-5xl mb-6">
                    <img src="resources/images/homepagee/maintenance.png" alt="maintenance" class="w-18 h-18">
                </div>

                <h3 class="text-2xl font-semibold mb-4">
                    Garden Design
                </h3>

                <p class="text-[#636863] leading-relaxed mb-8">
                    Be inspired by modern,
