@layout()
@slot('title')
<title>homepage</title>
@endslot


<div class="fixed top-0 left-0 w-[500px] h-[500px] bg-[#48AE4D]/20 rounded-full blur-3xl"></div>
<div class="fixed bottom-0 right-0 w-[500px] h-[500px] bg-[#6B8C6C]/20 rounded-full blur-3xl"></div>


<header class="relative z-50 px-8 pt-8">

    <div class="bg-white/50 backdrop-blur-2xl border border-white/40
