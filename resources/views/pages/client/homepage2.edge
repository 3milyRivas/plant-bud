                <img src="resources/images/homepagee/escaneo-4.jpg" class="w-full h-72 object-cover">

                <div class="p-6">

                    <div class="flex items-center gap-3 mb-4">

                        <img src="resources/img/phot.jpg" class="w-12 h-12 rounded-full">

                        <div>
                            <h4 class="font-semibold">Laura Gómez</h4>
                            <p class="text-sm text-[#636863]">
