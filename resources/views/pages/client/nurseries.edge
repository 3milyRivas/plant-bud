<!DOCTYPE html>
<html lang="en-us">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    Plant bud
  </title>
  @vite(['resources/css/app.css', 'resources/js/app.js'])
  @stack('dumper')
</head>

<body class="min-h-screen bg-[#7f9a7a] font-sans">

  <div class="relative h-[300px] bg-[url('/images/plants-bg.jpg')] bg-cover bg-center px-10 py-6">
    <div class="flex items-center justify-between">


      <div class="flex items-center gap-4">
        <div
          class="flex h-14 w-14 flex-col items-center justify-center rounded-full bg-green-900 text-xs font-bold text-white">
          <span>Plant</span>
          <span>BUD</span>
        </div>

        <div class="rounded-full bg-white/70 px-6 py-2 text-sm font-semibold">
          Back
        </div>
      </div>


      <div class="flex w-72 items-center rounded-full bg-white/80 px-4 py-2">
        <input type="text" placeholder="Search" class="w-full bg-transparent text-sm outline-none" />
      </div>

      <!-- USER -->
      <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/70">
        👤
      </div>

    </div>
  </div>


  <div class="-mt-24 px-10">
    <div class="flex items-center justify-between gap-10 rounded-2xl bg-[#d7d4d3] p-10">

      <div class="pl-12 max-w-lg">
        <div class="text-4xl font-bold leading-tight text-black">
          Pick up the plants you’ve been dreaming of!
        </div>

        <div class="mt-4 text-lg text-gray-700">
          Look all the plants stores we offer
        </div>

        <div class="mt-6 inline-block rounded-full bg-green-900 px-10 py-2 text-sm font-semibold text-white">
          Contact
        </div>
      </div>
      <div>
        <img src="resources/images/plants/nurse1.png">
      </div>


    </div>
  </div>

  <div class="mt-20 pb-10">
    <div class="mx-auto max-w-md text-center text-2xl text-white font-bold">
      A jubilation brought by the purchase of another new form of life
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-10 space-y-12">
    <!-- 1 -->
    <div class="flex items-center justify-between rounded-2xl bg-[#dbe3db] p-8">
      <div class="max-w-xl text-green-900 space-y-2">
        <div class="text-2xl font-semibold">
          El Bambú Nursery
        </div>
        <div class="text-yellow-500 text-2xl">
          ★★★★★
        </div>
        <div class="text-lg opacity-80">
          A family-owned nursery focused on fruit trees and large palms.
        </div>
        <div class="text-base opacity-70">
          Schedule: 6:00 AM – 4:00 PM
        </div>
        <div class="flex items-center gap-6 text-base pt-2">
          <div>@BambuNursery</div>
          <div>📞 503 7777‑3366</div>
          <div>ⓕ ElBambuVivero</div>
        </div>
      </div>
      <div class="h-40 w-56 rounded-xl bg-[url('/assets/resources/images/nursery-1.jpg')] bg-cover bg-center"></div>
    </div>

    <!-- 2 -->
    <div class="flex items-center justify-between rounded-2xl bg-[#dbe3db] p-8">
      <div class="max-w-xl text-green-900 space-y-2">
        <div class="text-2xl font-semibold">
          The Tecla Plant House
        </div>
        <div class="text-yellow-500 text-2xl">
          ★★★★★
        </div>
        <div class="text-lg opacity-80">
          Your go-to spot for indoor plants and unique pots.
        </div>
        <div class="text-base opacity-70">
          Schedule: 8:00 AM – 3:00 PM
        </div>
        <div class="flex items-center gap-6 text-base pt-2">
          <div>@TeclaPlantHouse</div>
          <div>📞 503 7777‑9012</div>
          <div>ⓕ TheTeclaPlantHouse</div>
        </div>
      </div>
      <div class="h-40 w-56 rounded-xl bg-[url('/assets/resources/images/nursery-2.jpg')] bg-cover bg-center"></div>
    </div>

    <!-- 3 -->
    <div class="flex items-center justify-between rounded-2xl bg-[#dbe3db] p-8">
      <div class="max-w-xl text-green-900 space-y-2">
        <div class="text-2xl font-semibold">
          Vivero La Esmeralda
        </div>
        <div class="text-yellow-500 text-2xl">
          ★★★★★
        </div>
        <div class="text-lg opacity-80">
          Urban oasis of indoor plants and vertical gardens.
        </div>
        <div class="text-base opacity-70">
          Schedule: 8:00 AM – 3:00 PM
        </div>
        <div class="flex items-center gap-6 text-base pt-2">
          <div>@ViveroEsmeralda</div>
          <div>📞 503 7011‑7244</div>
          <div>ⓕ Vivero La Esmeralda</div>
        </div>
      </div>
      <div class="h-40 w-56 rounded-xl bg-[url('/assets/resources/images/nursery-3.jpg')] bg-cover bg-center"></div>
    </div>
    <!-- 4 -->
    <div class="flex items-center justify-between rounded-2xl bg-[#dbe3db] p-8">
      <div class="max-w-xl text-green-900 space-y-2">
        <div class="text-2xl font-semibold">
          Green Heaven Nurseries
        </div>
        <div class="text-yellow-500 text-2xl">
          ★★★★★
        </div>
        <div class="text-lg opacity-80">
          A tranquil space dedicated to tropical and native plants.
        </div>
        <div class="text-base opacity-70">
          Schedule: 7:30 AM – 1:00 PM
        </div>
        <div class="flex items-center gap-6 text-base pt-2">
          <div>@GreenHeavenSV</div>
          <div>📞 503 7777‑1234</div>
          <div>ⓕ GreenHavenNurserySV</div>
        </div>
      </div>
      <div class="h-40 w-56 rounded-xl bg-[url('/assets/resources/images/nursery-4.jpg')] bg-cover bg-center"></div>
    </div>

  </div>

  <div class="flex justify-center text-white pt-12 ">The brands, store names, and businesses shown in this design are
    fictitious and used for illustrative purposes only. They do not represent real stores and are not affiliated with
    any existing companies.</div>


</body>


</html>
