@layout()
@slot('title')
<title>Nurseries</title>
@endslot
<div class="w-full bg-[#6B8C6C] overflow-hidden min-h-screen">
  <header class="fixed top-0 left-0 w-full z-50 px-6 lg:px-10 pt-6">
    <div class="max-w-7xl mx-auto">
      <div
        class="backdrop-blur-xl bg-white/15 border border-white/20 rounded-full px-5 lg:px-8 py-3 flex items-center justify-between shadow-[0_10px_35px_rgba(0,0,0,0.18)]">

        <img src="resources/images/essential/logo.png" class="w-12 h-12">

        <div class="hidden md:flex items-center gap-4">
          <div class="bg-white/80 rounded-full px-5 py-2.5 w-[280px] lg:w-[340px] shadow-inner">

            <input type="text" placeholder="Search plants..."
              class="bg-transparent outline-none w-full text-[#113E14] placeholder:text-[#6B8C6C]/70 text-sm">
          </div>

          <button
            class="w-11 h-11 rounded-full bg-[#113E14] flex items-center justify-center hover:bg-[#1B5420] hover:scale-105 transition duration-300 shadow-lg">

            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">

              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-4.35-4.35m1.85-5.65a7.5 7.5 0 11-15 0 7.5 7.5 0 0115 0z" />
            </svg>
          </button>
        </div>

        <img src="resources/images/welcome/logo-perfil.png" class="w-12 h-12 rounded-full border-2 border-white/40">
      </div>
    </div>
  </header>

  <div class="relative w-full h-[620px] bg-cover bg-center bg-[url('nurseries/viv0.jpg')]">

    <div class="absolute inset-0 bg-black/20"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#1E3D19]/30 to-[#6B8C6C]"></div>

    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-6 pt-24">
      <h1 class="text-white text-5xl md:text-7xl font-bold max-w-4xl">
        Discover the best plant nurseries
      </h1>

      <p class="text-white/80 mt-6 max-w-xl">
        Explore beautiful places full of life and nature near you.
      </p>
    </div>
  </div>

  <div class="px-6 mt-6">
    <button
      class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-xl border border-white/20 rounded-full px-6 py-2 text-white hover:bg-white/20 transition">
      ← Back
    </button>
  </div>

  <div class="flex flex justify-center pt-20 pb-10 text-white">
    <div class="text-white text-2xl font-bold">Pick up the plants you’ve been dreaming of
    </div>
  </div>
  <div class="flex items-center justify-center pt-3">
    <div class="h-[4px] w-20 bg-gradient-to-r from-transparent to-white/40"></div>

    <div
      class="mx-6 px-6 py-2 rounded-full bg-white/10 backdrop-blur-xl border border-white/20 text-white tracking-[0.2em] uppercase text-sm font-semibold">
      Look to our nurseries
    </div>

    <div class="h-[4px] w-20 bg-gradient-to-l from-transparent to-white/40"></div>
  </div>
  <!-- La lista coronel :vs -->
  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10">
      @each(nursery in nurseries.sponsoredNurseries)
        @!component('components/nursery-card', { nursery })
      @endeach
    </div>
  </section>

  <div class="flex items-center justify-center pt-3">
    <div class="h-[4px] w-20 bg-gradient-to-r from-transparent to-white/40"></div>
    <div
      class="mx-6 px-6 py-2 rounded-full bg-white/10 backdrop-blur-xl border border-white/20 text-white tracking-[0.2em] uppercase text-sm font-semibold">
      Big Sales %
    </div>
    <div class="h-[4px] w-20 bg-gradient-to-l from-transparent to-white/40"></div>
  </div>

  <!--lista de ofertas-->
  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="pt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div
        class="group relative overflow-hidden rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.20)] hover:-translate-y-2 transition-all duration-500">
        <div class="absolute -inset-2 bg-[#48AE4D]/20 blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
        <img src="nurseries/sale1.jpg"
          class="w-full h-[420px] object-cover group-hover:scale-110 transition duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-6">
          <div class="text-white text-2xl font-bold">Izote 50%</div>
          <div class="text-white/80 text-sm font-bold">Terra Flora Garden</div>
        </div>
      </div>

      <div
        class="group relative overflow-hidden rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.20)] hover:-translate-y-2 transition-all duration-500">
        <div class="absolute -inset-2 bg-[#48AE4D]/20 blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
        <img src="resources/images/nurseries/sale2.jpg"
          class="w-full h-[420px] object-cover group-hover:scale-110 transition duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-6">
          <div class="text-white text-2xl font-bold">Crown of thorns 60%</div>
          <div class="text-white/80 text-sm font-bold">Verde viva botánica</div>
        </div>
      </div>

      <div
        class="group relative overflow-hidden rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.20)] hover:-translate-y-2 transition-all duration-500">
        <div class="absolute -inset-2 bg-[#48AE4D]/20 blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
        <img src="resources/images/nurseries/sale3.jpg"
          class="w-full h-[420px] object-cover group-hover:scale-110 transition duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-6">
          <div class="text-white text-2xl font-bold">Hot Chili peper 30%</div>
          <div class="text-white/80 text-sm font-bold">El Bambú Nursery</div>
        </div>
      </div>

      <div
        class="group relative overflow-hidden rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.20)] hover:-translate-y-2 transition-all duration-500">
        <div class="absolute -inset-2 bg-[#48AE4D]/20 blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
        <img src="resources/images/nurseries/sale4.jpg"
          class="w-full h-[420px] object-cover group-hover:scale-110 transition duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-6">
          <div class="text-white text-2xl font-bold">Dumb cane camille 60%</div>
          <div class="text-white/80 text-sm">Green Heaven Nursery</div>
        </div>
      </div>



    </div>
    <!-- Linea divisora :v-->
    <div class="flex justify-center pt-16">
      <div class="w-[300px] h-[4px] bg-gradient-to-r from-transparent via-white/40 to-transparent">
      </div>
    </div>

    <!--lista de viveros 2-->
    <section class="py-20 px-6">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10">
        @each(nursery in nurseries.nurseries)
          @!component('components/nursery-card', { nursery })
        @endeach
      </div>
    </section>
    @end
