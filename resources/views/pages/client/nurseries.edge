@layout()
@slot('title')
<title>Plant Bud - Nurseries</title>
@endslot

@!component('components/header', {
  title: 'Discover the best plant nurseries',
  text: 'Explore beautiful places full of life and nature near you.',
  imageBg: 'bg-[url(/resources/images/homepagee/nursery-header.jpg)]'
})

<div class="flex justify-center pt-20 pb-10 text-white">
  <div class="text-2xl font-bold text-white">Pick up the plants you've been dreaming of</div>
</div>

<section class="px-6 py-20">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 md:grid-cols-2">
    @each(nursery in nurseries.sponsoredNurseries)
      @!component('components/nursery-card', { nursery })
    @endeach
  </div>
</section>

<div class="flex items-center justify-center pt-3">
  <div class="h-[4px] w-20 bg-gradient-to-r from-transparent to-white/40"></div>
  <div class="mx-6 rounded-full border border-white/20 bg-white/10 px-6 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-white backdrop-blur-xl">
    Big Sales %
  </div>
  <div class="h-[4px] w-20 bg-gradient-to-l from-transparent to-white/40"></div>
</div>

<div class="grid grid-cols-1 gap-8 pt-6 sm:grid-cols-2 lg:grid-cols-4">
  @!component('components/img-card', {
    title: 'Izote 50%',
    text: 'Jardín Botánico La Laguna',
    imageBg: '/nurseries/sale1.jpg'
  })
  @!component('components/img-card', {
    title: 'Crown of thorns 60%',
    text: 'Terra Flora Garden',
    imageBg: '/nurseries/sale2.jpg'
  })
  @!component('components/img-card', {
    title: 'Hot chili pepper 30%',
    text: 'Green Heaven Nursery',
    imageBg: '/nurseries/sale3.jpg'
  })
  @!component('components/img-card', {
    title: 'Dumb cane camille 20%',
    text: 'Jardín Botánico La Laguna',
    imageBg: '/nurseries/sale4.jpg'
  })
</div>

<div class="flex justify-center pt-16">
  <div class="h-[4px] w-[300px] bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
</div>

<section class="px-6 py-20">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 md:grid-cols-3">
    @each(nursery in nurseries.nurseries)
      @!component('components/nursery-card', { nursery })
    @endeach
  </div>
</section>
@end
