@layout()
@slot('title')
<title>Nurseries</title>
@endslot

@!component('components/header', {
title: "Discover the best plant nurseries",
text: "Explore beautiful places full of life and nature near you.",
imageBg:'bg-[url(/nurseries/viv0.jpg)]'
})

<div class="flex flex justify-center pt-20 pb-10 text-white">
  <div class="text-white text-2xl font-bold">Pick up the plants you’ve been dreaming of
  </div>
</div>
<div class="flex items-center justify-center pt-3">
  <div class="h-[4px] w-20 bg-gradient-to-r from-transparent to-white/40"></div>

  <div
    class="mx-6 px-6 py-2 rounded-full bg-white/10 backdrop-blur-xl border border-white/20 text-white tracking-[0.2em] uppercase text-sm font-semibold">
    Look to our nurseries
  </div>

  <div class="h-[4px] w-20 bg-gradient-to-l from-transparent to-white/40"></div>
</div>

<section class="py-20 px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10">
    @each(nursery in nurseries.sponsoredNurseries)
    @!component('components/nursery-card', { nursery })
    @endeach
  </div>
</section>

@!component('components/img-card', {
  title1: "Big Sales %",
  text1: "Izote 50%",
  text2: "Terra Flora Garden",
  text3: "Crown of thorns 60%",
  text4: "Verde viva botánica",
  text5: "Hot Chili peper 30%",
  text6: "El Bambú Nursery",
  text7: "Dumb cane camille 60%",
  text8: "Green Heaven Nursery"
})

  <!--lista de viveros 2-->
  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10">
      @each(nursery in nurseries.nurseries)
      @!component('components/nursery-card', { nursery })
      @endeach
    </div>
  </section>
  @end
