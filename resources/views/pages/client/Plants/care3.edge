<section class="relative py-20 px-6 overflow-hidden">

    <div class="relative z-10 max-w-6xl mx-auto">

        <div class="care-focus-panel homepage-lively-card overflow-hidden rounded-[42px] border shadow-xl backdrop-blur-2xl">

            <div class="grid grid-cols-1 lg:grid-cols-5">

                <div class="lg:col-span-3 p-8 lg:p-12 flex flex-col justify-center">
                    <div class="inline-flex items-center gap-3 w-fit px-4 py-2 rounded-full bg-[#ebe3a7] border border-[#416543]/10
                    text-[#113e14] text-[13px] tracking-[2px] font-semibold mb-6">

                        <div class="w-2.5 h-2.5 rounded-full bg-[#a8b841]"></div>
                        SUCCULENT CARE
                    </div>


                    <h2 class="text-4xl lg:text-5xl font-abril text-[#113e14] leading-tight mb-6">
                        Proper Lighting
                    </h2>


                    <div class="text-[#113e14]/78 font-poppins text-[15px] leading-[1.9rem] max-w-xl">

                        Succulents thrive in bright spaces with plenty
                        of indirect sunlight. Placing them near sunny
                        windows helps maintain compact and healthy growth.

                        <br><br>

                        If natural light is limited, fluorescent or LED
                        grow lights can support development when positioned
                        6-12 inches above the plants for several hours daily.
                    </div>


                    <div class="flex flex-wrap gap-4 mt-8">


                        <div
                            class="flex items-center gap-4 bg-[#416543]/8 border border-[#416543]/12 rounded-2xl px-4 py-3 hover:bg-[#ebe3a7]/70 transition-all duration-300">
                            <div class="w-11 h-11 rounded-xl bg-[#a8b841]/20 flex items-center justify-center">
                                <img loading="lazy" decoding="async" src="/resources/images/care/11.png" alt="sun icon"
                                    class="w-6 h-6 object-contain">
                            </div>

                            <div>
                                <div class="text-[#113e14] text-sm font-black">
                                    Natural Light
                                </div>

                                <div class="text-[#416543] text-[12px] font-semibold">
                                    Healthy daily growth
                                </div>
                            </div>
                        </div>


                        <div
                            class="flex items-center gap-4 bg-[#416543]/8 border border-[#416543]/12 rounded-2xl px-4 py-3 hover:bg-[#ebe3a7]/70 transition-all duration-300">

                            <div class="w-11 h-11 rounded-xl bg-[#a8b841]/20 flex items-center justify-center">

                                <img loading="lazy" decoding="async" src="/resources/images/care/ll.png"
                                    alt="light icon" class="w-6 h-6 object-contain">
                            </div>

                            <div>
                                <div class="text-[#113e14] text-sm font-black">
                                    Artificial Light
                                </div>

                                <div class="text-[#416543] text-[12px] font-semibold">
                                    Perfect indoors
                                </div>
                            </div>
                        </div>

                    </div>
                </div>


                <div class="lg:col-span-2 relative min-h-[380px]">

                    <img loading="lazy" decoding="async" src="/resources/images/care/succ2.jpg" alt="Plant lighting"
                        class="absolute inset-0 w-full h-full object-cover">


                    <div class="absolute inset-0 bg-[#113e14]/32"></div>
                    <div
                        class="absolute bottom-6 left-6 bg-[#a8b841]/90 backdrop-blur-md border border-[#ebe3a7]/55 rounded-2xl px-5 py-4 shadow-xl">
                        <div class="flex items-center gap-3">
                            <div class="w-11 h-11 rounded-xl bg-[#ebe3a7]/65 flex items-center justify-center">
                                <img loading="lazy" decoding="async" src="/resources/images/care/leaf.png"
                                    alt="leaf icon" class="w-6 h-6">
                            </div>

                            <div>
                                <p class="text-[#113e14] text-sm font-black">
                                    14-16 Hours
                                </p>

                                <p class="text-[#416543] text-xs font-semibold">
                                    Recommended light exposure
                                </p>
