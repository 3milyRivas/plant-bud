@layout()
@slot('title')
<title>Care3</title>
@endslot

<div class="w-full bg-[#6B8C6C] overflow-hidden">

  <header class="fixed top-0 left-0 w-full z-50 px-6 lg:px-10 pt-6">
    <div class="max-w-7xl mx-auto">
      <div
        class="backdrop-blur-xl bg-white/15 border border-white/20 rounded-full px-5 lg:px-8 py-3 flex items-center justify-between shadow-[0_10px_35px_rgba(0,0,0,0.18)]">

        <img decoding="async" src="resources/images/essential/logo.png" alt="logo"
          class="w-12 h-12 hover:scale-105 transition duration-300 cursor-pointer">

        <div class="hidden md:flex items-center gap-4">
          <div class="bg-white/80 rounded-full px-5 py-2.5 w-[280px] lg:w-[340px] shadow-inner">

            <input type="text" placeholder="Search plants..."
              class="bg-transparent outline-none w-full text-[#113E14] placeholder:text-[#6B8C6C]/70 text-sm">
          </div>

          <button
            class="w-11 h-11 rounded-full bg-[#113E14] flex items-center justify-center hover:bg-[#1B5420] hover:scale-105 transition duration-300 shadow-lg">

            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">

              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-4.35-4.35m1.85-5.65a7.5 7.5 0 11-15 0 7.5 7.5 0 0115 0z" />
            </svg>
          </button>
        </div>


        <div class="relative group cursor-pointer">

          <img decoding="async" src="resources/images/plants/logo-perfil.png" alt="profile"
            class="w-12 h-12 rounded-full border-2 border-white/40 hover:scale-105 transition duration-300">

          <div
            class="absolute inset-0 rounded-full bg-[#48AE4D]/20 blur-md opacity-0 group-hover:opacity-100 transition duration-300">
          </div>
        </div>
      </div>
    </div>
  </header>






  <div class="relative w-full h-[620px] bg-cover bg-center bg-[url('/resources/images/care/bg_hor.jpg')]">


    <div class="absolute inset-0 bg-black/45"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#1E3D19]/20 via-[#728B6F]/20 to-[#6B8C6C]">
    </div>

    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-6 pt-24">
      <h1 class="text-white text-5xl md:text-7xl font-bold leading-tight max-w-5xl">
        Taking care of plants
        is taking care of yourself
      </h1>

      <p class="text-white/80 mt-6 max-w-2xl text-lg leading-8">
        Sustainable outdoor solutions designed
        to inspire peaceful spaces and healthier living.
      </p>


      <div class="flex flex-wrap justify-center gap-5 mt-10">
        <button
          class="px-8 py-4 rounded-full bg-[#113E14] text-white font-medium hover:scale-105 hover:bg-[#1B5420] transition duration-300 shadow-[0_10px_30px_rgba(17,62,20,0.4)]">
          Explore Plants
        </button>

        <button
          class="px-8 py-4 rounded-full border border-white/30 bg-white/10 backdrop-blur-md text-white font-medium hover:bg-white/20 transition duration-300">
          Learn More
        </button>
      </div>
    </div>
  </div>



  <div class="relative z-20 px-6 bg-[#6B8C6C]">
    <div class="max-w-7xl mx-auto">

      <button
        class="inline-flex items-center gap-3 bg-white/15 backdrop-blur-xl border border-white/20 rounded-full px-7 py-3 text-white font-medium hover:bg-white/20 hover:scale-105 transition duration-300">

        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </button>
    </div>
  </div>






  <section class="relative py-24 px-6 overflow-hidden bg-[#6B8C6C]">
    <div class="absolute top-[-120px] left-[-120px] w-[420px] h-[420px] bg-[#48AE4D]/30 blur-[120px] rounded-full">
    </div>

    <div class="absolute bottom-[-150px] right-[-100px] w-[420px] h-[420px] bg-[#D3DCD3]/30 blur-[120px] rounded-full">
    </div>
    <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">


      <div class="relative group">
        <div
          class="absolute -inset-5 bg-[#48AE4D]/30 blur-3xl rounded-[3rem] opacity-70 group-hover:opacity-100 transition duration-500">
        </div>

        <div
          class="relative overflow-hidden rounded-[2.8rem] border border-white/20 shadow-[0_25px_80px_rgba(0,0,0,0.25)]">
          <img decoding="async" src="/resources/images/care/radish.jpg" alt="Succulent plants"
            class="w-full h-[580px] object-cover group-hover:scale-105 transition duration-700">
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
        </div>
      </div>


      <div
        class="relative bg-white/10 border border-white/20 rounded-[3rem] p-10 lg:p-14 shadow-[0_20px_70px_rgba(0,0,0,0.18)]">
        <div
          class="inline-flex items-center gap-3 px-5 py-2 rounded-full bg-white/10 border border-white/20 text-[#D3DCD3] text-sm font-medium tracking-wide mb-8">

          <div class="w-2.5 h-2.5 rounded-full bg-[#48AE4D]"></div>
          Learn about:
        </div>


        <h2 class="text-4xl md:text-5xl font-bold text-white leading-tight mb-8">
          Essential Care for
          Horticultural Plants
        </h2>
        <div class="text-[#D3DCD3] text-lg leading-[2rem] mb-10">

          Vegetable plants are those grown primarily for food, such as vegetables, herbs, and some fruits.

          <br><br>

          Success in vegetable gardening begins with soil
          preparation and continues with watering, disease control, and harvesting.

        </div>


        <div class="grid grid-cols-2 gap-5">
          <div class="bg-white/10 border border-white/10 rounded-2xl p-5">
            <div class="text-3xl mb-3">
              <img loading="lazy" decoding="async" src="resources/images/care/hand.png" alt="" class="w-10 h-10">
            </div>
            <div class="text-white font-semibold">
              Low Maintenance
            </div>

            <div class="text-white/70 text-sm mt-1">
              Easy to care for daily
            </div>
          </div>

          <div class="bg-white/10 border border-white/10 rounded-2xl p-5">

            <div class="text-3xl mb-3">
              <img loading="lazy" decoding="async" src="resources/images/care/11.png" alt="" class="w-10 h-10">
            </div>

            <div class="text-white font-semibold">
              Bright Spaces
            </div>

            <div class="text-white/70 text-sm mt-1">
              Thrives with sunlight
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>








<section class="relative py-24 px-6 overflow-hidden bg-[#6B8C6C]">
