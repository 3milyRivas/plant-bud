        <div
          class="absolute -inset-2 bg-[#48AE4D]/20 blur-2xl opacity-0 group-hover:opacity-100 transition duration-500">
        </div>

        <img loading="lazy" decoding="async" src="resources/images/care/fennel.jpg"
          class="relative w-full h-[420px] object-cover group-hover:scale-110 transition duration-700" alt="suc3">

        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent">
        </div>

        <div class="absolute bottom-0 left-0 p-6">

