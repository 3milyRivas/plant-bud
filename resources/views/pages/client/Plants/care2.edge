        <img loading="lazy" decoding="async" src="resources/images/care/Allium_canadense.jpg"
          class="relative w-full h-[420px] object-cover group-hover:scale-110 transition duration-700" alt="suc4">

        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent">
