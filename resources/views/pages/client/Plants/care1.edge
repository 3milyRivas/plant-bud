    </div>






    <section class="relative py-24 px-6 overflow-hidden bg-[#6B8C6C]">
        <div class="absolute top-[-120px] left-[-120px] w-[420px] h-[420px] bg-[#48AE4D]/30 blur-[120px] rounded-full">
