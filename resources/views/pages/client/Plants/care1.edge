<div class="relative text-[#113e14]">
  @!component('components/header', {
  title: "Taking care of plants is care of yourself",
  text: "Sustainable outdoor solutions designed to inspire peaceful spaces and healthier living.",
  imageBg:'bg-[url(/resources/images/care/swisss.jpg)]',
  catalogHref: '/ornamental',
  careHref: '/care1',
  })
  <section class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 lg:px-10">
    <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
      <div class="relative group">
        <div
          class="relative overflow-hidden rounded-[42px] border border-[#ebe3a7]/38 shadow-2xl">
          <img decoding="async" src="/resources/images/care/ff.jpg" alt="Succulent plants"
            class="homepage-hero-media h-[620px] w-full object-cover transition duration-700 group-hover:scale-105">
          <div class="absolute inset-0 bg-[#113e14]/35"></div>
        </div>
