</div>
<section class="relative mx-auto max-w-7xl px-5 pt-16 lg:px-10">
  <div class="flex items-center justify-center">
    <div class="h-px w-16 bg-white/45"></div>
    <div class="mx-6 rounded-full bg-[#ebe3a7]/82 px-6 py-2 text-sm font-black uppercase tracking-[0.2em] text-[#113e14]">
      Ornamental plants
    </div>
    <div class="h-px w-16 bg-white/45"></div>
