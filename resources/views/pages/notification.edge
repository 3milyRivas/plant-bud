<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Notifications</title>
</head>

<body class="bg-[#89A589] min-h-screen flex flex-col">
    <div class="relative bg-[url('resources/images/plant-budd.png')] bg-cover bg-center h-[50vh] w-full">
        <div
            class="absolute top-[20%] left-6 bg-[url('resources/images/essential/logo.png')] bg-contain bg-no-repeat h-20 w-20">
        </div>

        <div class="absolute top-[40%] left-1/2 transform -translate-x-1/2 flex items-center gap-3">
            <div class="bg-white/20 border border-white/40 rounded-full shadow-md flex items-center px-4">
                <input type="text"
                    class="bg-transparent outline-none flex-grow text-gray-700 placeholder-gray-500 h-[44px] w-[500px]" />
            </div>

            <button class="bg-white/20 border border-white/40 rounded-full shadow-md p-3 hover:bg-white/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-700" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5 0 016.15 13.65z" />
                </svg>
            </button>
        </div>

        <button
            class="absolute bottom-4 left-6 bg-white/70 text-[#113E14] font-bold px-12 py-2 rounded-full shadow-md hover:bg-white text-xl">
            Back
        </button>
    </div>

    <div class="bg-white/70 flex items-center justify-between px-12 h-24">
        <!-- la wea del título -->
        <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-[url('resources/img/img3.png')] bg-contain bg-no-repeat"></div>
            <span class="text-[#113E14] font-bold text-3xl">Notifications</span>
            <div class="w-12 h-12 bg-[url('resources/img/img3.png')] -scale-x-100  bg-contain bg-no-repeat"></div>
        </div>

        <!-- Botones -->
        <div class="flex items-center">
            <button
                class="mx-12 w-10 h-10 p-2 bg-[url('resources/img/home2.png')] bg-contain bg-no-repeat active:shadow-lg rounded-lg transition"></button>

            <button
                class="mx-12 flex items-center space-x-2 bg-white rounded-2xl px-6 py-3 shadow-md hover:bg-white/70 transition active:bg-green-900 active:text-white active:shadow-lg active:translate-y-1 focus:outline-none">
                <div class="w-6 h-6 bg-[url('resources/img/campana2.png')] bg-contain bg-no-repeat"></div>
                <span class="font-semibold">Notifications</span>
            </button>

            <button
                class="mx-12 w-10 h-10 p-2 bg-[url('resources/img/fav.png')] bg-contain bg-no-repeat active:shadow-lg rounded-lg transition"></button>
        </div>

        <!-- el coso de perfil -->
        <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-[url('resources/img/phot.jpg')] bg-cover bg-center rounded-full"></div>
            <div class="flex flex-col">
                <span class="text-black/60 text-xl font-semibold">María Antonieta de las Nieves</span>
                <a href="#" class="text-blue-600 hover:underline text-sm">Switch</a>
            </div>
        </div>
    </div>

    <div class="flex bg-[#6C8E6B]/80 px-6 py-10 space-x-6">

        <div class="flex flex-col mx-auto space-y-8 py-8">
            <!-- la wea de Activity -->
            <div class="bg-white/70 rounded-xl shadow-md p-6 w-[900px]">

                <!-- Header -->
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-bold">Activity</h2>

                    <div class="flex items-center space-x-2">
                        <div class="w-[600px] h-[1px] bg-[url('resources/img/line.png')] bg-cover bg-center"></div>
                        <span class="text-white text-sm font-semibold">Sort by</span>
                        <span class="text-black text-sm font-semibold">Recent</span>
                        <div class="w-4 h-4 bg-[url('resources/img/row.png')] bg-contain bg-no-repeat"></div>
                    </div>
                </div>

                <div class="text-gray-500 text-sm font-semibold mb-4">Today</div>

                <div class="space-y-4">

                    
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-full bg-cover bg-center"
                                style="background-image:url('resources/img/phot.jpg')"></div>
                            <div>
                                <span class="font-semibold">Deraa</span>
                                <span class="text-gray-600"> empezó a seguirte</span>
                            </div>
                        </div>
                        <button class="text-blue-600 font-semibold hover:underline">
                            Follow
                        </button>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-full bg-cover bg-center"
                                style="background-image:url('resources/img/person2.jpg')"></div>
                            <div>
                                <span class="font-semibold">Ju4nit0</span>
                                <span class="text-gray-600"> le dio like a tu foto</span>
                            </div>
                        </div>

                       
                        <div class="w-12 h-12 rounded-md bg-cover bg-center"
                            style="background-image:url('resources/img/flower3.jpg')"></div>
                    </div>

                </div>

                <div class="text-gray-500 text-sm font-semibold mt-6 mb-4">Yesterday</div>

                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-full bg-cover bg-center"
                                style="background-image:url('resources/img/person4.jpg')"></div>
                            <div>
                                <span class="font-semibold">Marquez</span>
                                <span class="text-gray-600"> le dio like a tu foto</span>
                            </div>
                        </div>

                        <div class="w-12 h-12 rounded-md bg-cover bg-center"
                            style="background-image:url('resources/img/flower5.jpg')"></div>
                    </div>
                </div>

            </div>


            <!-- el coso de Suggestions -->
            <div class="bg-white/70 rounded-xl shadow-md p-6 w-full w-[900px]">
                <h2 class="text-xl font-bold mb-4">Suggestions for you</h2>
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-[url('resources/img/person6.jpg')] bg-cover bg-center rounded-full">
                            </div>
                            <span class="font-semibold">Carla Méndez</span>
                        </div>
                        <button class="text-blue-600 font-semibold hover:underline">Follow</button>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-[url('resources/img/person4.jpg')] bg-cover bg-center rounded-full">
                            </div>
                            <span class="font-semibold">Tatiana Zaldaña</span>
                        </div>
                        <button class="text-blue-600 font-semibold hover:underline">Follow</button>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-[url('resources/img/person5.jpg')] bg-cover bg-center rounded-full">
                            </div>
                            <span class="font-semibold">Dalia Rodriguez</span>
                        </div>
                        <button class="text-blue-600 font-semibold hover:underline">Follow</button>
                    </div>
                </div>
            </div>
        </div>
    </div>





</body>

</html>