@layout()
@slot('title')
<title>Plant Bud</title>
@endslot

<div class="min-h-screen overflow-x-hidden text-[#113e14]" data-community-page>
  @!component('components/community/top-navbar', {
    viewer,
    active: 'notification',
    section: 'Notifications'
  })

  <main class="mx-auto grid max-w-[1360px] gap-8 px-4 pb-20 pt-6 lg:px-6 xl:grid-cols-[minmax(0,790px)_26rem] xl:items-start xl:gap-12 2xl:grid-cols-[minmax(0,830px)_27rem] 2xl:gap-14" data-community-layout>
    <section class="min-w-0 space-y-6" data-community-main>
      <div class="rounded-3xl border border-white/30 bg-white/24 p-6 shadow-xl backdrop-blur-xl">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-[#416543]">Recent activity</p>
        <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
          <div>
            <h1 class="text-4xl font-black leading-tight text-[#113e14] md:text-5xl">Notifications</h1>
            <p class="mt-3 max-w-2xl text-sm font-bold leading-6 text-[#416543]">
              Recent follows, comments, and like milestones from your posts.
            </p>
          </div>
          <a href="/community" class="rounded-full bg-[#113e14] px-5 py-2.5 text-sm font-black text-[#ebe3a7] shadow-md transition hover:-translate-y-0.5 hover:bg-[#416543]">Back to feed</a>
        </div>
      </div>

      <div class="rounded-3xl border border-white/30 bg-white/24 p-4 shadow-xl backdrop-blur-xl">
        <div class="space-y-3">
          @each(notification in notifications)
            <a href="{{ notification.href }}" class="group flex items-center justify-between gap-4 rounded-2xl bg-white/28 p-3 transition duration-300 hover:-translate-y-0.5 hover:bg-white/45">
              <div class="flex min-w-0 items-center gap-3">
                @if(notification.actor && notification.actor.avatarUrl)
                  <img src="{{ notification.actor.avatarUrl }}" alt="" class="h-12 w-12 flex-none rounded-full object-cover">
                @elseif(notification.actor)
                  <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-[#113e14] font-black text-[#ebe3a7]">{{ notification.actor.initial }}</span>
                @else
                  <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-[#ebe3a7] font-black text-[#113e14]">PB</span>
                @endif

                <span class="min-w-0">
                  <span class="block text-sm font-black text-[#113e14]">{{ notification.title }}</span>
                  <span class="block truncate text-sm font-semibold text-[#416543]">{{ notification.body }}</span>
                  @if(notification.postPreview)
                    <span class="mt-1 block truncate text-xs font-bold text-[#416543]/70">{{ notification.postPreview }}</span>
                  @endif
                </span>
              </div>

              <div class="flex flex-none items-center gap-3">
                <span class="hidden text-xs font-black text-[#416543]/70 sm:block">{{ notification.createdAtHuman }}</span>
                @if(notification.thumbnailUrl)
                  <img src="{{ notification.thumbnailUrl }}" alt="" class="h-12 w-12 rounded-xl object-cover">
                @else
                  <span class="h-10 w-10 rounded-full bg-[url('/resources/images/community/notifications.png')] bg-contain bg-center bg-no-repeat opacity-80 transition group-hover:scale-110"></span>
                @endif
              </div>
            </a>
          @else
            <div class="rounded-3xl border border-dashed border-white/40 bg-white/18 p-10 text-center">
              <h2 class="text-3xl font-black text-[#113e14]">Quiet for now</h2>
              <p class="mt-3 text-sm font-bold text-[#416543]">New follows, comments, and milestones will appear here.</p>
            </div>
          @end
        </div>
      </div>
    </section>

    <aside class="hidden min-w-0 xl:block" data-community-sidebar>
      <div class="sticky top-28 space-y-4">
        <details open class="rounded-3xl border border-white/30 bg-white/22 p-4 text-[#113e14] shadow-xl backdrop-blur-xl">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <h2 class="text-lg font-black">Your profile</h2>
            <span class="text-xs font-bold text-[#416543]">{{ viewer.roleLabel }}</span>
          </summary>
          <div class="mt-4 flex items-center gap-3">
            @if(viewer.avatarUrl)
              <img src="{{ viewer.avatarUrl }}" alt="" class="h-14 w-14 rounded-full object-cover">
            @else
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-[#113e14] text-xl font-black text-[#ebe3a7]">{{ viewer.initial }}</span>
            @endif
            <span class="min-w-0">
              <span class="block truncate text-sm font-black">{{ viewer.displayName }}</span>
              <span class="block truncate text-xs font-bold text-[#416543]">{{ '@' + viewer.username }}</span>
            </span>
          </div>
        </details>

        <details open class="rounded-3xl border border-white/30 bg-white/22 p-4 text-[#113e14] shadow-xl backdrop-blur-xl">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <h2 class="text-sm font-black">Suggestions</h2>
            <span class="text-xs font-bold text-[#416543]">new</span>
          </summary>
          <div class="mt-4 space-y-3">
            @each(user in suggestions)
              <div class="flex items-center justify-between gap-3 rounded-2xl bg-white/18 p-3">
                <a href="/users/{{ user.username }}" class="flex min-w-0 items-center gap-3">
                  @if(user.avatarUrl)
                    <img src="{{ user.avatarUrl }}" alt="" class="h-10 w-10 rounded-full object-cover">
                  @else
                    <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-[#113e14] text-sm font-black text-[#ebe3a7]">{{ user.initial }}</span>
                  @endif
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-black">{{ user.displayName }}</span>
                    <span class="block truncate text-xs font-bold text-[#416543]">{{ '@' + user.username }}</span>
                  </span>
                </a>
                @form({
                  action: '/users/' + user.username + '/follow',
                  method: 'POST',
                  class: 'shrink-0',
                  'data-follow-form': true
                })
                  <button type="submit" class="rounded-full bg-[#dca15d] px-3 py-1.5 text-xs font-black text-[#113e14] transition hover:bg-[#ebe3a7]" data-follow-label>follow</button>
                @end
              </div>
            @else
              <p class="text-xs font-semibold text-[#416543]">No suggestions right now.</p>
            @end
          </div>
        </details>
      </div>
    </aside>
  </main>
</div>

@end
