@layout()
@slot('title')
<title>Sign Up - Gardener</title>
@endslot

<div class="relative z-10 min-h-screen overflow-hidden" data-auth-page>
    <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[34rem] h-[34rem] bg-[#EDE7D6]/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-[28rem] h-[28rem] bg-[#1E3D19]/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/3 left-0 w-[22rem] h-[22rem] bg-white/5 rounded-full blur-3xl"></div>
    </div>

    <div class="relative min-h-screen grid lg:grid-cols-2">
        <div class="hidden lg:block relative">
            <img src="/resources/images/signup/register-gardener.png" alt="Signup Image" class="absolute inset-0 w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-br from-[#1E3D19]/75 via-[#1E3D19]/35 to-transparent"></div>
            <div class="absolute inset-0 bg-black/20"></div>

            <div class="relative z-10 h-full flex flex-col justify-end p-12 xl:p-16">
                <div class="max-w-md">
                    <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full bg-white/10 backdrop-blur-xl border border-white/10 shadow-xl mb-6">
                        <div class="w-2 h-2 rounded-full bg-[#EDE7D6] animate-pulse"></div>
                        <span class="text-sm font-bold tracking-[0.16em] text-white/85">GARDENER ACCOUNT</span>
                    </div>

                    <h2 class="text-5xl xl:text-6xl font-black text-white leading-[0.95] drop-shadow-2xl">
                        Grow Your
                        <span class="block text-[#EDE7D6]">Professional Profile</span>
                    </h2>

                    <div class="w-28 h-1 bg-[#EDE7D6] rounded-full mt-8 mb-8"></div>

                    <p class="text-lg xl:text-xl font-semibold text-white/85 leading-relaxed">
                        Offer your gardening services, connect with clients, and build your reputation with Plant Bud.
                    </p>
                </div>
            </div>
        </div>

        <div class="relative flex items-center justify-center px-6 py-10 lg:px-10 xl:px-14">
            <a href="/register" class="absolute top-6 left-6 inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/10 backdrop-blur-xl border border-white/10 text-[#EDE7D6] font-bold text-sm shadow-lg hover:bg-[#EDE7D6] hover:text-[#1E3D19] hover:scale-105 transition-all duration-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M15 19l-7-7 7-7"></path>
                </svg>
                Back
            </a>

            <div class="w-full max-w-xl">
                <div class="text-center mb-8">
                    <div class="flex justify-center mb-6">
                        <img src="/resources/images/essential/pb-logo.png" alt="Plant Bud" class="w-42 md:w-58 drop-shadow-[0_0_18px_rgba(255,255,255,0.16)]">
                    </div>

                    <h1 class="text-4xl md:text-5xl font-black text-white leading-tight drop-shadow-xl">
                        Create Account
                    </h1>

                    <div class="w-24 h-1 bg-[#EDE7D6] rounded-full mx-auto mt-5 mb-5"></div>

                    <p class="text-white/80 font-semibold text-base md:text-lg">
                        Sign up as a gardener and start offering your professional services.
                    </p>
                </div>

                <div class="relative">
                    <div class="absolute -inset-2 bg-white/10 blur-3xl rounded-[3rem]"></div>

                    <div class="relative bg-white/10 backdrop-blur-3xl border border-white/10 rounded-[3rem] p-7 md:p-9 shadow-[0_30px_100px_rgba(0,0,0,0.30)] overflow-hidden">
                        <div class="absolute -top-16 -right-16 w-40 h-40 bg-[#EDE7D6]/10 rounded-full blur-3xl"></div>
                        <div class="absolute -bottom-16 -left-16 w-40 h-40 bg-[#1E3D19]/10 rounded-full blur-3xl"></div>

                        @form({ route: 'new_account.store', method: 'POST' })
                        <input type="hidden" name="role" value="gardener">

                        <div class="space-y-5">
                            <div>
                                @field.root({ name: 'username' })
                                @!field.label({ text: 'Username', class: 'block text-[#EDE7D6] font-bold text-sm mb-2 tracking-wide' })

                                <div class="relative">
                                    @!input.control({
                                        placeholder: 'Choose a username',
                                        value: flashMessages.get('old')?.username,
                                        id: 'username',
                                        autocomplete: 'off',
                                        maxlength: 30,
                                        minlength: 3,
                                        'data-required-message': 'Username is required',
                                        'data-username-input': true,
                                        class: 'w-full h-12 px-4 rounded-2xl bg-white/90 text-[#1E3D19] placeholder:text-[#728B6F] font-semibold border border-transparent focus:outline-none focus:ring-2 focus:ring-[#EDE7D6] shadow-lg'
                                    })
                                </div>

                                @!field.error({ class: 'text-red-200 font-bold text-xs mt-2' })
                                @end
                            </div>

                            <div>
                                @field.root({ name: 'display_name' })
                                @!field.label({ text: 'Display Name', class: 'block text-[#EDE7D6] font-bold text-sm mb-2 tracking-wide' })
                                @!input.control({
                                    placeholder: 'Name shown in your gardener profile',
                                    value: flashMessages.get('old')?.display_name,
                                    maxlength: 100,
                                    minlength: 2,
                                    'data-required-message': 'Display name is required',
                                    class: 'w-full h-12 px-4 rounded-2xl bg-white/90 text-[#1E3D19] placeholder:text-[#728B6F] font-semibold border border-transparent focus:outline-none focus:ring-2 focus:ring-[#EDE7D6] shadow-lg'
                                })
                                @!field.error({ class: 'text-red-200 font-bold text-xs mt-2' })
                                @end
                            </div>

                            <div>
                                @field.root({ name: 'email' })
                                @!field.label({ text: 'Email', class: 'block text-[#EDE7D6] font-bold text-sm mb-2 tracking-wide' })
                                @!input.control({
                                    type: 'email',
                                    placeholder: 'Type your email address',
                                    value: flashMessages.get('old')?.email,
                                    'data-required-message': 'Email is required',
                                    class: 'w-full h-12 px-4 rounded-2xl bg-white/90 text-[#1E3D19] placeholder:text-[#728B6F] font-semibold border border-transparent focus:outline-none focus:ring-2 focus:ring-[#EDE7D6] shadow-lg'
                                })
                                @!field.error({ class: 'text-red-200 font-bold text-xs mt-2' })
                                @end
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    @field.root({ name: 'phone' })
                                    @!field.label({ text: 'Phone Number', class: 'block text-[#EDE7D6] font-bold text-sm mb-2 tracking-wide' })
                                    @!input.control({
                                        placeholder: '0000-0000',
                                        value: flashMessages.get('old')?.phone,
                                        'data-required-message': 'Phone number is required',
                                        'data-phone-input': true,
                                        class: 'w-full h-12 px-4 rounded-2xl bg-white/90 text-[#1E3D19] placeholder:text-[#728B6F] font-semibold border border-transparent focus:outline-none focus:ring-2 focus:ring-[#EDE7D6] shadow-lg'
                                    })
                                    @!field.error({ class: 'text-red-200 font-bold text-xs mt-2' })
                                    @end
                                </div>

                                <div>
                                    @field.root({ name: 'dui' })
                                    @!field.label({ text: 'DUI', class: 'block text-[#EDE7D6] font-bold text-sm mb-2 tracking-wide' })
                                    @!input.control({
                                        placeholder: '01234567-8',
                                        value: flashMessages.get('old')?.dui,
                                        'data-required-message': 'DUI is required',
                                        'data-dui-input': true,
                                        class: 'w-full h-12 px-4 rounded-2xl bg-white/90 text-[#1E3D19] placeholder:text-[#728B6F] font-semibold border border-transparent focus:outline-none focus:ring-2 focus:ring-[#EDE7D6] shadow-lg'
                                    })
                                    @!field.error({ class: 'text-red-200 font-bold text-xs mt-2' })
                                    @end
                                </div>
                            </div>

                            <div>
                                @field.root({ name: 'password' })
                                @!field.label({ text: 'Password', class: 'block text-[#EDE7D6] font-bold text-sm mb-2 tracking-wide' })
                                <div class="relative">
                                    @!input.control({
                                        type: 'password',
                                        placeholder: 'Create a password',
                                        id: 'password',
                                        'data-required-message': 'Password is required',
                                        class: 'w-full h-12 pl-4 pr-12 rounded-2xl bg-white/90 text-[#1E3D19] placeholder:text-[#728B6F] font-semibold border border-transparent focus:outline-none focus:ring-2 focus:ring-[#EDE7D6] shadow-lg'
                                    })
                                    <button type="button" data-password-toggle="password" class="absolute inset-y-0 right-0 px-4 flex items-center text-[#728B6F] hover:text-[#1E3D19] transition"></button>
                                </div>
                                @!field.error({ class: 'text-red-200 font-bold text-xs mt-2' })
                                @end
                            </div>

                            <div>
                                @field.root({ name: 'passwordConfirmation' })
                                @!field.label({ text: 'Confirm Password', class: 'block text-[#EDE7D6] font-bold text-sm mb-2 tracking-wide' })
                                <div class="relative">
                                    @!input.control({
                                        type: 'password',
                                        placeholder: 'Repeat your password',
                                        id: 'passwordConfirmation',
                                        'data-required-message': 'Password confirmation is required',
                                        'data-confirm-with': 'password',
                                        class: 'w-full h-12 pl-4 pr-12 rounded-2xl bg-white/90 text-[#1E3D19] placeholder:text-[#728B6F] font-semibold border border-transparent focus:outline-none focus:ring-2 focus:ring-[#EDE7D6] shadow-lg'
                                    })
                                    <button type="button" data-password-toggle="passwordConfirmation" class="absolute inset-y-0 right-0 px-4 flex items-center text-[#728B6F] hover:text-[#1E3D19] transition"></button>
                                </div>
                                @!field.error({ class: 'text-red-200 font-bold text-xs mt-2' })
                                @end
                            </div>

                            <div class="pt-2">
                                @!button({
                                    text: 'Sign Up',
                                    type: 'submit',
                                    class: 'w-full h-13 bg-[#EDE7D6] text-[#1E3D19] rounded-2xl font-black text-base shadow-[0_15px_40px_rgba(0,0,0,0.25)] hover:-translate-y-1 hover:scale-[1.01] active:scale-100 transition-all duration-300'
                                })
                            </div>
                        </div>
                        @end
                    </div>
                </div>

                <p class="text-center text-white/85 font-semibold mt-6 text-sm md:text-base">
                    Already have an account?
                    <a href="/login" class="text-[#EDE7D6] font-black hover:underline">Login here</a>
                </p>
            </div>
        </div>
    </div>
</div>
@end
