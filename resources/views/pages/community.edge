        <!--y aqui se cierra el coso de las publicacipnes nasda mas-->
      </div>
      <!--aquí se cierra el coso central-->
    </div>

    <!-- Columna derecha: activity + suggested -->
    <div class="w-64 space-y-6">
      <div class="bg-white/70 rounded-xl p-4 shadow-md">
        <h3 class="font-bold text-[#113E14] mb-2">Activity</h3>
        <ul class="space-y-2 text-sm text-gray-700">
          <li>Devora started following you <span class="text-gray-400">5m</span></li>
          <li>JulioR16 liked your photo <span class="text-gray-400">30m</span></li>
          <li>Melquez liked your photo <span class="text-gray-400">1d</span></li>
        </ul>
      </div>
      <div class="bg-white/70 rounded-xl p-4 shadow-md">
        <h3 class="font-bold text-[#113E14] mb-2">Suggestions for you</h3>
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-gray-700">Mallen13</span>
          <button class="text-xs bg-green-900 text-white px-3 py-1 rounded-lg hover:bg-green-700">Follow</button>
        </div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-gray-700">Laur4</span>
          <button class="text-xs bg-green-900 text-white px-3 py-1 rounded-lg hover:bg-green-700">Follow</button>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-700">Redr16</span>
