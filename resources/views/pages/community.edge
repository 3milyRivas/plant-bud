              <span class="min-w-0">
                <span class="block truncate text-sm font-black text-black">{{ post.author.displayName }}</span>
                <span class="block truncate text-[11px] font-bold text-black/42">{{ post.author.roleLabel }} - {{ post.createdAtHuman }}</span>
              </span>
