        <div class="mt-4 flex flex-wrap gap-2">
          @each(tag in trendingHashtags)
            <a href="/community/hashtags/{{ tag.tag }}" class="rounded-full bg-white/36 px-3 py-2 text-xs font-black text-[#113E14] transition hover:-translate-y-0.5 hover:bg-[#EDE7D6]">
              #{{ tag.tag }}
