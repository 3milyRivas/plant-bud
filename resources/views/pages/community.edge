      <div class="flex items-center justify-between gap-4">
        <div class="h-0.5 flex-1 bg-[url('/resources/img/line.png')] bg-cover bg-center"></div>
        <p class="rounded-full bg-white/18 px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-black/42">Fresh from the community</p>
      </div>

      <div class="space-y-4" data-community-feed>
        @each(post in posts)
          @!component('components/community-post-card', { post, viewer })
        @else
          <div class="rounded-3xl border border-white/30 bg-white/22 p-8 text-center shadow-lg backdrop-blur-xl">
            <h2 class="text-2xl font-black text-black">No posts yet</h2>
            <p class="mt-2 text-sm font-bold text-black/45">Share the first plant update.</p>
          </div>
        @end
      </div>
    </main>
  </div>
</div>

@end
