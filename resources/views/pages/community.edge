        @if(favoriteAccounts.length)
          <details class="group mt-5" open>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-2xl bg-white/10 px-4 py-3 text-sm font-black transition hover:bg-white/16">
