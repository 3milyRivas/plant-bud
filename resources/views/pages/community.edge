                <circle cx="12" cy="12" r="1.5" />
                <circle cx="12" cy="19" r="1.5" />
              </svg>
            </button>
          </div>


          <p class="text-sm font-semibold">
            Beautiful plant! 🌱
            <span class="text-blue-500">#art #aesthetics #plants #gardens</span>
          </p>


          <div class="rounded-xl w-full h-96 bg-[url('resources/img/flo.jpg')] bg-cover bg-center"></div>



          <div class="flex items-center justify-between">
