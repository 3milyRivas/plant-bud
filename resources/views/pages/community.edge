              <label class="block">
                <span class="text-xs font-black uppercase tracking-[0.12em] text-black/50">Poll options</span>
                <textarea name="poll_options" maxlength="600" rows="3" placeholder="Monstera&#10;Pothos&#10;Snake plant" class="mt-2 w-full resize-none rounded-xl bg-white/75 px-3 py-2 text-sm font-semibold outline-none">{{ old.poll_options ?? '' }}</textarea>
              </label>
