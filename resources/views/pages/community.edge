                <img src="{{ post.mediaUrl }}" alt="" loading="lazy" decoding="async" class="h-11 w-11 rounded-xl object-cover">
              @else
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#113E14] text-xs font-black text-[#EDE7D6]">{{ post.author.initial }}</span>
              @endif
