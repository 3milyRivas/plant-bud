                method: 'POST',
                class: 'shrink-0',
                'data-follow-form': true
              })
                <button type="submit" class="rounded-full bg-[#EDE7D6] px-3 py-1.5 text-xs font-black text-[#113E14] transition hover:bg-white" data-follow-label>follow</button>
              @end
