<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Notification</title>
</head>

<body class="bg-[#89A589] min-h-screen flex flex-col">
  <div class="relative bg-[url('resources/img/img.png')] bg-cover bg-center h-[50vh] w-full">
    <div class="absolute top-[20%] left-6 bg-[url('resources/img/img2.png')] bg-contain bg-no-repeat h-20 w-20"></div>

    <div class="absolute top-[40%] left-1/2 transform -translate-x-1/2 flex items-center gap-3">
      <div class="bg-white/20 border border-white/40 rounded-full shadow-md flex items-center px-4">
        <input type="text"
          class="bg-transparent outline-none grow text-gray-700 placeholder-gray-500 h-11 w-[500px]" />
      </div>

      <button class="bg-white/20 border border-white/40 rounded-full shadow-md p-3 hover:bg-white/30">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-700" fill="none" viewBox="0 0 24 24"
          stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5 0 016.15 13.65z" />
        </svg>
      </button>
    </div>

    <button
      class="absolute bottom-4 left-6 bg-white/70 text-[#113E14] font-bold px-12 py-2 rounded-full shadow-md hover:bg-white text-xl">
      Back
    </button>
  </div>

  <div class="bg-white/70 flex items-center px-4 h-24 space-x-8">
    <div class="flex items-center space-x-2 ml-24">
      <div class="w-12 h-12 bg-[url('resources/img/img3.png')] bg-contain bg-no-repeat"></div>
      <span class="text-[#113E14] font-bold text-3xl">Community</span>
      <div class="w-12 h-12 bg-[url('resources/img/img3.png')] bg-contain bg-no-repeat"></div>
    </div>

    <button
      class="flex items-center space-x-2 bg-white rounded-2xl px-6 py-3 shadow-md hover:bg-white/70 transition active:bg-green-900 active:text-white active:shadow-lg active:translate-y-1 focus:outline-none">
      <div class="w-6 h-6 bg-[url('resources/img/img4.png')] bg-contain bg-no-repeat"></div>
      <span class="font-semibold">Home</span>
    </button>

    <div class="flex items-center">
      <button
        class="w-10 h-10 p-2 mx-8 bg-[url('resources/img/campana.png')] bg-contain bg-no-repeat active:shadow-lg rounded-lg transition px-25"></button>

      <button
        class="w-10 h-10 p-2 mx-10 bg-[url('resources/img/file.png')] bg-contain bg-no-repeat active:shadow-lg rounded-lg transition"></button>

      <button
        class="w-10 h-10 p-2 mx-10 bg-[url('resources/img/fav.png')] bg-contain bg-no-repeat active:shadow-lg rounded-lg transition"></button>
    </div>

    <div class="flex items-center space-x-4">
      <div class="w-12 h-12 bg-[url('resources/img/phot.jpg')] bg-cover bg-center rounded-full"></div>

      <div class="flex flex-col">
        <span class="text-black/60 text-xl font-semibold">María Antonieta de las Nieves</span>
        <a href="#" class="text-blue-600 hover:underline text-sm">Switch</a>
      </div>
    </div>
  </div>

  <div class="flex bg-[#6C8E6B]/80 px-6 py-10 space-x-6">
    <!--esta wea es la izquierda (el coso de perfil y woods)-->
    <div class="w-64 space-y-6">
      <div class="rounded-xl overflow-hidden shadow-md relative bg-white/70 px-3 pt-3">
        <div class="rounded-xl h-40 bg-[url('resources/img/flo.jpg')] bg-cover bg-center"></div>
        <div class="absolute left-1/2 top-20 transform -translate-x-1/2">
          <div
            class="w-24 h-24 bg-[url('resources/img/phot.jpg')] bg-cover bg-center rounded-full border-4 border-white shadow-md">
          </div>
        </div>
        <div class="mt-4 flex flex-col items-center p-4">
          <h2 class="text-center text-lg font-bold text-black">Maria Antonieta de Las Nieves</h2>
          <p class="text-black/30 font-semibold">@m4ria4nt0ni4</p>
          <div class="flex justify-between w-full text-center mt-4">
            <div class="flex-1">
              <p class="font-bold text-black">250</p>
              <p class="text-sm font-semibold text-black/30">Posts</p>
            </div>
            <div class="flex-1">
              <p class="font-bold text-black">2022</p>
              <p class="text-sm font-semibold text-black/30">Followers</p>
            </div>
            <div class="flex-1">
              <p class="font-bold text-black">590</p>
              <p class="text-sm font-semibold text-black/30">Follows</p>
            </div>
          </div>
          <button
            class="bg-[#113E14] text-white font-bold py-2 px-12 rounded-2xl shadow-md hover:bg-[#113E14]/70 transition mt-4 active:shadow-lg active:translate-y-1 focus:outline-none">
            My profile
          </button>
        </div>
      </div>


      <div class="bg-white/70 rounded-xl p-4 shadow-md">
        <div class="flex items-center justify-between pb-4">
          <h3 class="font-bold text-[#113E14]">Your shortcuts</h3>

          <button class="text-xs font-semibold text-gray-500 hover:text-gray-700">
            see all
          </button>
        </div>
        <!--el coso padre-->
        <div class="space-y-4 pb-4">
          <!--woods-->
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 rounded-full bg-[url('resources/img/phot.jpg')] bg-cover bg-center"></div>
            <p class="text-sm font-semibold text-black">Woods</p>
          </div>

          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 rounded-full bg-[url('resources/img/phot.jpg')] bg-cover bg-center"></div>
            <p class="text-sm font-semibold text-black">Flowers</p>
          </div>

          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 rounded-full bg-[url('resources/img/phot.jpg')] bg-cover bg-center"></div>
            <p class="text-sm font-semibold text-black">Medicinals</p>
          </div>

          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 rounded-full bg-[url('resources/img/phot.jpg')] bg-cover bg-center"></div>
            <p class="text-sm font-semibold text-black">Decoratives</p>
          </div>
<!--final de los woods-->
        </div>
      </div>
    </div>

    <!--Aquí va el cooso este de la caja de publicaciones, la inche linea de sort by y los otros cosos-->
    <div class="flex-1 space-y-6">
      <div class="bg-white/70 rounded-3xl p-4 shadow-md space-y-4">
        <div class="flex items-center space-x-6">
          <div class="w-12 h-12 bg-[url('resources/img/phot.jpg')] bg-cover bg-center rounded-full"></div>


          <div class="flex bg-[#FBFBFB] items-center grow rounded-lg px-4 py-2 shadow-sm">
            <input type="text" placeholder="Share something..."
              class="grow bg-transparent outline-none text-gray-700 placeholder-gray-500" />
            <button class="ml-2 p-2 rounded-full transition active:shadow-lg active:translate-y-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5 0 016.15 13.65z" />
              </svg>
            </button>
          </div>
        </div>
        <div class="flex justify-between">
          <button
            class="flex items-center space-x-2 px-3 py-2 rounded-lg active:shadow-lg active:translate-y-1 focus:outline-none">
            <div class="w-6 h-6 bg-[url('resources/img/imagen.png')] bg-contain bg-no-repeat"></div>
            <span class="text-sm font-medium">Images</span>
          </button>

          <button
            class="flex items-center space-x-2 px-3 py-2 rounded-lg active:shadow-lg active:translate-y-1 focus:outline-none">
            <div class="w-6 h-6 bg-[url('resources/img/video.png')] bg-contain bg-no-repeat"></div>
            <span class="text-sm font-medium">Video</span>
          </button>

          <button
            class="flex items-center space-x-2 px-3 py-2 rounded-lg active:shadow-lg active:translate-y-1 focus:outline-none">
            <div class="w-6 h-6 bg-[url('resources/img/pol.png')] bg-contain bg-no-repeat"></div>
            <span class="text-sm font-medium">Poll</span>
          </button>

          <button
            class="flex items-center space-x-2 px-3 py-2 text-black/46 rounded-lg active:shadow-lg active:translate-y-1 focus:outline-none">
            <div class="w-6 h-6 bg-[url('resources/img/send.png')] bg-contain bg-no-repeat"></div>
            <span class="text-sm font-medium">Publish</span>
          </button>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <div class="w-full h-0.5 bg-[url('resources/img/line.png')] bg-cover bg-center"></div>
        <div class="flex items-center space-x-2 ml-2">
          <span class="text-sm font-bold text-black/30">Sort by</span>
          <span class="text-sm font-semibold text-black">Recent</span>
          <div class="w-8 h-8 bg-[url('resources/img/row.png')] bg-contain bg-no-repeat"></div>
        </div>
      </div>

      <!-- Publicaciones -->
      <div class="space-y-4">
        <div class="max-w-full h-400 px-20 mx-auto bg-white/80 rounded-3xl shadow-lg p-4 space-y-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-12 h-12 bg-[url('resources/img/aleja.jpg')] bg-cover bg-center rounded-full"></div>
              <div>
