  })

  <div class="mx-auto grid max-w-[1360px] gap-8 px-4 pb-24 pt-36 lg:px-6 xl:grid-cols-[minmax(0,790px)_26rem] xl:items-start xl:gap-12 2xl:grid-cols-[minmax(0,830px)_27rem] 2xl:gap-14">
    <main class="min-w-0 space-y-6">

      @form({
