      <div class="rounded-3xl border border-white/30 bg-white/24 p-4 shadow-xl backdrop-blur-xl transition duration-300 hover:bg-white/28">
        @form({
          action: '/community/posts',
          method: 'POST',
          enctype: 'multipart/form-data',
          class: 'space-y-4',
          'data-community-post-form': true
