              </button>
              <button class="flex items-center space-x-2">
                <div class="w-5 h-5 bg-[url('resources/img/com.png')] bg-cover bg-center"></div>
                <span class="text-sm font-semibold text-black/30">120</span>
              </button>
              <button class="flex items-center space-x-2">
