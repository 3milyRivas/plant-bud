            <div class="min-w-0 flex-1 rounded-2xl bg-[#FBFBFB] px-4 py-3 shadow-sm">
              <textarea name="body" maxlength="2000" rows="2" placeholder="Share a plant update, question, or small win..." class="min-h-16 w-full resize-none bg-transparent text-sm font-semibold text-gray-700 outline-none placeholder:text-gray-500" data-community-composer-input>{{ old.body ?? '' }}</textarea>
            </div>
          </div>

          @if(errors.body)
            <p class="text-xs font-bold text-red-800">{{ errors.body[0] }}</p>
          @endif
          <p class="hidden text-xs font-bold text-red-800" data-community-form-error></p>

