            </summary>

            <div class="community-favorite-accounts-scroll mt-3 max-h-80 space-y-3 overflow-y-auto pr-1">
              @each(account in favoriteAccounts)
                <a href="/users/{{ account.username }}" class="flex items-center justify-between gap-3 rounded-2xl bg-white/12 p-3 transition hover:-translate-y-0.5 hover:bg-white/20">
