            <p class="mt-2 text-2xl font-black sm:mt-3 sm:text-4xl">{{ stats.users }}</p>
          </article>
          <article class="rounded-[1.2rem] bg-[#416543] p-3 text-white shadow-xl sm:rounded-[1.6rem] sm:p-6">
            <p class="text-[9px] font-black uppercase tracking-[0.1em] text-[#ebe3a7] sm:text-xs sm:tracking-[0.18em]">Posts</p>
            <p class="mt-2 text-2xl font-black sm:mt-3 sm:text-4xl">{{ stats.posts }}</p>
          </article>
          <article class="rounded-[1.2rem] bg-[#dca15d] p-3 shadow-xl sm:rounded-[1.6rem] sm:p-6">
            <p class="text-[9px] font-black uppercase tracking-[0.1em] sm:text-xs sm:tracking-[0.18em]">Admins</p>
            <p class="mt-2 text-2xl font-black sm:mt-3 sm:text-4xl">{{ stats.admins }}</p>
          </article>
        </section>

        <section class="mt-7 grid gap-7 xl:grid-cols-[0.78fr_1.22fr] xl:items-start">
          <div class="min-w-0 rounded-[1.75rem] border border-[#113e14]/10 bg-white p-5 shadow-xl sm:p-7">
            <p class="text-xs font-black uppercase tracking-[0.18em] text-[#416543]">Controlled creation</p>
            <h2 class="mt-2 text-2xl font-black">Add account</h2>
            <p class="mt-2 text-sm font-semibold leading-6 text-[#416543]">Passwords are stored as secure hashes. Only the owner can create another administrator.</p>

            <form action="/admin/users" method="POST" class="mt-6 grid gap-4 sm:grid-cols-2">
              {{ csrfField() }}
              <label class="text-sm font-black">First name
                <input name="first_name" required maxlength="50" class="mt-2 w-full rounded-xl border border-[#416543]/20 bg-[#f5f2df] px-4 py-3 outline-none focus:border-[#113e14]">
              </label>
              <label class="text-sm font-black">Last name
                <input name="last_name" required maxlength="50" class="mt-2 w-full rounded-xl border border-[#416543]/20 bg-[#f5f2df] px-4 py-3 outline-none focus:border-[#113e14]">
              </label>
              <label class="text-sm font-black">Username
                <input name="username" required maxlength="30" pattern="[a-z0-9][a-z0-9._]{1,28}[a-z0-9]" class="mt-2 w-full rounded-xl border border-[#416543]/20 bg-[#f5f2df] px-4 py-3 outline-none focus:border-[#113e14]">
              </label>
              <label class="text-sm font-black">Email
                <input name="email" type="email" required maxlength="254" class="mt-2 w-full rounded-xl border border-[#416543]/20 bg-[#f5f2df] px-4 py-3 outline-none focus:border-[#113e14]">
              </label>
              <label class="text-sm font-black">Profile type
                <select name="role" class="mt-2 w-full rounded-xl border border-[#416543]/20 bg-[#f5f2df] px-4 py-3">
                  <option value="client">Client</option>
                  <option value="gardener">Gardener</option>
                  <option value="nursery">Nursery</option>
                </select>
              </label>
              @if(adminUser.isOwner)
                <label class="text-sm font-black">Access
                  <select name="access_level" class="mt-2 w-full rounded-xl border border-[#416543]/20 bg-[#f5f2df] px-4 py-3">
                    <option value="member">Standard account</option>
                    <option value="admin">Administrator</option>
                  </select>
                </label>
              @else
                <input type="hidden" name="access_level" value="member">
              @endif
              <label class="text-sm font-black sm:col-span-2">Temporary password
                <input name="password" type="password" required minlength="10" autocomplete="new-password" class="mt-2 w-full rounded-xl border border-[#416543]/20 bg-[#f5f2df] px-4 py-3 outline-none focus:border-[#113e14]">
              </label>
              <button class="rounded-full bg-[#113e14] px-6 py-3 text-sm font-black text-white transition hover:bg-[#416543] sm:col-span-2">Create account</button>
            </form>
          </div>

          <div id="accounts" class="min-w-0 rounded-[1.75rem] border border-[#113e14]/10 bg-white p-5 shadow-xl sm:p-7">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.18em] text-[#416543]">Identity and access</p>
                <h2 class="mt-2 text-2xl font-black">Accounts</h2>
              </div>
              <form action="/admin#accounts" method="GET" class="grid grid-cols-[minmax(0,1fr)_auto] gap-2">
                <input name="q" value="{{ search }}" placeholder="Email, name, username" class="w-full min-w-0 rounded-full border border-[#416543]/20 bg-[#f5f2df] px-4 py-2.5 text-sm outline-none">
                <button class="rounded-full bg-[#416543] px-4 py-2.5 text-xs font-black text-white">Search</button>
              </form>
            </div>

            <div class="mt-5 space-y-3">
              @each(user in users)
                <article class="min-w-0 rounded-[1.25rem] border border-[#416543]/12 bg-[#f5f2df]/75 p-4">
                  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        <p class="truncate font-black">{{ user.accountProfile?.displayName || user.fullName }}</p>
                        <span class="rounded-full bg-[#113e14] px-2.5 py-1 text-[10px] font-black uppercase text-[#ebe3a7]">{{ user.accessLevel }}</span>
                        <span class="rounded-full bg-[#416543]/12 px-2.5 py-1 text-[10px] font-black uppercase">{{ user.role }}</span>
                      </div>
                      <p class="mt-1 truncate text-xs font-bold text-[#416543]">{{ user.email }} - {{ '@' + user.username }}</p>
                    </div>

                    @if(!user.isOwner && user.id !== adminUser.id)
                      <div class="grid gap-2">
                        @if(adminUser.isOwner)
                          <form action="/admin/users/{{ user.id }}/access" method="POST" class="grid grid-cols-[minmax(0,1fr)_auto] gap-2">
                            {{ csrfField() }}
                            <input type="hidden" name="access_level" value="{{ user.isAdmin ? 'member' : 'admin' }}">
                            <input name="current_password" type="password" required autocomplete="current-password" placeholder="Your password" class="w-full min-w-0 rounded-full border border-[#416543]/20 bg-white px-3 py-2 text-xs">
                            <button class="rounded-full bg-[#dca15d] px-4 py-2 text-xs font-black">{{ user.isAdmin ? 'Remove admin' : 'Make admin' }}</button>
                          </form>
                        @endif
                        @if(!user.isAdmin || adminUser.isOwner)
                          <form action="/admin/users/{{ user.id }}/delete" method="POST" class="grid grid-cols-[minmax(0,1fr)_auto] gap-2" onsubmit="return confirm('Delete this account and its related content? This cannot be undone.')">
                            {{ csrfField() }}
                            <input name="current_password" type="password" required autocomplete="current-password" placeholder="Your password" class="w-full min-w-0 rounded-full border border-red-900/20 bg-white px-3 py-2 text-xs">
                            <button class="rounded-full bg-red-800 px-4 py-2 text-xs font-black text-white">Delete</button>
                          </form>
                        @endif
                      </div>
                    @endif
                  </div>
                </article>
              @else
                <p class="rounded-2xl bg-[#f5f2df] p-5 text-sm font-bold text-[#416543]">No accounts match this search.</p>
              @end
            </div>
          </div>
        </section>

        <section id="recent-posts" class="mt-7 rounded-[1.75rem] border border-[#113e14]/10 bg-white p-5 shadow-xl sm:p-7">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#416543]">Moderation</p>
          <h2 class="mt-2 text-2xl font-black">Recent posts</h2>
          <div class="mt-5 grid gap-3 lg:grid-cols-2">
            @each(post in posts)
              <article class="flex flex-col justify-between rounded-[1.25rem] border border-[#416543]/12 bg-[#f5f2df]/75 p-4">
                <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-3">
                  <div class="grid h-[4.5rem] w-[4.5rem] place-items-center overflow-hidden rounded-xl border border-[#416543]/12 bg-[#113e14]/8">
                    @if(post.mediaType === 'image' && post.mediaUrl)
                      <img src="{{ post.mediaUrl }}" alt="Post image preview" loading="lazy" decoding="async" class="h-full w-full object-cover" data-admin-post-preview>
                    @else
                      <svg class="h-7 w-7 text-[#416543]/45" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 5h16v14H4zM7 15l3-3 2 2 2-2 3 3M8 9h.01" />
                      </svg>
                    @endif
                  </div>
                  <div class="min-w-0">
                    <p class="truncate text-xs font-black text-[#416543]">{{ '@' + post.user.username }} - #{{ post.id }}</p>
                    <p class="mt-1 line-clamp-3 text-sm font-semibold leading-5">{{ post.body || 'Image post' }}</p>
                    <p class="mt-1 text-[10px] font-bold uppercase tracking-[0.1em] text-[#416543]/60">{{ post.mediaType === 'image' ? 'Image post' : 'Text post' }}</p>
                  </div>
                </div>
                <div class="mt-4 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
                  <a href="/community#post-{{ post.id }}" class="truncate text-xs font-black text-[#416543] underline">View original post</a>
                  <form action="/admin/posts/{{ post.id }}/delete" method="POST" onsubmit="return confirm('Delete post #{{ post.id }} by {{ '@' + post.user.username }}?')">
                    {{ csrfField() }}
                    <button class="rounded-full bg-red-800 px-4 py-2 text-xs font-black text-white">Delete post</button>
                  </form>
                </div>
              </article>
            @else
              <p class="rounded-2xl bg-[#f5f2df] p-5 text-sm font-bold text-[#416543]">There are no posts to review.</p>
            @end
          </div>
        </section>

        <section id="audit-log" class="mt-7 rounded-[1.75rem] bg-[#113e14] p-5 text-white shadow-xl sm:p-7">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#ebe3a7]">Audit trail</p>
          <h2 class="mt-2 text-2xl font-black">Recent administrative actions</h2>
          <div class="mt-5 space-y-2">
            @each(log in logs)
              <div class="rounded-xl border border-white/10 bg-white/8 px-4 py-3">
                <p class="text-sm font-black">{{ log.summary }}</p>
                <p class="mt-1 text-xs font-bold text-white/55">{{ log.actorEmail }} - {{ log.createdAt.toFormat('dd LLL yyyy, HH:mm') }}</p>
              </div>
            @else
              <p class="text-sm font-bold text-white/60">No administrative actions recorded yet.</p>
            @end
          </div>
        </section>
      </main>
