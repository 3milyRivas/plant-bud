<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Favorites</title>
</head>

<body class="bg-[#89A589] min-h-screen flex flex-col">
  <div class="relative bg-[url('/img/img.png')] bg-cover bg-center h-[50vh] w-full">
    <div class="absolute top-[20%] left-6 bg-[url('/img/img2.png')] bg-contain bg-no-repeat h-20 w-20"></div>

    <div class="absolute top-[40%] left-1/2 transform -translate-x-1/2 flex items-center gap-3">
      <div class="bg-white/20 border border-white/40 rounded-full shadow-md flex items-center px-4">
        <input type="text"
          class="bg-transparent outline-none flex-grow text-gray-700 placeholder-gray-500 h-[44px] w-[500px]" />
      </div>

      <button class="bg-white/20 border border-white/40 rounded-full shadow-md p-3 hover:bg-white/30">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-700" fill="none" viewBox="0 0 24 24"
          stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5 0 016.15 13.65z" />
        </svg>
      </button>
    </div>

    <button
      class="absolute bottom-4 left-6 bg-white/70 text-[#113E14] font-bold px-12 py-2 rounded-full shadow-md hover:bg-white text-xl">
      Back
    </button>
  </div>

  <div class="bg-white/70 flex items-center justify-between px-12 h-24">
  <!-- la wea del título -->
  <div class="flex items-center space-x-4">
    <div class="w-12 h-12 bg-[url('/img/img3.png')] bg-contain bg-no-repeat"></div>
    <span class="text-[#113E14] font-bold text-3xl">Favorites</span>
    <div class="w-12 h-12 bg-[url('/img/img3.png')] bg-contain bg-no-repeat"></div>
  </div>

  <!-- Botones -->
  <div class="flex items-center">
    <button class="mx-12 w-10 h-10 p-2 bg-[url('/img/home2.png')] bg-contain bg-no-repeat active:shadow-lg rounded-lg transition"></button>

    <button class="mx-12 w-10 h-10 p-2 bg-[url('/img/campana.png')] bg-contain bg-no-repeat active:shadow-lg rounded-lg transition"></button>

    <button class="mx-12 flex items-center space-x-2 bg-white rounded-2xl px-6 py-3 shadow-md hover:bg-white/70 transition active:bg-green-900 active:text-white active:shadow-lg active:translate-y-1 focus:outline-none">
      <div class="w-6 h-6 bg-[url('/img/favorites2.png')] bg-contain bg-no-repeat"></div>
      <span class="font-semibold">Favorites</span>
    </button>
  </div>

  <!-- el coso de perfil -->
  <div class="flex items-center space-x-4">
    <div class="w-12 h-12 bg-[url('/img/phot.jpg')] bg-cover bg-center rounded-full"></div>
    <div class="flex flex-col">
      <span class="text-black/60 text-xl font-semibold">María Antonieta de las Nieves</span>
      <a href="#" class="text-blue-600 hover:underline text-sm">Switch</a>
    </div>
  </div>
</div>

  <div class="flex bg-[#6C8E6B]/80 px-6 py-10 space-x-6">

    <!--Aquí va el cooso este de la caja de publicaciones, la inche linea de sort by y los otros cosos-->
    <div class="flex-1 space-y-6">

      <div class="flex items-center justify-between w-[700px] mx-auto p-6 space-y-6">
        <div class="w-full h-[2px] bg-[url('/img/line.png')] bg-cover bg-center"></div>
        <div class="flex items-center space-x-2 ml-2">
          <span class="text-sm font-bold text-black/30">Sort by</span>
          <span class="text-sm font-semibold text-black">Recent</span>
          <div class="w-8 h-8 bg-[url('/img/row.png')] bg-contain bg-no-repeat"></div>
        </div>
      </div>

      <!-- Publicaciones -->
      <div class="w-[600px] mx-auto bg-white/80 rounded-3xl shadow-lg p-6 space-y-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-12 h-12 bg-[url('/img/person1.jpg')] bg-cover bg-center rounded-full"></div>
              <div>
                <p class="font-semibold text-sm">Aleja.</p>
                <p class="text-xs text-gray-500">12 minutes ago</p>
              </div>
            </div>

            <button class="p-2 rounded-full hover:bg-gray-200">
              <svg class="w-5 h-5 text-gray-600" fill="currentColor">
                <circle cx="12" cy="5" r="1.5" />
                <circle cx="12" cy="12" r="1.5" />
                <circle cx="12" cy="19" r="1.5" />
              </svg>
            </button>
          </div>


          <p class="text-sm font-semibold">
            Beautiful plant! 🌱
            <span class="text-blue-500">#art #aesthetics #plants #gardens</span>
          </p>


          <div class="rounded-xl w-full h-96 bg-[url('/img/flower1.jpg')] bg-cover bg-center"></div>



          <div class="flex items-center justify-between">
