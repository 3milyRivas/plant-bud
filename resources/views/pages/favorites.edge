@layout()

@slot('title')
<title>Saved Posts</title>
@endslot

<div class="min-h-screen text-[#113e14]" data-community-page data-favorites-page>
  @!component('components/community/top-navbar', {
    viewer,
    active: 'favorites',
    section: 'Saved posts'
  })

  <main class="mx-auto grid max-w-[1180px] gap-6 px-4 pb-20 pt-6 lg:grid-cols-[1fr_19rem] lg:px-8">
    <section class="min-w-0 space-y-6">
      <div class="rounded-3xl border border-white/30 bg-white/24 p-6 shadow-xl backdrop-blur-xl">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-[#416543]">Private collection</p>
        <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
          <div>
            <h1 class="text-4xl font-black leading-tight text-[#113e14] md:text-5xl">Saved posts</h1>
            <p class="mt-3 max-w-2xl text-sm font-bold leading-6 text-[#416543]">
              Posts you save live here only for your account.
            </p>
          </div>
          <a href="/community" class="rounded-full bg-[#113e14] px-5 py-2.5 text-sm font-black text-[#ebe3a7] shadow-md transition hover:-translate-y-0.5 hover:bg-[#416543]">Back to feed</a>
        </div>
      </div>

      <div class="space-y-5" data-community-feed>
        @each(post in posts)
          @!component('components/community-post-card', { post, viewer })
        @else
          <div class="rounded-3xl border border-white/30 bg-white/24 p-10 text-center shadow-xl backdrop-blur-xl">
            <h2 class="text-3xl font-black text-[#113e14]">No saved posts yet</h2>
            <p class="mt-3 text-sm font-bold leading-6 text-[#416543]">
              Save community posts and they will appear here.
            </p>
            <a href="/community" class="mt-6 inline-flex rounded-full bg-[#113e14] px-6 py-3 text-sm font-black text-[#ebe3a7] transition hover:-translate-y-0.5 hover:bg-[#416543]">
              Explore community
            </a>
          </div>
        @end
      </div>
    </section>

    <aside class="hidden lg:block">
      <div class="sticky top-28 space-y-4">
        <details open class="rounded-3xl border border-white/30 bg-white/22 p-4 text-[#113e14] shadow-xl backdrop-blur-xl">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <h2 class="text-lg font-black">Your community</h2>
            <span class="text-xs font-bold text-[#416543]">private</span>
          </summary>
          <div class="mt-4 grid grid-cols-2 gap-3 text-center">
            <div class="rounded-2xl bg-white/30 p-4">
              <p class="text-2xl font-black" data-saved-total>{{ viewer.stats.saved }}</p>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#416543]">Saved</p>
            </div>
            <div class="rounded-2xl bg-white/30 p-4">
              <p class="text-2xl font-black">{{ viewer.stats.posts }}</p>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#416543]">Posts</p>
            </div>
          </div>
        </details>

        <details open class="rounded-3xl border border-white/30 bg-white/22 p-4 text-[#113e14] shadow-xl backdrop-blur-xl">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <h2 class="text-sm font-black">Suggestions</h2>
            <span class="text-xs font-bold text-[#416543]">new</span>
          </summary>
          <div class="mt-4 space-y-3">
            @each(user in suggestions)
              <a href="/users/{{ user.username }}" class="flex items-center gap-3 rounded-2xl bg-white/20 p-3 transition hover:-translate-y-0.5 hover:bg-white/34">
                @if(user.avatarUrl)
                  <img src="{{ user.avatarUrl }}" alt="" class="h-10 w-10 rounded-full object-cover">
                @else
                  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#113e14] text-sm font-black text-[#ebe3a7]">
                    {{ user.initial }}
                  </span>
                @endif
                <span class="min-w-0">
                  <span class="block truncate text-sm font-black">{{ user.displayName }}</span>
                  <span class="block truncate text-xs font-bold text-[#416543]">{{ user.roleLabel }} - {{ '@' + user.username }}</span>
                </span>
              </a>
            @else
              <p class="text-xs font-semibold text-[#416543]">No suggestions right now.</p>
            @end
          </div>
        </details>
      </div>
    </aside>
  </main>
</div>

@end
