@layout()
@slot('title')
<title>Plant Bud - Saved</title>
@endslot

<div class="min-h-screen text-[#113e14]" data-community-page data-favorites-page>
  @!component('components/community/top-navbar', {
    viewer,
    active: 'favorites',
    section: 'Saved posts'
  })

  <main class="mx-auto grid max-w-[1280px] gap-7 px-4 pb-24 pt-7 lg:grid-cols-[minmax(0,1fr)_20rem] lg:px-8" data-community-layout="compact">
    <section class="min-w-0 space-y-6" data-community-main>
      <div class="relative overflow-hidden rounded-[2rem] border border-white/20 bg-[#113e14]/90 p-7 text-white shadow-[0_28px_80px_rgba(17,62,20,0.28)] backdrop-blur-2xl md:p-9">
        <div class="absolute -right-16 -top-20 h-56 w-56 rounded-full bg-[#a8b841]/20 blur-2xl"></div>
        <div class="absolute -bottom-24 right-28 h-48 w-48 rounded-full bg-[#dca15d]/20 blur-2xl"></div>
        <div class="relative flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.22em] text-[#ebe3a7]">Your private collection</p>
            <h1 class="mt-3 font-abril text-5xl leading-tight md:text-6xl">Saved posts</h1>
            <p class="mt-4 max-w-2xl text-sm font-semibold leading-7 text-white/72">
              Keep useful ideas, plant inspiration, and community advice together in one place.
            </p>
          </div>
          <div class="flex items-center gap-3">
            <div class="rounded-[1.25rem] border border-white/12 bg-white/10 px-5 py-3 text-center">
              <p class="text-3xl font-black" data-saved-total>{{ viewer.stats.saved }}</p>
              <p class="text-[10px] font-black uppercase tracking-[0.16em] text-white/55">Saved</p>
            </div>
            <a href="/community" class="rounded-full bg-[#dca15d] px-5 py-3 text-sm font-black text-[#113e14] shadow-lg transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]">Explore feed</a>
          </div>
        </div>
      </div>

      <div class="flex items-end justify-between gap-4 px-1">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#ebe3a7]">Collection</p>
          <h2 class="mt-1 text-2xl font-black text-white">Posts worth returning to</h2>
        </div>
        <span class="rounded-full bg-white/16 px-4 py-2 text-xs font-black text-white backdrop-blur-xl">{{ posts.length }} posts</span>
      </div>

      <div class="space-y-6" data-community-feed>
        @each(post in posts)
          @!component('components/community-post-card', { post, viewer, surface: 'saved' })
        @else
          <div class="rounded-[1.75rem] border border-white/50 bg-[#f5f2df]/92 p-12 text-center shadow-[0_20px_60px_rgba(17,62,20,0.18)] backdrop-blur-xl">
            <h2 class="text-3xl font-black text-[#113e14]">No saved posts yet</h2>
            <p class="mt-3 text-sm font-bold leading-6 text-[#416543]">
              Save community posts and they will appear here.
            </p>
            <a href="/community" class="mt-6 inline-flex rounded-full bg-[#113e14] px-6 py-3 text-sm font-black text-[#ebe3a7] transition hover:-translate-y-0.5 hover:bg-[#416543]">
              Explore community
            </a>
          </div>
        @end
      </div>
    </section>

    <aside class="hidden lg:block" data-community-sidebar>
      <div class="sticky top-28 space-y-4">
        <details open class="rounded-[1.5rem] border border-white/50 bg-[#f5f2df]/92 p-5 text-[#113e14] shadow-xl backdrop-blur-xl">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <h2 class="text-lg font-black">Your community</h2>
            <span class="text-xs font-bold text-[#416543]">private</span>
          </summary>
          <div class="mt-4 grid grid-cols-2 gap-3 text-center">
            <div class="rounded-2xl bg-[#a8b841]/16 p-4">
              <p class="text-2xl font-black" data-saved-total>{{ viewer.stats.saved }}</p>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#416543]">Saved</p>
            </div>
            <div class="rounded-2xl bg-[#dca15d]/16 p-4">
              <p class="text-2xl font-black">{{ viewer.stats.posts }}</p>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#416543]">Posts</p>
            </div>
          </div>
        </details>

        <details open class="rounded-[1.5rem] border border-white/50 bg-[#ebe3a7]/92 p-5 text-[#113e14] shadow-xl backdrop-blur-xl">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <h2 class="text-sm font-black">Suggestions</h2>
            <span class="text-xs font-bold text-[#416543]">new</span>
          </summary>
          <div class="mt-4 space-y-3">
            @each(user in suggestions)
              <a href="/users/{{ user.username }}" class="flex items-center gap-3 rounded-2xl bg-white/48 p-3 transition hover:-translate-y-0.5 hover:bg-white/80">
                @if(user.avatarUrl)
                  <img src="{{ user.avatarUrl }}" alt="" class="h-10 w-10 rounded-full object-cover">
                @else
                  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#113e14] text-sm font-black text-[#ebe3a7]">
                    {{ user.initial }}
                  </span>
                @endif
                <span class="min-w-0">
                  <span class="block truncate text-sm font-black">{{ user.displayName }}</span>
                  <span class="block truncate text-xs font-bold text-[#416543]">{{ user.roleLabel }} - {{ '@' + user.username }}{{ user.isPremium ? ' - Premium' : '' }}</span>
                </span>
              </a>
            @else
              <p class="text-xs font-semibold text-[#416543]">No suggestions right now.</p>
            @end
          </div>
        </details>
      </div>
    </aside>
  </main>
</div>

@end
