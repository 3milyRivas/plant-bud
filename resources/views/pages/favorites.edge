@layout()

@slot('title')
<title>Saved Posts</title>
@endslot

<div class="min-h-screen bg-[#6C8E6B] text-[#113E14]" data-community-page data-favorites-page>
  <header class="sticky top-0 z-40 px-4 py-4 lg:px-8">
    <div class="mx-auto flex max-w-[1180px] items-center gap-3 rounded-[2rem] border border-white/30 bg-white/24 px-4 py-3 shadow-[0_18px_55px_rgba(17,62,20,0.18)] backdrop-blur-2xl sm:rounded-full sm:px-5">
      <a href="/homepage" class="flex flex-none items-center gap-3">
        <span class="h-11 w-11 rounded-full bg-[#113E14] bg-[url('/resources/images/essential/logo.png')] bg-contain bg-center bg-no-repeat shadow-md"></span>
        <span class="hidden leading-tight md:block">
          <span class="block text-sm font-black text-[#113E14]">Plant Bud</span>
          <span class="block text-[11px] font-bold uppercase tracking-[0.18em] text-[#315F28]">Saved posts</span>
        </span>
      </a>

      <nav class="flex min-w-0 flex-1 items-center justify-center gap-2" aria-label="Community navigation">
        <a href="/community" class="h-10 w-10 rounded-xl bg-white/20 bg-[url('/resources/images/community/community.png')] bg-contain bg-center bg-no-repeat shadow-sm transition hover:-translate-y-0.5 hover:bg-[#EDE7D6]" aria-label="Community feed" title="Community"></a>
        <a href="/favorites" class="h-10 w-10 rounded-xl bg-[#EDE7D6] bg-[url('/resources/images/community/saved.png')] bg-contain bg-center bg-no-repeat shadow-md ring-2 ring-white/35 transition hover:-translate-y-0.5" aria-label="Saved posts" title="Saved posts"></a>
        <a href="/notification" class="h-10 w-10 rounded-xl bg-white/20 bg-[url('/resources/images/community/notifications.png')] bg-contain bg-center bg-no-repeat shadow-sm transition hover:-translate-y-0.5 hover:bg-[#EDE7D6]" aria-label="Notifications" title="Notifications"></a>
      </nav>

      <a href="/profile" class="flex flex-none items-center gap-2 rounded-full bg-white/18 py-1 pl-1 pr-3 transition hover:bg-white/28">
        @if(viewer.avatarUrl)
          <img src="{{ viewer.avatarUrl }}" alt="" class="h-10 w-10 rounded-full object-cover">
        @else
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#113E14] text-sm font-black text-[#EDE7D6]">{{ viewer.initial }}</span>
        @endif
        <span class="hidden text-sm font-black text-[#113E14] lg:block">Profile</span>
      </a>
    </div>
  </header>

  <main class="mx-auto grid max-w-[1180px] gap-6 px-4 pb-20 pt-6 lg:grid-cols-[1fr_19rem] lg:px-8">
    <section class="min-w-0 space-y-6">
      <div class="rounded-3xl border border-white/30 bg-white/24 p-6 shadow-xl backdrop-blur-xl">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-black/42">Private collection</p>
        <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
          <div>
            <h1 class="text-4xl font-black leading-tight text-black md:text-5xl">Saved posts</h1>
            <p class="mt-3 max-w-2xl text-sm font-bold leading-6 text-black/50">
              Posts you save live here only for your account.
            </p>
          </div>
          <a href="/community" class="rounded-full bg-[#113E14] px-5 py-2.5 text-sm font-black text-white shadow-md transition hover:-translate-y-0.5">Back to feed</a>
        </div>
      </div>

      <div class="space-y-5" data-community-feed>
        @each(post in posts)
          @!component('components/community-post-card', { post, viewer })
        @else
          <div class="rounded-3xl border border-white/30 bg-white/24 p-10 text-center shadow-xl backdrop-blur-xl">
            <h2 class="text-3xl font-black text-black">No saved posts yet</h2>
            <p class="mt-3 text-sm font-bold leading-6 text-black/50">
              Save community posts and they will appear here.
            </p>
            <a href="/community" class="mt-6 inline-flex rounded-full bg-[#113E14] px-6 py-3 text-sm font-black text-white transition hover:-translate-y-0.5 hover:bg-[#315F28]">
              Explore community
            </a>
          </div>
        @end
      </div>
    </section>

    <aside class="hidden lg:block">
      <div class="sticky top-28 space-y-4">
        <details open class="rounded-3xl border border-white/30 bg-white/22 p-4 text-black shadow-xl backdrop-blur-xl">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <h2 class="text-lg font-black">Your community</h2>
            <span class="text-xs font-bold text-black/42">private</span>
          </summary>
          <div class="mt-4 grid grid-cols-2 gap-3 text-center">
            <div class="rounded-2xl bg-white/30 p-4">
              <p class="text-2xl font-black" data-saved-total>{{ viewer.stats.saved }}</p>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-black/42">Saved</p>
            </div>
            <div class="rounded-2xl bg-white/30 p-4">
              <p class="text-2xl font-black">{{ viewer.stats.posts }}</p>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-black/42">Posts</p>
            </div>
          </div>
        </details>

        <details open class="rounded-3xl border border-white/30 bg-white/22 p-4 text-black shadow-xl backdrop-blur-xl">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <h2 class="text-sm font-black">Suggestions</h2>
            <span class="text-xs font-bold text-black/42">new</span>
          </summary>
          <div class="mt-4 space-y-3">
            @each(user in suggestions)
              <a href="/users/{{ user.username }}" class="flex items-center gap-3 rounded-2xl bg-white/20 p-3 transition hover:-translate-y-0.5 hover:bg-white/34">
                @if(user.avatarUrl)
                  <img src="{{ user.avatarUrl }}" alt="" class="h-10 w-10 rounded-full object-cover">
                @else
                  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#113E14] text-sm font-black text-[#EDE7D6]">
                    {{ user.initial }}
                  </span>
                @endif
                <span class="min-w-0">
                  <span class="block truncate text-sm font-black">{{ user.displayName }}</span>
                  <span class="block truncate text-xs font-bold text-black/42">{{ user.roleLabel }} - {{ '@' + user.username }}</span>
                </span>
              </a>
            @else
              <p class="text-xs font-semibold text-black/45">No suggestions right now.</p>
            @end
          </div>
        </details>
      </div>
    </aside>
  </main>
</div>

@end
