@layout()
@slot('title')
<title>Plant Bud - Maintenance</title>
@endslot

<div class="relative z-10 min-h-screen text-[#113E14]">
  <header class="relative overflow-hidden bg-[url('/resources/images/plant-budd.png')] bg-cover bg-center px-6 py-16 shadow-2xl">
    <div class="absolute inset-0 bg-gradient-to-r from-[#113E14]/82 via-[#113E14]/42 to-transparent"></div>
    <div class="relative mx-auto flex max-w-7xl flex-col gap-8 text-white lg:flex-row lg:items-center lg:justify-between">
      <a href="/homepage" class="flex items-center gap-4">
        <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/80 shadow-lg">
          <img src="/resources/images/essential/logo.png" alt="" class="h-12 w-12 object-contain">
        </span>
        <span>
          <span class="block text-2xl font-black">Plant Bud</span>
          <span class="block text-sm font-bold uppercase tracking-[0.18em] text-[#EDE7D6]">Maintenance</span>
        </span>
      </a>

      <nav class="flex flex-wrap gap-3">
        <a href="/homepage" class="rounded-full bg-white/14 px-5 py-2.5 text-sm font-black backdrop-blur-xl transition hover:bg-white/24">Home</a>
        <a href="/scanner" class="rounded-full bg-white/14 px-5 py-2.5 text-sm font-black backdrop-blur-xl transition hover:bg-white/24">Scanner</a>
        <a href="/designer" class="rounded-full bg-white/14 px-5 py-2.5 text-sm font-black backdrop-blur-xl transition hover:bg-white/24">Designer</a>
        <a href="/community" class="rounded-full bg-white/14 px-5 py-2.5 text-sm font-black backdrop-blur-xl transition hover:bg-white/24">Community</a>
      </nav>
    </div>

    <div class="relative mx-auto mt-16 max-w-7xl">
      <p class="text-sm font-black uppercase tracking-[0.22em] text-[#EDE7D6]">Find a gardener</p>
      <h1 class="mt-4 max-w-3xl font-abril text-5xl leading-tight text-white md:text-7xl">Reliable care for every green space.</h1>
      <p class="mt-5 max-w-2xl text-lg font-semibold leading-8 text-white/78">
        Browse trusted professionals, compare experience, and request support for maintenance, restoration, irrigation, and pruning.
      </p>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-6 py-12">
    <div class="mb-8 flex flex-col gap-4 rounded-[28px] border border-white/45 bg-white/28 p-5 shadow-xl backdrop-blur-2xl md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.18em] text-[#6B8C6C]">Available providers</p>
        <h2 class="mt-2 text-3xl font-black">Maintenance specialists</h2>
      </div>
      <a href="#gardeners" class="inline-flex rounded-full bg-[#113E14] px-6 py-3 text-sm font-black text-white shadow-md transition hover:-translate-y-0.5 hover:bg-[#1B5420]">
        Choose a gardener
      </a>
    </div>

    <section id="gardeners" class="grid gap-6">
      @each(gardener in gardeners)
        @!component('components/services/provider-card', {
          name: gardener.name,
          photo: gardener.photo,
          specialty: gardener.specialty,
          experience: gardener.experience,
          rating: gardener.rating,
          reviews: gardener.reviews,
          location: gardener.location,
          phone: gardener.phone,
          email: gardener.email,
          services: gardener.services,
          schedule: gardener.schedule,
          hours: gardener.hours,
          href: `/request/${gardener.id}`
        })
      @else
        <div class="rounded-[28px] border border-white/45 bg-white/78 p-8 text-center shadow-xl backdrop-blur-2xl">
          <h2 class="text-2xl font-black">No gardeners available yet</h2>
          <p class="mt-2 text-sm font-semibold text-[#456143]">Run the gardener seed to fill this catalog.</p>
        </div>
      @end
    </section>
  </main>
</div>
@end
