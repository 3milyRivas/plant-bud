            <div class="flex items-center gap-4">

                <img src="resources/images/essential/logo.png"
                    class="w-14 hover:rotate-6 transition duration-500"
                    alt="">

                <h1 class="text-2xl font-black tracking-wide">
                    Plant
                    <span class="text-[#EDE7D6]">
                        Bud
                    </span>
                </h1>

            </div>

            <div class="hidden md:flex items-center gap-10 font-semibold text-white/90">

                <a href="#about"
                    class="hover:text-[#EDE7D6] transition">
                    About
                </a>

                <a href="#benefits"
                    class="hover:text-[#EDE7D6] transition">
                    Benefits
                </a>

                <a href="#values"
                    class="hover:text-[#EDE7D6] transition">
                    Values
                </a>

                <a href="#purpose"
                    class="hover:text-[#EDE7D6] transition">
                    Purpose
                </a>

            </div>

            <div class="flex items-center gap-4">

                <a href="/login"
                    class="hidden sm:flex font-semibold hover:text-[#EDE7D6] transition">
                    Login
                </a>

                <a href="/register"
                    class="bg-[#EDE7D6] text-[#1E3D19] font-black px-6 py-3 rounded-full hover:scale-105 transition-all duration-300 shadow-lg">
                    Get Started
                </a>

            </div>

        </div>

    </header>

    <!-- ================= HERO ================= -->

    <section
