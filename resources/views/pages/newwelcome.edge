                        Start Now

                        <svg class="w-5 h-5 group-hover:translate-x-1 transition"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            viewBox="0 0 24 24">

                            <path d="M5 12h14"></path>
                            <path d="M13 5l7 7-7 7"></path>

                        </svg>

                    </a>

                </div>

            </div>

            <!-- RIGHT -->

