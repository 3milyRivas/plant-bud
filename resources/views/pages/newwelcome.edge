                    <div class="w-2 h-2 bg-[#EDE7D6] rounded-full animate-ping">
                    </div>

                    <span class="tracking-wide font-medium">
                        Green Spaces Start Here
                    </span>

                </div>

                <h1
                    class="text-6xl md:text-7xl xl:text-[95px] font-black leading-[0.95] drop-shadow-2xl animate-slideUp">

                    Grow Your

                    <span class="text-[#EDE7D6]">
