        </a>
      </div>
    </div>
  </header>

  <section class="relative flex min-h-[88svh] items-center overflow-hidden px-5 pb-24 pt-36 sm:px-6 lg:px-10 lg:pt-40">
    <img decoding="async" src="/resources/images/welcome/header3.png" class="absolute inset-0 h-full w-full object-cover" alt="">
    <div class="absolute inset-0 bg-[#0A210D]/55"></div>
    <div class="absolute inset-0"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[#416543] to-transparent"></div>

    <div class="relative z-10 mx-auto grid max-w-7xl gap-14 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div class="max-w-3xl text-center lg:text-left">
        <div class="mb-7 inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/10 px-5 py-3 shadow-xl backdrop-blur-xl">
          <span class="welcome-signal h-2.5 w-2.5 rounded-full bg-[#a8b841] shadow-[0_0_16px_rgba(168,184,65,0.58)]"></span>
          <span class="text-xs font-black uppercase tracking-[0.24em] text-white/80">Green spaces start here</span>
        </div>

        <h1 class="text-balance text-5xl font-black leading-[0.97] drop-shadow-2xl sm:text-6xl md:text-7xl xl:text-[92px]">
          Grow Your <span class="welcome-gradient-text">Plants</span><br>
          Live a <span class="text-[#ebe3a7]">Better Life</span>
        </h1>

        <p class="mx-auto mt-8 max-w-2xl text-lg font-semibold leading-8 text-white/84 sm:text-xl lg:mx-0">
