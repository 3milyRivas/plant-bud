                        Now
                        <svg class="w-5 h-5 group-hover:translate-x-1 transition" fill="none" stroke="currentColor"
                            stroke-width="2" viewBox="0 0 24 24">
                            <path d="M5 12h14"></path>
                            <path d="M13 5l7 7-7 7"></path>
                        </svg>
                    </a>
                </div>
            </div>
            <div class="relative flex justify-center">
                <div class="absolute w-[450px] h-[450px] bg-[#EDE7D6]/15 rounded-full blur-3xl animate-pulse"></div>
                <img src="resources/images/essential/logo.png"
                    class="relative w-[320px] md:w-[420px] animate-float drop-shadow-[0_25px_60px_rgba(0,0,0,0.45)]"
                    alt="">
            </div>
        </div>
    </section>

    <main class="relative overflow-hidden">
        <div class="absolute top-40 left-0 w-96 h-96 bg-[#EDE7D6]/10 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute top-[1100px] right-0 w-[30rem] h-[30rem] bg-white/5 rounded-full blur-3xl animate-pulse">
        </div>
        <div
            class="absolute bottom-40 left-1/2 -translate-x-1/2 w-[40rem] h-[40rem] bg-[#1E3D19]/10 rounded-full blur-3xl">
        </div>

        <section class="relative py-32 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="text-center max-w-4xl mx-auto mb-20">
                    <h2 class="mt-8 text-5xl md:text-7xl font-black text-white leading-tight drop-shadow-xl">Grow <span
                            class="text-[#1E3D19]">Plants</span><br>for a <span class="text-[#EDE7D6]">Better
                            Life</span></h2>
                    <div class="w-32 h-1 bg-[#EDE7D6] rounded-full mx-auto mt-8"></div>
                </div>

                <div class="relative group">
                    <div class="absolute -inset-2 bg-white/10 blur-2xl rounded-[3rem] opacity-70"></div>
                    <div
                        class="relative bg-white/10 backdrop-blur-2xl border border-white/10 rounded-[3rem] p-8 md:p-12 lg:p-16 shadow-[0_30px_80px_rgba(0,0,0,0.25)] overflow-hidden hover:-translate-y-2 transition duration-500">
                        <div class="absolute -top-16 -right-16 w-64 h-64 bg-[#EDE7D6]/15 rounded-full blur-3xl"></div>
                        <div class="absolute -bottom-16 -left-16 w-64 h-64 bg-[#1E3D19]/20 rounded-full blur-3xl"></div>
                        <div
                            class="relative grid lg:grid-cols-[220px_1fr] gap-10 items-center hover:-translate-y-2 transition duration-500">
                            <div class="flex justify-center">
                                <div
                                    class="w-44 h-44 rounded-[2.5rem] bg-[#D5DCD4] shadow-2xl flex items-center justify-center rotate-3 group-hover:rotate-6 transition duration-500">
                                    <img src="resources/images/welcome/first-icon.png" class="w-36 drop-shadow-lg"
                                        alt="">
                                </div>
                            </div>
                            <div>
                                <h3 class="text-4xl md:text-5xl font-black text-white leading-tight">What is <span
                                        class="text-[#EDE7D6]">Plant Bud?</span></h3>
                                <div class="w-20 h-1 bg-[#EDE7D6] rounded-full mt-6 mb-6"></div>
                                <p class="text-white/85 text-lg md:text-xl leading-relaxed font-semibold max-w-3xl">
                                    <span class="text-[#EDE7D6]">Plant Bud</span> is a web site where you can learn
                                    about <span class="text-[#EDE7D6]">plant care</span> and access <span
                                        class="text-[#EDE7D6]">professional gardening services</span>. Our goal is to
                                    encourage you to grow plants at home or at work, making every space more <span
                                        class="text-[#EDE7D6]">beautiful and healthy</span>.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="relative py-32 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="text-center max-w-4xl mx-auto mb-20">
                    <h2 class="mt-8 text-5xl md:text-7xl font-black text-white leading-tight">Benefits Plant Bud <span
                            class="text-[#1E3D19]">Offers You</span></h2>
                    <div class="w-32 h-1 bg-[#EDE7D6] rounded-full mx-auto mt-8"></div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-6">
                    @each(benefit in [
                    { image: 'benefit1.png', title: 'Easy Access', subtitle: 'to Quality Information' },
                    { image: 'benefit2.png', title: 'Access', subtitle: 'to Professional Services' },
                    { image: 'benefit3.png', title: 'Save Time', subtitle: 'by Contacting Gardeners' },
                    { image: 'benefit4.png', title: 'Contact', subtitle: 'with Plant Stores' },
                    { image: 'benefit5.png', title: 'Connection', subtitle: 'with Other People' }
                    ])
                    <div class="relative group">
                        <div class="absolute -inset-1 bg-white/10 blur-xl rounded-[2rem] opacity-70"></div>
                        <div
                            class="relative h-full bg-[#D5DCD4]/95 backdrop-blur-xl rounded-[2rem] p-6 shadow-2xl border border-white/40 text-center flex flex-col items-center justify-center hover:-translate-y-3 hover:scale-[1.02] transition duration-500">
                            <div
                                class="w-20 h-20 rounded-3xl bg-white shadow-lg flex items-center justify-center mb-5 group-hover:rotate-6 transition duration-500">
                                <img src="resources/images/welcome/{{ benefit.image }}" class="w-12" alt="">
                            </div>
                            <p class="text-lg font-black text-[#1E3D19] leading-snug">{{ benefit.title }}<span
                                    class="block text-[#728B6F] font-bold mt-1">{{ benefit.subtitle }}</span></p>
                        </div>
                    </div>
                    @endeach
                </div>
            </div>
        </section>

        <section class="relative py-10 px-6">
            <div class="max-w-6xl mx-auto flex items-center gap-6">
                <div class="flex-1 h-px bg-gradient-to-r from-transparent via-white/20 to-white/60"></div>
                <div
                    class="w-16 h-16 rounded-full bg-white/10 backdrop-blur-xl border border-white/10 flex items-center justify-center shadow-xl">
                    <img src="resources/images/essential/logo.png" class="w-8 opacity-90" alt="">
                </div>
                <div class="flex-1 h-px bg-gradient-to-r from-white/60 via-white/20 to-transparent"></div>
            </div>
        </section>

        <section class="relative py-32 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="text-center mb-20">
                    <h2 class="mt-8 text-5xl md:text-7xl font-black text-white">Values</h2>
                    <div class="w-32 h-1 bg-[#EDE7D6] rounded-full mx-auto mt-8"></div>
                </div>
                <div class="relative max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        @each(value in [
                        { image: 'value1.png', name: 'Empathy' },
                        { image: 'value2.png', name: 'Responsability' },
                        { image: 'value3.png', name: 'Sustainability' },
                        { image: 'value4.png', name: 'Passion' }
                        ])
                        <div class="relative group">
                            <div class="absolute -inset-1 bg-[#EDE7D6]/10 rounded-full blur-3xl"></div>
                            <div
                                class="relative bg-white/10 backdrop-blur-md border border-white/10 p-8 rounded-[2rem] p-8 md:p-10 text-center shadow-2xl hover:-translate-y-2 transition duration-500">
                                <div
                                    class="w-20 h-20 rounded-3xl bg-[#EDE7D6]/10 shadow-lg flex items-center justify-center mx-auto mb-5 group-hover:scale-110 group-hover:rotate-6 transition duration-500">
                                    <img src="resources/images/welcome/{{ value.image }}" class="w-12" alt="">
                                </div>
                                <p class="text-white text-2xl font-black tracking-wide">{{ value.name }}</p>
                            </div>
                        </div>
                        @endeach
                    </div>
                    <div class="hidden xl:flex absolute inset-0 items-center justify-center pointer-events-none">
                        <div
                            class="w-44 h-44 rounded-full bg-white/10 backdrop-blur-2xl border border-white/10 shadow-[0_20px_60px_rgba(0,0,0,0.35)] flex items-center justify-center animate-float">
                            <img src="resources/images/essential/logo.png" class="w-24" alt="">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="relative py-32 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="text-center mb-20">
                    <h2 class="mt-8 text-5xl md:text-7xl font-black text-white leading-tight">Mission and <span
                            class="text-[#EDE7D6]">Vision</span></h2>
                    <div class="w-32 h-1 bg-[#EDE7D6] rounded-full mx-auto mt-8"></div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-5xl mx-auto">
                        @each(card in [
                        { image: 'mission.png', title: 'Mission', text: 'To provide a tool where people can receive advice on plant care and promote a lifestyle that connects sustainability and botany.' },
                        { image: 'vision.png', title: 'Vision', text: 'Inspiring the community with natural beauty, integrating green spaces into their homes, and contributing to personal well-being and environmental sustainability.' }
                        ])
                    <div class="relative group h-full">
                        <div
                            class="absolute -inset-1.5 bg-white/20 blur-2xl rounded-[2.75rem] opacity-70 group-hover:opacity-100 transition duration-500">
                        </div>

                        <div
                            class="relative h-full bg-[#D5DCD4]/95 backdrop-blur-2xl border border-white/60 rounded-[2.75rem] px-8 py-9 shadow-[0_22px_70px_rgba(0,0,0,0.14)] overflow-hidden hover:-translate-y-2 hover:scale-[1.01] hover:shadow-[0_32px_90px_rgba(0,0,0,0.18)] transition-all duration-500">
                            <div class="absolute -top-12 -right-12 w-36 h-36 bg-white/35 rounded-full blur-3xl"></div>
                            <div class="absolute -bottom-12 -left-12 w-36 h-36 bg-[#1E3D19]/8 rounded-full blur-3xl">
                            </div>
                            <div
                                class="absolute inset-0 rounded-[2.75rem] bg-gradient-to-br from-white/25 via-transparent to-white/5 pointer-events-none">
                            </div>
                            <div class="relative z-10 flex flex-col items-center text-center">
                                <div
                                    class="relative w-20 h-20 rounded-[1.75rem] bg-white border border-white/80 shadow-[0_14px_35px_rgba(0,0,0,0.10)] flex items-center justify-center mb-6 group-hover:scale-110 group-hover:rotate-3 transition duration-500">
                                    <div
                                        class="absolute inset-0 rounded-[1.75rem] bg-gradient-to-br from-white to-[#F8F6EF]">
                                    </div>
                                    <img src="resources/images/welcome/{{ card.image }}"
                                        class="relative z-10 w-11 drop-shadow-sm" alt="">
                                </div>
                                <h3 class="text-3xl md:text-4xl font-black text-[#1E3D19] tracking-tight">
                                    {{ card.title }}
                                </h3>
                                <div
                                    class="w-14 h-1 bg-gradient-to-r from-transparent via-[#728B6F] to-transparent rounded-full my-5 group-hover:w-20 transition-all duration-500">
                                </div>
                                <p
                                    class="text-[#2F3E2D]/80 text-base md:text-lg font-semibold leading-relaxed max-w-sm">
                                    {{ card.text }}
                                </p>
                            </div>
                        </div>
                    </div>
                    @endeach
                </div>
