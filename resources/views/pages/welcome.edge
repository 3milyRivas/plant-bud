@layout()
@slot('title')
<title>Plant Bud</title>
@endslot

<div class="relative z-10">
    <header class="fixed top-0 left-0 w-full z-50 px-6 lg:px-10 py-6">
        <div
            class="max-w-7xl mx-auto bg-white/10 backdrop-blur-xl border border-white/10 rounded-full px-6 py-4 flex items-center justify-between shadow-[0_10px_40px_rgba(0,0,0,0.15)]">
            <div class="flex items-center gap-4">
                <img src="resources/images/essential/logo.png" class="w-14 hover:rotate-6 transition duration-500"
                    alt="">
                <h1 class="text-2xl font-black text-white tracking-wide">Plant<span class="text-[#EDE7D6]"> Bud</span>
                </h1>
            </div>

            <div class="hidden md:flex items-center justify-center flex-1 px-8">
                <div class="relative max-w-2xl w-full">
                    <div
                        class="absolute -inset-2 bg-gradient-to-r from-transparent via-[#EDE7D6]/12 to-transparent blur-3xl rounded-full opacity-90">
                    </div>
                    <div
                        class="relative px-7 py-3.5 rounded-full bg-white/[0.08] backdrop-blur-2xl border border-white/10 shadow-[0_18px_45px_rgba(0,0,0,0.18)] overflow-hidden">
                        <div
                            class="absolute inset-0 rounded-full bg-gradient-to-r from-white/[0.02] via-white/[0.12] to-white/[0.02]">
                        </div>
                        <div
                            class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent">
                        </div>
                        <div
                            class="absolute left-5 top-1/2 -translate-y-1/2 flex items-center justify-center w-7 h-7 rounded-full bg-[#EDE7D6]/15 border border-[#EDE7D6]/20 shadow-[0_0_20px_rgba(237,231,214,0.15)]">
                            <div
                                class="w-2 h-2 rounded-full bg-[#EDE7D6] shadow-[0_0_10px_rgba(237,231,214,0.7)] animate-pulse">
                            </div>
                        </div>
                        <p class="relative pl-10 pr-2 text-sm font-semibold text-center leading-tight">
                            <span class="text-white/55 font-black tracking-[0.14em] mr-2">
                                TIP
                            </span>
                            <span id="plant-tip"
                                class="text-[#EDE7D6] font-bold tracking-[0.02em] [text-shadow:0_0_8px_rgba(255,255,255,0.06)]">
                                Loading tip...
                            </span>
                        </p>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <a href="/login"
                    class="hidden sm:flex text-white font-semibold hover:text-[#EDE7D6] transition">Login</a>
                <a href="/register"
                    class="bg-[#EDE7D6] text-[#1E3D19] font-black px-6 py-3 rounded-full hover:scale-105 transition-all duration-300 shadow-lg">
                    Get Started
                </a>
            </div>
        </div>
    </header>

    <section class="relative min-h-screen flex items-center overflow-hidden pt-40 pb-24 px-6">
        <img src="resources/images/welcome/header3.png" class="absolute inset-0 w-full h-full object-cover" alt="">
        <div class="absolute inset-0 bg-black/45"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-[#1E3D19]/30 via-[#728B6F]/30 to-[#6B8C6C]"></div>
        <div class="relative z-20 max-w-7xl mx-auto grid lg:grid-cols-2 gap-20 items-center">
            <div class="text-center lg:text-left">
                <div
                    class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-white/10 backdrop-blur-md border border-white/10 shadow-xl mb-8">
                    <div class="w-2 h-2 bg-[#EDE7D6] rounded-full animate-ping"></div>
                    <span class="tracking-wide text-white font-medium">Green Spaces Start Here</span>
                </div>
                <h1
                    class="text-6xl md:text-7xl xl:text-[95px] font-black text-white leading-[0.95] drop-shadow-2xl animate-slideUp">
                    Grow Your<span class="text-[#EDE7D6]"> Plants</span><br>Live a<span
                        class="text-[#1E3D19] drop-shadow-[0_0_8px_rgba(255,255,255,0.30)] [text-shadow:0_0_8px_rgba(255,255,255,0.65),0_0_16px_rgba(255,255,255,0.25)]">
                        Better
                        Life</span></h1>
                <div class="w-40 h-[5px] bg-[#EDE7D6] rounded-full mt-10 mx-auto lg:mx-0 animate-expand"></div>
                <p class="mt-10 text-white/85 text-xl leading-relaxed max-w-2xl">Learn how to care for your plants,
                    discover gardening professionals, and create healthier environments filled with nature.</p>
                <div class="mt-12 flex flex-wrap gap-5 justify-center lg:justify-start">
                    <a href="/register"
