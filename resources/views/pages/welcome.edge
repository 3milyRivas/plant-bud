                </div>
                <div
                    class="relative bg-white/10 backdrop-blur-3xl border border-white/10 rounded-[4rem] px-8 py-10 md:px-14 md:py-14 text-center shadow-[0_30px_100px_rgba(0,0,0,0.28)] overflow-hidden hover:-translate-y-1 hover:shadow-[0_40px_120px_rgba(0,0,0,0.34)] transition-all duration-700">
                    <div
                        class="absolute top-0 left-1/2 -translate-x-1/2 w-72 h-72 bg-[#EDE7D6]/10 rounded-full blur-3xl animate-pulse">
                    </div>
                    <div class="absolute -bottom-16 -left-16 w-48 h-48 bg-[#1E3D19]/10 rounded-full blur-3xl"></div>
                    <div class="absolute -top-12 -right-12 w-40 h-40 bg-white/5 rounded-full blur-3xl"></div>
                    <div
                        class="absolute inset-0 rounded-[4rem] bg-gradient-to-br from-white/15 via-transparent to-[#EDE7D6]/5 pointer-events-none">
                    </div>
                    <div
                        class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent">
                    </div>
                    <div class="relative z-10">
                        <h2
                            class="text-5xl md:text-7xl font-black text-white leading-tight drop-shadow-[0_8px_20px_rgba(0,0,0,0.25)]">
                            What Are <span class="text-[#1E3D19]">You</span> Waiting For?</h2>
                        <div
                            class="w-28 h-1 bg-[#EDE7D6] rounded-full mx-auto my-8 shadow-[0_0_16px_rgba(255,255,255,0.2)] group-hover:w-36 transition-all duration-500">
                        </div>
                        <p class="text-white/90 text-lg md:text-xl leading-relaxed max-w-3xl mx-auto font-semibold">
                            Start improving your plant care experience today and connect with a greener lifestyle in a
                            simple and meaningful way.</p>
                        <div class="mt-10">
                            <h3 class="text-3xl md:text-4xl font-bold text-white/95">Choose to Be</h3>
                            <h4 class="mt-2 text-4xl md:text-6xl font-black text-white leading-tight">The <span
                                    class="text-[#1E3D19] [text-shadow:0_0_4px_rgba(255,255,255,0.3),0_0_12px_rgba(255,255,255,0.1)]">Plant's
                                    Best Bud</span></h4>
                        </div>
                        <div class="mt-12">
                            <a href="/register"
                                class="group/btn inline-flex items-center gap-3 bg-[#EDE7D6] text-[#1E3D19] font-black px-10 py-5 rounded-full shadow-[0_15px_40px_rgba(0,0,0,0.25)] hover:-translate-y-1 hover:scale-105 active:scale-100 hover:shadow-[0_22px_55px_rgba(0,0,0,0.3)] transition-all duration-300">
                                Start Now
                                <svg class="w-5 h-5 group-hover/btn:translate-x-1 transition-transform duration-300"
                                    fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M5 12h14"></path>
                                    <path d="M13 5l7 7-7 7"></path>
                                </svg>
                            </a>
                        </div>
                    </div>
