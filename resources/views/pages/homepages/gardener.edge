@layout()
@slot('title')
<title>Plant Bud - Home</title>
@endslot
@vite(['resources/js/tips.js'])

<div class="relative z-10 min-h-dvh overflow-hidden text-[#113e14]">
  @!component('components/homepage-navbar', {
    avatarUrl: homepageProfile.avatarUrl,
    avatarInitial: homepageProfile.avatarInitial,
    displayName: homepageProfile.displayName,
    roleLabel: 'Gardener'
  })

  <main class="relative z-10 mx-auto max-w-7xl px-5 pb-24 pt-8 lg:px-10">
    <section class="grid gap-14 py-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-center lg:py-16">
      <div class="homepage-soft-pop text-white">
        <div class="mb-8 flex items-center gap-3">
          <span class="h-px w-12 bg-white/55"></span>
          <span class="text-sm font-semibold uppercase tracking-[0.3em] text-[#ebe3a7]/82">Professional care</span>
        </div>

        <h1 class="font-abril text-5xl leading-[1.02] text-white drop-shadow-lg lg:text-7xl">
          Grow your service day with less friction.
        </h1>

        <p class="mt-7 max-w-xl text-lg font-medium leading-loose text-white/78">
          {{ gardenerProfile?.headline || 'Manage requests, scan plant issues, plan garden ideas, and build trust through your work.' }}
        </p>

        <div class="mt-8 max-w-xl rounded-[26px] border border-white/15 bg-white/10 p-4 shadow-[0_18px_55px_rgba(0,0,0,0.16)] backdrop-blur-2xl">
          <div class="flex gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[#ebe3a7] text-xs font-black uppercase tracking-[0.16em] text-[#113e14]">
              Tip
            </span>
            <p id="plant-tip" class="self-center text-sm font-bold leading-6 text-[#ebe3a7] sm:text-base">
              Loading tip...
            </p>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#tools" class="rounded-full bg-[#dca15d] px-8 py-4 text-sm font-black text-[#113e14] shadow-xl transition hover:-translate-y-1 hover:scale-[1.03]">
            Open tools
          </a>
          <a href="/requested" class="rounded-full border border-white/30 bg-white/12 px-8 py-4 text-sm font-black text-white shadow-lg backdrop-blur-xl transition hover:-translate-y-1 hover:bg-white/20">
            Review requests
          </a>
        </div>
      </div>

      <div class="relative homepage-soft-pop" style="animation-delay: 90ms">
        <img src="/resources/images/homepagee/gardener-header.jpg" alt="" class="homepage-hero-media h-[620px] w-full rounded-[42px] object-cover shadow-2xl">

        <a href="/profile/settings" class="homepage-lively-card absolute -bottom-8 left-6 right-6 rounded-[30px] border border-[#ebe3a7]/60 bg-[#ebe3a7]/88 p-6 shadow-2xl backdrop-blur-2xl sm:left-10 sm:right-auto sm:w-[370px]">
          <div class="flex items-center gap-4">
            <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-[#a8b841]/24">
              <img src="/resources/images/homepagee/hand.png" alt="" class="homepage-lively-icon h-11 w-11 object-contain">
            </span>
            <span>
              <span class="block text-lg font-black">{{ gardenerProfile?.isAvailable ? 'Available for clients' : 'Availability paused' }}</span>
              <span class="mt-1 block text-sm font-semibold leading-5 text-[#416543]">Keep your public profile ready for new jobs.</span>
            </span>
          </div>
        </a>
      </div>
    </section>

    <section id="tools" class="scroll-mt-28 pt-16">
      <div class="mx-auto mb-10 max-w-3xl text-center text-white">
        <p class="text-sm font-black uppercase tracking-[0.24em] text-[#ebe3a7]">Main tools</p>
        <h2 class="mt-3 font-abril text-5xl leading-tight md:text-6xl">Work smarter in the field</h2>
      </div>

      <div class="grid gap-8 lg:grid-cols-3">
        <a href="/scanner" class="homepage-lively-card rounded-[34px] border border-[#ebe3a7]/48 bg-[#ebe3a7]/82 p-8 shadow-xl backdrop-blur-2xl">
          <img src="/resources/images/homepagee/scanner.png" alt="" class="homepage-lively-icon h-16 w-16 object-contain">
          <p class="mt-8 text-sm font-black uppercase tracking-[0.18em] text-[#416543]">Scanner</p>
          <h3 class="mt-3 text-3xl font-black">Diagnose before you visit</h3>
          <p class="mt-4 leading-relaxed text-[#416543]">Use scans to explain symptoms, needs, and next steps with more confidence.</p>
        </a>

        <a href="/designer" class="homepage-lively-card rounded-[34px] border border-[#ebe3a7]/48 bg-[#ebe3a7]/82 p-8 shadow-xl backdrop-blur-2xl">
          <img src="/resources/images/homepagee/tulip.png" alt="" class="homepage-lively-icon h-16 w-16 object-contain">
          <p class="mt-8 text-sm font-black uppercase tracking-[0.18em] text-[#416543]">Designer</p>
          <h3 class="mt-3 text-3xl font-black">Present garden ideas</h3>
          <p class="mt-4 leading-relaxed text-[#416543]">Sketch layouts clients can understand before the work begins.</p>
        </a>

        <a href="/community" class="homepage-lively-card rounded-[34px] border border-[#ebe3a7]/48 bg-[#ebe3a7]/82 p-8 shadow-xl backdrop-blur-2xl">
          <img src="/resources/images/homepagee/comunity.png" alt="" class="homepage-lively-icon h-16 w-16 object-contain">
          <p class="mt-8 text-sm font-black uppercase tracking-[0.18em] text-[#416543]">Community</p>
          <h3 class="mt-3 text-3xl font-black">Show visible progress</h3>
          <p class="mt-4 leading-relaxed text-[#416543]">Turn before-and-after work into credibility and future requests.</p>
        </a>
      </div>
    </section>

    <section class="pt-24">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
          <div class="homepage-lively-card rounded-[28px] border border-[#ebe3a7]/48 bg-[#ebe3a7]/90 p-6 shadow-xl backdrop-blur-2xl">
            <p class="text-sm font-black uppercase tracking-[0.16em] text-[#416543]">Rating</p>
            <p class="mt-3 text-4xl font-black">{{ gardenerProfile?.ratingAverage || 0 }}</p>
            <p class="mt-2 text-sm font-bold text-[#416543]">{{ gardenerProfile?.ratingCount || 0 }} reviews</p>
          </div>
          <div class="homepage-lively-card rounded-[28px] border border-[#ebe3a7]/48 bg-[#ebe3a7]/82 p-6 shadow-xl backdrop-blur-2xl">
            <p class="text-sm font-black uppercase tracking-[0.16em] text-[#416543]">Area</p>
            <p class="mt-3 truncate text-3xl font-black">{{ gardenerProfile?.serviceArea || 'Pending' }}</p>
            <p class="mt-2 text-sm font-bold text-[#416543]">Public service zone</p>
          </div>
          <div class="homepage-lively-card rounded-[28px] border border-[#ebe3a7]/48 bg-[#ebe3a7]/82 p-6 shadow-xl backdrop-blur-2xl sm:col-span-2 lg:col-span-1">
            <p class="text-sm font-black uppercase tracking-[0.16em] text-[#416543]">Experience</p>
            <p class="mt-3 text-3xl font-black">{{ gardenerProfile?.experienceYears || 0 }} yrs</p>
            <p class="mt-2 text-sm font-bold text-[#416543]">Profile signal</p>
          </div>
        </div>

        <div class="rounded-[42px] bg-[#113e14] p-8 text-white shadow-2xl sm:p-10">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <span class="text-sm font-black uppercase tracking-[0.2em] text-[#ebe3a7]">Work board</span>
              <h2 class="mt-3 font-abril text-5xl leading-tight">Next useful moves</h2>
            </div>
            <a href="/gardener/dashboard" class="rounded-full bg-[#dca15d] px-6 py-3 text-sm font-black text-[#113e14] transition hover:-translate-y-1 hover:scale-[1.03] hover:bg-[#ebe3a7]">
              Dashboard
            </a>
          </div>

          <div class="mt-8 grid gap-4 md:grid-cols-3">
            <a href="/profile/settings" class="homepage-lively-card rounded-2xl bg-white/10 p-5">
              <p class="font-black">Polish profile</p>
              <p class="mt-2 text-sm font-semibold leading-6 text-white/70">Photo, headline, area, and contact details.</p>
            </a>
            <a href="/requested" class="homepage-lively-card rounded-2xl bg-white/10 p-5">
              <p class="font-black">Review requests</p>
              <p class="mt-2 text-sm font-semibold leading-6 text-white/70">Keep service conversations moving.</p>
            </a>
            <a href="/community" class="homepage-lively-card rounded-2xl bg-white/10 p-5">
              <p class="font-black">Publish progress</p>
              <p class="mt-2 text-sm font-semibold leading-6 text-white/70">Visible work becomes trust.</p>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="pt-24">
      <div class="homepage-lively-card grid overflow-hidden rounded-[42px] border border-[#ebe3a7]/48 bg-[#ebe3a7]/82 shadow-xl backdrop-blur-2xl lg:grid-cols-[0.9fr_1.1fr]">
        <img src="/resources/images/homepagee/jardines.jpg" alt="" class="h-full min-h-80 w-full object-cover">
        <div class="p-8 sm:p-10">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-[#416543]">Profile presence</p>
          <h2 class="mt-4 font-abril text-5xl leading-tight">Your profile is your storefront.</h2>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[#416543]">
            Clients need to understand your style, service area, and reliability before requesting work.
          </p>
          <a href="/profile" class="mt-8 inline-flex rounded-full bg-[#113e14] px-7 py-3 text-sm font-black text-[#ebe3a7] transition hover:-translate-y-1 hover:bg-[#416543]">
            View profile
          </a>
        </div>
      </div>
    </section>
  </main>
</div>
@end
