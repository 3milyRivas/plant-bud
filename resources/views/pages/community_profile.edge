  <main class="mx-auto max-w-6xl px-5 pb-20 lg:px-10">
    <section class="isolate overflow-hidden rounded-[2.5rem] border border-white/10 bg-white/10 shadow-[0_30px_90px_rgba(0,0,0,0.22)] backdrop-blur-3xl">
      <div class="relative h-52 overflow-hidden sm:h-64 lg:h-72">
        @if(profileUser.bannerUrl)
          <img src="{{ profileUser.bannerUrl }}" alt="" class="absolute inset-0 h-full w-full object-cover">
        @else
          <div class="absolute inset-0 bg-gradient-to-br from-[#113e14] via-[#416543] to-[#416543]"></div>
