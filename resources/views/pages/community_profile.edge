                <div class="flex flex-wrap gap-2">
                  @each(star in publicRoleDetails.ratingStars)
                    <label class="cursor-pointer">
                      <input type="radio" name="rating" value="{{ star }}" class="peer sr-only" {{ star === 5 ? 'checked' : '' }}>
                      <span class="block rounded-full bg-[#416543]/10 px-3 py-2 text-sm font-black text-[#113e14] transition peer-checked:bg-[#dca15d] peer-checked:text-[#113e14]">{{ star }}</span>
