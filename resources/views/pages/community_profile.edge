          <div class="relative h-32 w-32 sm:h-40 sm:w-40">
            <div class="absolute -inset-1 rounded-full bg-[#ebe3a7] shadow-[0_18px_55px_rgba(0,0,0,0.28)]"></div>
            @if(profileUser.avatarUrl)
              <img src="{{ profileUser.avatarUrl }}" alt="" class="relative h-full w-full rounded-full border-4 border-white object-cover">
