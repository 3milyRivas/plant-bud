              </div>
              <div class="text-right">
                <div class="flex gap-1 text-xl">
                  @each(star in publicRoleDetails.ratingStars)
                    <span class="{{ star <= publicRoleDetails.rating.average ? 'text-[#dca15d]' : 'text-[#416543]/25' }}">★</span>
                  @end
                </div>
                <p class="mt-1 text-xs font-bold text-[#416543]">{{ publicRoleDetails.rating.count }} reviews</p>
