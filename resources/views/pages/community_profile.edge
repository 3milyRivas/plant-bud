              <span class="rounded-full bg-[#ebe3a7] px-3 py-1.5 text-xs font-black uppercase tracking-[0.16em] text-[#113e14]">
                {{ profileUser.roleLabel }}
              </span>
              @if(!isOwnProfile)
                <span class="{{ isFriend ? '' : 'hidden' }} rounded-full border border-[#ebe3a7]/50 bg-white/16 px-3 py-1.5 text-xs font-black uppercase tracking-[0.16em] text-[#ebe3a7] shadow-lg backdrop-blur-xl" data-friend-badge>
