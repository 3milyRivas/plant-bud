                  @end
                </div>
                <textarea name="comment" maxlength="500" rows="3" placeholder="Share a short review..." class="w-full resize-none rounded-2xl border border-white/10 bg-white/90 px-4 py-3 text-sm font-bold text-[#113e14] outline-none"></textarea>
                <button type="submit" class="rounded-full bg-[#dca15d] px-5 py-2 text-sm font-black text-[#113e14] transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]">Send review</button>
