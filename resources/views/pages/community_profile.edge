@layout()

@slot('title')
<title>{{ '@' + profileUser.username }}</title>
@endslot

<div class="relative z-10 min-h-dvh overflow-hidden text-[#1E3D19]" data-community-page>
  <div class="fixed inset-0 -z-10 pointer-events-none">
    <img src="/resources/images/welcome/header3.png" alt="" class="h-full w-full object-cover opacity-25">
    <div class="absolute inset-0 bg-gradient-to-b from-[#1E3D19]/85 via-[#6B8C6C]/88 to-[#728B6F]"></div>
  </div>

  <header class="relative z-30 px-5 pt-5 lg:px-10">
    <div class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-white/10 bg-white/10 px-5 py-4 shadow-[0_18px_55px_rgba(0,0,0,0.18)] backdrop-blur-2xl">
      <a href="/community" class="flex items-center gap-3">
        <img src="/resources/images/essential/logo.png" alt="" class="h-11 w-11 object-contain drop-shadow-lg">
        <span class="hidden text-xl font-black text-white sm:block">Community</span>
      </a>

      <nav class="flex items-center gap-2">
        <a href="/community" class="rounded-full bg-white/12 px-4 py-2 text-sm font-black text-white transition hover:bg-white/20">Feed</a>
        <a href="/favorites" class="rounded-full bg-white/12 px-4 py-2 text-sm font-black text-white transition hover:bg-white/20">Saved</a>
        <a href="/profile" class="hidden rounded-full bg-white/12 px-4 py-2 text-sm font-black text-white transition hover:bg-white/20 sm:inline-flex">My profile</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-5 pb-20 pt-8 lg:px-10">
    <section class="overflow-hidden rounded-[2.5rem] border border-white/15 bg-white/12 shadow-[0_28px_80px_rgba(0,0,0,0.22)] backdrop-blur-3xl">
      <div class="relative h-52 overflow-hidden sm:h-64">
        @if(profileUser.bannerUrl)
          <img src="{{ profileUser.bannerUrl }}" alt="" class="absolute inset-0 h-full w-full object-cover">
        @else
          <div class="absolute inset-0 bg-gradient-to-br from-[#1E3D19] via-[#315F28] to-[#728B6F]"></div>
        @endif
        <div class="absolute inset-0 bg-gradient-to-t from-[#1E3D19] via-transparent to-transparent"></div>
      </div>

      <div class="px-6 pb-7 pt-6 sm:px-8">
        <div class="grid gap-6 lg:grid-cols-[9rem_1fr_auto] lg:items-center">
          <div class="relative h-32 w-32">
            <div class="absolute -inset-1 rounded-[2rem] bg-[#EDE7D6] shadow-xl"></div>
            @if(profileUser.avatarUrl)
              <img src="{{ profileUser.avatarUrl }}" alt="" class="relative h-full w-full rounded-[1.8rem] border-4 border-white object-cover">
            @else
              <span class="relative flex h-full w-full items-center justify-center rounded-[1.8rem] border-4 border-white bg-[#1E3D19] text-5xl font-black text-[#EDE7D6]">
                {{ profileUser.initial }}
              </span>
            @endif
          </div>

          <div class="text-white">
            <div class="flex flex-wrap items-center gap-3">
              <h1 class="text-4xl font-black leading-tight lg:text-5xl">{{ profileUser.displayName }}</h1>
              <span class="rounded-full bg-[#EDE7D6] px-3 py-1.5 text-xs font-black uppercase tracking-[0.16em] text-[#1E3D19]">
                {{ profileUser.roleLabel }}
              </span>
            </div>
            <p class="mt-2 text-base font-bold text-[#EDE7D6]">{{ '@' + profileUser.username }}</p>
            <p class="mt-4 max-w-2xl text-sm font-semibold leading-7 text-white/78">
              {{ profileUser.bio || 'This profile is building its community presence.' }}
            </p>
          </div>

          <div class="flex flex-col gap-3">
            @if(isOwnProfile)
              <a href="/profile/settings" class="rounded-full bg-[#EDE7D6] px-6 py-3 text-center text-sm font-black text-[#1E3D19] shadow-lg transition hover:-translate-y-0.5">
                Settings
              </a>
            @else
              @form({
                action: '/users/' + profileUser.username + '/follow',
                method: 'POST',
                'data-follow-form': true
              })
                <button type="submit" class="{{ isFollowing ? 'bg-white/15 text-white' : 'bg-[#EDE7D6] text-[#1E3D19]' }} w-full rounded-full px-6 py-3 text-sm font-black shadow-lg transition hover:-translate-y-0.5">
                  <span data-follow-label>{{ isFollowing ? 'Following' : 'Follow' }}</span>
                </button>
              @end
            @endif
          </div>
        </div>

        <div class="{{ isOwnProfile ? 'mt-7 grid grid-cols-4 gap-3 text-center text-white' : 'mt-7 grid grid-cols-3 gap-3 text-center text-white' }}">
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="text-2xl font-black">{{ profileStats.posts }}</p>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#EDE7D6]">Posts</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="text-2xl font-black" data-followers-count>{{ profileStats.followers }}</p>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#EDE7D6]">Followers</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="text-2xl font-black">{{ profileStats.following }}</p>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#EDE7D6]">Following</p>
          </div>
          @if(isOwnProfile)
            <div class="rounded-2xl bg-white/10 p-4">
              <p class="text-2xl font-black">{{ profileStats.saved }}</p>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#EDE7D6]">Saved</p>
            </div>
          @endif
        </div>
      </div>
    </section>

    <section class="mt-8 grid gap-8 lg:grid-cols-[1fr_0.85fr]">
      <div class="space-y-5">
        <div class="flex items-end justify-between gap-4 text-white">
          <div>
            <p class="text-sm font-black uppercase tracking-[0.22em] text-[#EDE7D6]">Shared</p>
            <h2 class="mt-2 text-3xl font-black">Posts</h2>
          </div>
        </div>

        @each(post in posts)
          @!component('components/community-post-card', { post, viewer })
        @else
          <div class="rounded-[2rem] border border-white/30 bg-white/70 p-8 text-center shadow-xl backdrop-blur-2xl">
            <h3 class="text-2xl font-black text-[#1E3D19]">No public posts yet</h3>
          </div>
        @end
      </div>

      @if(isOwnProfile)
        <aside class="space-y-5">
          <div class="rounded-[2rem] border border-white/20 bg-white/14 p-5 text-white shadow-xl backdrop-blur-2xl">
            <p class="text-sm font-black uppercase tracking-[0.22em] text-[#EDE7D6]">Saved</p>
            <h2 class="mt-2 text-2xl font-black">Kept posts</h2>
            <p class="mt-2 text-sm font-semibold leading-6 text-white/70">
              Your saved posts are private and only appear here for you.
            </p>
          </div>

          <div class="space-y-4">
            @each(post in savedPosts)
              <a href="/community#post-{{ post.id }}" class="block overflow-hidden rounded-[1.5rem] border border-white/25 bg-white/70 p-4 shadow-lg backdrop-blur-2xl transition hover:-translate-y-0.5">
                <p class="line-clamp-3 text-sm font-black leading-6 text-[#1E3D19]">{{ post.body || 'Image post' }}</p>
                <p class="mt-2 text-xs font-bold text-[#728B6F]">By {{ '@' + post.author.username }}</p>
              </a>
            @else
              <div class="rounded-[1.5rem] border border-dashed border-white/30 p-5 text-sm font-semibold leading-6 text-white/75">
                No saved posts yet.
              </div>
            @end
          </div>
        </aside>
      @else
        <aside class="rounded-[2rem] border border-white/20 bg-white/14 p-5 text-white shadow-xl backdrop-blur-2xl">
          <p class="text-sm font-black uppercase tracking-[0.22em] text-[#EDE7D6]">Privacy</p>
          <h2 class="mt-2 text-2xl font-black">Saved posts stay private</h2>
          <p class="mt-2 text-sm font-semibold leading-6 text-white/70">
            Only shared posts are visible from another account's profile.
          </p>
        </aside>
      @endif
    </section>
  </main>
</div>

@end
