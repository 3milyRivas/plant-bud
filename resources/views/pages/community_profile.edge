          </div>

          <div class="flex flex-col gap-3">
            @if(isOwnProfile)
              <a href="/profile/settings" class="rounded-full bg-[#ebe3a7] px-6 py-3 text-center text-sm font-black text-[#113e14] shadow-lg transition hover:-translate-y-0.5">
                Settings
              </a>
            @else
              @form({
                action: '/users/' + profileUser.username + '/follow',
                method: 'POST',
                'data-follow-form': true
              })
                <button type="submit" class="{{ isFollowing ? 'bg-white/15 text-white' : 'bg-[#dca15d] text-[#113e14]' }} w-full rounded-full px-6 py-3 text-sm font-black shadow-lg transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]">
                  <span data-follow-label>{{ isFollowing ? 'Following' : 'Follow' }}</span>
