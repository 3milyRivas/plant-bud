              @endif
            </div>
            <p class="mt-2 text-base font-bold text-[#ebe3a7]">{{ '@' + profileUser.username }}</p>
            <p class="mt-4 max-w-2xl text-sm font-semibold leading-7 text-white/78">
              {{ profileUser.bio || 'This profile is building its community presence.' }}
