@layout()
@slot('title')
<title>Login</title>
@endslot

<div class="phone-auth-page relative z-10 min-h-screen overflow-hidden" data-auth-page data-phone-auth="login">

  <div class="relative grid min-h-screen lg:grid-cols-2">

    <div class="hidden lg:block relative">
      <img src="/resources/images/login/login-first.png" class="absolute inset-0 w-full h-full object-cover" alt="">
      <div class="absolute inset-0 bg-gradient-to-br from-black/72 via-[#113e14]/48 to-black/84"></div>

      <div class="absolute bottom-0 left-0 p-14 xl:p-16 max-w-lg">
        <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full bg-white/10 backdrop-blur-xl border border-white/10 mb-6">
          <div class="welcome-signal w-2 h-2 bg-[#a8b841] rounded-full"></div>
          <span class="text-white/80 text-sm font-bold tracking-[0.16em]">WELCOME BACK</span>
        </div>

        <h2 class="text-5xl xl:text-6xl font-black text-white leading-tight">
          Keep Your
          <span class="text-[#ebe3a7] block">Plants Alive</span>
        </h2>

        <div class="w-24 h-1 bg-[#dca15d] rounded-full mt-8 mb-8"></div>

        <p class="text-white/80 font-semibold leading-relaxed">
          Sign in and continue managing your plants, gardeners, and green spaces in one place.
        </p>
      </div>
    </div>

    <div class="phone-auth-pane relative min-h-screen overflow-y-auto px-4 py-10 sm:px-6 lg:px-14">
      <div class="flex min-h-full items-center justify-center">

      <a href="/register"
         class="absolute top-4 left-4 sm:top-6 sm:left-6 inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/10 backdrop-blur-xl border border-white/10 text-[#ebe3a7] font-bold text-sm hover:bg-[#ebe3a7] hover:text-[#113e14] transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M15 19l-7-7 7-7"></path>
        </svg>
        Back
      </a>

      <div class="phone-auth-shell w-full max-w-[min(32rem,100%)] sm:max-w-md">
        <div class="phone-auth-heading text-center mb-6 px-2 sm:px-0">
          <div class="relative inline-block mb-2">
            <img src="/resources/images/essential/pb-logo.png" class="relative w-40 mx-auto md:w-56" alt="">
          </div>

          <h1 class="text-4xl font-black text-white">Welcome back</h1>

          <p class="mt-4 text-sm text-white/90 font-semibold leading-relaxed">
            Sign in to continue your plant care journey
          </p>
        </div>

        <div class="relative">
          <div class="absolute -inset-2 bg-[#ebe3a7]/10 blur-3xl rounded-[1.5rem]"></div>

          <div class="phone-auth-card auth-card is-alive auth-panel-in relative bg-[#113e14]/82 text-white backdrop-blur-3xl border border-[#ebe3a7]/12 rounded-[1.5rem] px-6 py-6 sm:px-8 shadow-[0_30px_90px_rgba(0,0,0,0.25)] overflow-hidden">
            @if(flashMessages.has('errors') && flashMessages.get('errors').auth)
              <p class="relative z-10 mb-4 rounded-xl border border-red-300/30 bg-red-950/28 px-4 py-3 text-sm font-bold text-red-100">
                {{ flashMessages.get('errors').auth[0] }}
              </p>
            @endif

            @form({ route: 'session.store', method: 'POST', autocomplete: 'off', 'data-auth-form': 'login' })

            <div class="space-y-3 relative z-10">

              <div>
                @field.root({ name: 'email' })
                @!field.label({ text: 'Email or username', class: 'text-[#ebe3a7] text-sm font-black' })
                @!input.control({
                  type: 'text',
                  placeholder: 'Enter your email or username',
                  value: flashMessages.get('authOld')?.email,
                  autocomplete: 'off',
                  autocapitalize: 'none',
                  spellcheck: 'false',
                  'data-required-message': 'Email or username is required',
                  class: 'w-full mt-2 px-4 py-3 rounded-xl bg-[#ebe3a7]/95 text-[#113e14] placeholder:text-[#416543]/70 focus:outline-none focus:ring-2 focus:ring-[#a8b841] shadow-sm'
                })
                @!field.error({ class: 'text-red-300 text-xs mt-2' })
                @end
              </div>

              <div>
                @field.root({ name: 'password' })
                @!field.label({ text: 'Password', class: 'text-[#ebe3a7] text-sm font-black' })
                <div class="relative">
                  @!input.control({
                    type: 'password',
                    id: 'password',
                    placeholder: 'Enter your password',
                    autocomplete: 'off',
                    'data-required-message': 'Password is required',
                    class: 'w-full mt-2 px-4 py-3 pr-12 rounded-xl bg-[#ebe3a7]/95 text-[#113e14] placeholder:text-[#416543]/70 focus:outline-none focus:ring-2 focus:ring-[#a8b841] shadow-sm'
                  })
                  <button type="button" data-password-toggle="password" class="absolute inset-y-0 right-0 mt-2 px-4 flex items-center text-[#416543] hover:text-[#113e14] transition"></button>
                </div>

                @!field.error({ class: 'text-red-300 text-xs mt-2' })
                @end
              </div>

              @!button({
                text: 'Login',
                type: 'submit',
                class: 'w-full bg-[#dca15d] text-[#113e14] py-3.5 rounded-xl font-black shadow-lg hover:-translate-y-0.5 transition'
              })

            </div>

            @end

            <div class="mt-6 pt-5 border-t border-[#ebe3a7]/12 text-center relative z-10">
              <p class="text-sm font-semibold text-white/76">
                Don't have an account?
                <a href="/register" class="text-[#ebe3a7] font-black hover:underline">Create one</a>
              </p>
            </div>

          </div>

        </div>

      </div>
      </div>
    </div>

  </div>
</div>
@end
