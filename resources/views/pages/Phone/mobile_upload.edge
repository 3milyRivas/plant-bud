@layout()
@slot('title')
<title>Plant Bud - Phone Upload</title>
@endslot

<main class="relative z-10 min-h-screen bg-[#416543] px-4 py-6 text-[#113e14] sm:px-5 sm:py-8">
  <div class="relative z-10 mx-auto flex min-h-[calc(100vh-4rem)] w-full max-w-[40rem] items-center justify-center px-2 sm:px-0">
    <section class="relative z-10 w-full overflow-hidden rounded-[2rem] border border-white/45 bg-white/92 shadow-2xl">
      <div class="relative bg-[#113e14] px-5 py-6 text-[#ebe3a7] sm:px-6 sm:py-7">
        <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-[#dca15d] to-transparent"></div>
        <div class="flex items-center gap-3">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/10">
            <img src="/resources/images/essential/logo.png" alt="" class="h-12 w-12 object-contain">
          </span>
          <span>
            <span class="block text-xl font-black">Plant Bud</span>
            <span class="block text-xs font-black uppercase tracking-[0.18em] text-[#a8b841]">{{ tool }}</span>
          </span>
        </div>
      </div>

      <div class="p-5 sm:p-6">
        @if(expired)
          <div class="rounded-3xl border border-[#dca15d]/25 bg-[#ebe3a7]/45 p-5 text-center">
            <p class="text-2xl font-black">Link expired</p>
            <p class="mt-2 text-sm font-semibold leading-6 text-[#416543]">
              Generate a new QR from your computer and scan it again.
            </p>
          </div>
        @elseif(uploaded)
          <div class="rounded-3xl border border-[#a8b841]/35 bg-[#a8b841]/22 p-5 text-center">
            <p class="text-2xl font-black">Image uploaded</p>
            <p class="mt-2 text-sm font-semibold leading-6 text-[#416543]">
              You can return to your computer. Plant Bud will continue from there.
            </p>
          </div>
        @else
          <div>
            <p class="text-xs font-black uppercase tracking-[0.18em] text-[#dca15d]">Secure phone upload</p>
            <h1 class="mt-2 text-3xl font-black leading-tight">Upload your image</h1>
            <p class="mt-3 text-sm font-semibold leading-6 text-[#416543]">
              Choose the plant or garden photo you already have on this phone. The link only works for this temporary session.
            </p>
          </div>

          @if(error)
            <p class="mt-4 rounded-2xl bg-red-100 px-4 py-3 text-sm font-black text-red-800">{{ error }}</p>
          @endif

          <form id="phoneUploadForm" action="/phone-upload/{{ token }}" method="POST" enctype="multipart/form-data" class="mt-6 space-y-4">
            <label class="block rounded-[1.5rem] border border-dashed border-[#416543]/30 bg-[#416543]/8 p-5 text-center">
              <span class="block text-sm font-black text-[#113e14]">Choose image</span>
              <span class="mt-1 block text-xs font-semibold text-[#416543]">JPG, PNG, or WEBP up to 12MB</span>
              <input id="phoneImageInput" name="image" type="file" accept="image/*" class="sr-only">
              <span id="phoneFileName" class="mt-4 hidden rounded-full bg-white px-3 py-1 text-xs font-black text-[#416543]"></span>
              <span id="phoneImagePreviewShell" class="mt-5 hidden overflow-hidden rounded-[1.25rem] border border-white/75 bg-white/80 p-2 shadow-inner">
                <img id="phoneImagePreview" src="" alt="Selected upload preview" class="h-52 w-full rounded-[1rem] object-cover sm:h-64">
              </span>
            </label>

            <p id="phoneUploadError" class="hidden rounded-2xl bg-red-100 px-4 py-3 text-sm font-black text-red-800"></p>

            <button type="submit" class="w-full rounded-full bg-[#dca15d] px-5 py-3 text-sm font-black text-[#113e14] shadow-md transition hover:bg-[#ebe3a7]">
              Upload to Plant Bud
            </button>
          </form>

          <p class="mt-5 text-center text-xs font-bold text-[#416543]">
            Keep this page open until the upload finishes.
          </p>
        @endif
      </div>
    </section>
  </div>
</main>

<script>
  const form = document.getElementById('phoneUploadForm')
  const input = document.getElementById('phoneImageInput')
  const fileName = document.getElementById('phoneFileName')
  const previewShell = document.getElementById('phoneImagePreviewShell')
  const previewImage = document.getElementById('phoneImagePreview')
  const uploadError = document.getElementById('phoneUploadError')
  let previewUrl = null

  input?.addEventListener('change', () => {
    const file = input.files?.[0]
    if (!file) return

    if (previewUrl) URL.revokeObjectURL(previewUrl)

    if (fileName) {
      fileName.textContent = file.name
      fileName.classList.remove('hidden')
    }

    if (previewShell && previewImage && file.type.startsWith('image/')) {
      previewUrl = URL.createObjectURL(file)
      previewImage.src = previewUrl
      previewShell.classList.add('block')
      previewShell.classList.remove('hidden')
    }

    uploadError?.classList.add('hidden')
  })

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()

    const file = input?.files?.[0]
    if (!file) {
      if (uploadError) {
        uploadError.textContent = 'Choose an image before uploading.'
        uploadError.classList.remove('hidden')
      }
      return
    }

    const button = form.querySelector('button')
    const formData = new FormData(form)

    uploadError?.classList.add('hidden')
    button.disabled = true
    button.textContent = 'Uploading...'

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          Accept: 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
      })

      if (!response.ok) throw new Error('Upload failed')

      document.body.innerHTML = `
        <main class="relative z-10 min-h-screen bg-[#416543] px-5 py-8 text-[#113e14]">
          <div class="relative z-10 mx-auto flex min-h-[calc(100vh-4rem)] w-full max-w-[40rem] items-center justify-center px-2 sm:px-0">
            <section class="relative z-10 w-full rounded-[2rem] border border-white/45 bg-white/92 p-7 text-center shadow-2xl">
              <img src="/resources/images/essential/logo.png" alt="" class="mx-auto h-16 w-16 object-contain">
              <p class="mt-5 text-3xl font-black">Image uploaded</p>
              <p class="mt-3 text-sm font-semibold leading-6 text-[#416543]">You can return to your computer. Plant Bud will continue from there.</p>
            </section>
          </div>
        </main>
      `
    } catch {
      button.disabled = false
      button.textContent = 'Upload to Plant Bud'
      if (uploadError) {
        uploadError.textContent = 'Could not upload the image. Try again.'
        uploadError.classList.remove('hidden')
      }
    }
  })
</script>

@end
