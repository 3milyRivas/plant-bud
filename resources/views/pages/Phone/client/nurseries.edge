          <p class="mt-3 max-w-2xl font-semibold leading-7 text-[#416543]">
            @if(search)
              Results for “{{ search }}”. Showing {{ pagination.from }}–{{ pagination.to }} of {{ pagination.total }} nursery accounts.
            @else
