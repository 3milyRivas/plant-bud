  <section id="favorite-nurseries" class="phone-nursery-section phone-nursery-favorites scroll-mt-28 px-4 py-12 sm:px-8">
    <div class="mx-auto w-full max-w-[min(90rem,calc(100vw-2rem))]">
      <div class="mb-7 flex flex-col justify-between gap-4 text-white sm:flex-row sm:items-end">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.2em] text-[#ebe3a7]">Your saved places</p>
