          <p class="mt-3 max-w-2xl font-semibold leading-7 text-white/68">
            Keep the nurseries you visit most close at hand.
          </p>
        </div>
        @if(canUseFavorites)
          <span class="w-fit rounded-full bg-[#ebe3a7] px-5 py-2 text-xs font-black text-[#113e14]">
            {{ totals.favorites }} saved
          </span>
        @endif
      </div>

      @if(favoriteNurseries.length)
        <div class="phone-nursery-favorite-list grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          @each(nursery in favoriteNurseries)
            <article class="phone-nursery-favorite-card group relative overflow-hidden rounded-[32px] border border-white/16 bg-[#f8f5e7] p-5 text-[#113e14] shadow-[0_18px_50px_rgba(17,62,20,0.2)] transition hover:-translate-y-1">
              <div class="absolute -right-12 -top-16 h-36 w-36 rounded-full bg-[#dca15d]/18 transition duration-500 group-hover:scale-125"></div>
              <div class="relative flex items-start gap-4">
                @if(nursery.image)
                  <img src="{{ nursery.image }}" alt="{{ nursery.name }}" loading="lazy" decoding="async" class="h-20 w-20 shrink-0 rounded-[24px] border-4 border-white object-cover shadow-lg">
                @else
                  <span class="grid h-20 w-20 shrink-0 place-items-center rounded-[24px] border-4 border-white bg-[#416543] text-2xl font-black text-[#ebe3a7] shadow-lg">
                    {{ nursery.initial }}
                  </span>
                @endif
                <div class="min-w-0 flex-1 pt-1">
                  <span class="inline-flex rounded-full bg-[#dca15d]/18 px-3 py-1 text-[9px] font-black uppercase tracking-wider text-[#a0602f]">Favorite</span>
                  <h3 class="mt-2 truncate text-xl font-black">{{ nursery.name }}</h3>
                  <p class="mt-1 truncate text-xs font-bold text-[#416543]">{{ nursery.location }}</p>
                </div>
              </div>
              <p class="relative mt-4 line-clamp-2 text-sm font-semibold leading-6 text-[#416543]">{{ nursery.description }}</p>
              <div class="relative mt-5 flex gap-2 border-t border-[#113e14]/10 pt-4">
                <a href="{{ nursery.profileHref }}" class="flex-1 rounded-full bg-[#113e14] px-5 py-3 text-center text-xs font-black text-white transition hover:bg-[#416543]">
                  Go to profile
                </a>
                @form({
                  action: '/users/' + nursery.username + '/favorite',
                  method: 'POST',
                  class: 'flex-1'
                })
                  <button type="submit" class="w-full rounded-full border border-[#113e14]/14 bg-white px-5 py-3 text-xs font-black text-[#113e14] transition hover:bg-[#ebe3a7]">
                    Remove
                  </button>
                @end
              </div>
            </article>
          @endeach
        </div>
