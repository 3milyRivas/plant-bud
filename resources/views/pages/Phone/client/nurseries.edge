          <div id="nurserySearchResults" class="absolute left-3 right-3 top-[calc(100%+0.35rem)] z-[100] hidden max-h-[24rem] overflow-y-auto rounded-[24px] border border-white/55 bg-[#ebe3a7]/98 p-2 shadow-2xl" data-nursery-search-results role="listbox"></div>
        </form>
      </div>

