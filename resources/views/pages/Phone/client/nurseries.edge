  </section>

  <section class="phone-nursery-section phone-nursery-guide px-4 pb-24 pt-8 sm:px-8">
    <div class="mx-auto max-w-[1120px]">
      <div class="mb-8 text-center text-white">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-[#ebe3a7]">More places to visit</p>
        <h2 class="mt-2 font-abril text-4xl sm:text-5xl">The local nursery guide</h2>
        <p class="mx-auto mt-3 max-w-xl font-semibold leading-7 text-white/68">Extra recommendations kept in a small list so you can browse without an endless wall of cards.</p>
      </div>

      <div class="grid gap-3" data-progressive-list data-batch-size="4">
        @each(nursery in editorialNurseries)
          <article class="nursery-guide-row group grid grid-cols-[68px_minmax(0,1fr)] items-center gap-4 rounded-[24px] border border-white/14 bg-[#113e14]/72 p-3 text-white shadow-lg backdrop-blur-md transition hover:bg-[#113e14]/90 sm:grid-cols-[68px_minmax(0,1fr)_auto]" data-progressive-item>
            <img src="/{{ nursery.image }}" alt="{{ nursery.name }}" loading="lazy" decoding="async" class="h-16 w-16 rounded-[20px] object-cover">
            <div class="min-w-0">
              <h3 class="truncate text-base font-black">{{ nursery.name }}</h3>
              <p class="mt-1 truncate text-xs font-bold text-white/58">{{ nursery.location }} · {{ nursery.hours }}</p>
            </div>
            <a href="https://www.google.com/maps/dir/?api=1&destination={{ encodeURIComponent(nursery.name + ', ' + nursery.location + ', El Salvador') }}" target="_blank" rel="noreferrer" class="col-span-2 rounded-full bg-[#ebe3a7] px-5 py-3 text-center text-xs font-black text-[#113e14] transition hover:bg-white sm:col-span-1">
              Directions
            </a>
          </article>
        @endeach
      </div>
      <div class="mt-7 flex justify-center">
        <button type="button" class="rounded-full border border-white/18 bg-white/10 px-7 py-3 text-sm font-black text-white backdrop-blur-md transition hover:bg-white/18" data-progressive-more>
          Show more places
        </button>
      </div>
    </div>
  </section>
</main>
