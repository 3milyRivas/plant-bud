  </section>

  <section id="nursery-accounts" class="phone-nursery-section phone-nursery-accounts scroll-mt-28 px-4 py-16 sm:px-8">
    <div class="phone-nursery-accounts-shell mx-auto w-full max-w-[min(90rem,calc(100vw-2rem))] rounded-[46px] bg-[#ebe3a7] px-5 py-10 shadow-[0_25px_70px_rgba(17,62,20,0.22)] sm:px-9 lg:px-12">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
