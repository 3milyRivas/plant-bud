              <p class="mt-3 font-semibold leading-7 text-[#416543]">Nurseries will appear here only after they save an exact location in their profile.</p>
            </div>
          </div>
        @endif

        @if(mapLocations.length)
          <div class="pointer-events-none absolute left-4 right-4 top-4 flex justify-end sm:left-6 sm:right-6 sm:top-6">
