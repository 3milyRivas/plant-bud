        <div class="absolute inset-0 bg-gradient-to-t from-[#113e14]/70 via-transparent to-transparent lg:bg-gradient-to-r lg:from-[#113e14] lg:via-transparent lg:to-transparent"></div>
        <div class="absolute bottom-6 left-4 right-4 grid grid-cols-1 gap-2 rounded-[26px] border border-white/20 bg-[#113e14]/76 p-2 text-white shadow-2xl backdrop-blur-xl sm:left-32 sm:right-auto sm:w-[390px] sm:grid-cols-3">
          <div class="rounded-[20px] bg-[#ebe3a7] px-3 py-4 text-center text-[#113e14]">
