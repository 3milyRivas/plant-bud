          @endif
          <span class="w-fit rounded-full bg-[#113e14] px-5 py-2 text-xs font-black text-[#ebe3a7]">{{ pagination.total }} profiles</span>
        </div>
      </div>

      @if(registeredNurseries.length)
        <div class="mt-9 grid gap-5 grid-cols-1 lg:grid-cols-2">
          @each(nursery in registeredNurseries)
            <article class="nursery-account-card group relative overflow-hidden rounded-[32px] bg-[#f8f5e7] p-5 shadow-[0_12px_35px_rgba(17,62,20,0.09)] transition hover:-translate-y-1">
              <div class="absolute -right-12 -top-16 h-36 w-36 rounded-full bg-[#a8b841]/18 transition duration-500 group-hover:scale-125"></div>
              <div class="relative flex items-start gap-4">
                <div class="relative shrink-0">
                  @if(nursery.image)
                    <img src="{{ nursery.image }}" alt="{{ nursery.name }}" loading="lazy" decoding="async" class="h-20 w-20 rounded-[26px] border-4 border-white object-cover shadow-lg sm:h-24 sm:w-24">
                  @else
                    <span class="grid h-20 w-20 place-items-center rounded-[26px] border-4 border-white bg-[#416543] text-2xl font-black text-[#ebe3a7] shadow-lg sm:h-24 sm:w-24 sm:text-3xl">
                      {{ nursery.initial }}
                    </span>
                  @endif
                  <span class="absolute -bottom-1 -right-1 h-5 w-5 rounded-full border-4 border-[#f8f5e7] {{ nursery.isActive ? 'bg-[#a8b841]' : 'bg-[#dca15d]' }}"></span>
                </div>
                <div class="min-w-0 flex-1 pt-1">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <h3 class="truncate text-xl font-black sm:text-2xl">{{ nursery.name }}</h3>
                      <p class="mt-1 truncate text-xs font-black text-[#416543]/62">{{ '@' + nursery.username }}</p>
                    </div>
                    <div class="shrink-0 rounded-full bg-[#ebe3a7] px-3 py-2 text-xs font-black">
                      {{ nursery.rating ? nursery.rating + ' / 5' : 'New' }}
                    </div>
                  </div>
                  <p class="mt-3 line-clamp-2 text-sm font-semibold leading-6 text-[#416543]">{{ nursery.description }}</p>
                </div>
              </div>

              <div class="nursery-account-metrics relative mt-5 grid grid-cols-3 gap-2">
                <div class="rounded-2xl bg-[#113e14]/6 px-3 py-3">
                  <span class="block text-[9px] font-black uppercase tracking-wider text-[#416543]/60">Location</span>
                  <strong class="mt-1 block truncate text-xs">{{ nursery.location }}</strong>
                </div>
                <div class="rounded-2xl bg-[#113e14]/6 px-3 py-3">
                  <span class="block text-[9px] font-black uppercase tracking-wider text-[#416543]/60">Products</span>
                  <strong class="mt-1 block text-xs">{{ nursery.productsCount }} available</strong>
                </div>
                <div class="rounded-2xl bg-[#113e14]/6 px-3 py-3">
                  <span class="block text-[9px] font-black uppercase tracking-wider text-[#416543]/60">Reviews</span>
                  <strong class="mt-1 block text-xs">{{ nursery.reviews }} reviews</strong>
                </div>
              </div>

              <div class="nursery-account-footer relative mt-5 grid gap-3 border-t border-[#113e14]/10 pt-4 sm:grid-cols-[1fr_auto]">
                <p class="min-w-0 truncate text-xs font-bold text-[#416543]">{{ nursery.hours }}</p>
                <div class="flex shrink-0 items-center gap-2">
                  @if(canUseFavorites && !nursery.isOwnProfile)
                    @form({
                      action: '/users/' + nursery.username + '/favorite',
                      method: 'POST'
                    })
                      <button type="submit" class="{{ nursery.isFavorite ? 'bg-[#dca15d] text-[#113e14]' : 'bg-white text-[#416543]' }} rounded-full px-4 py-3 text-xs font-black shadow-sm transition hover:bg-[#ebe3a7]">
                        {{ nursery.isFavorite ? 'Favorite' : 'Add favorite' }}
                      </button>
                    @end
                  @endif
                  <a href="{{ nursery.profileHref }}" class="rounded-full bg-[#113e14] px-5 py-3 text-xs font-black text-white transition hover:bg-[#416543]">
                    Go to profile
                  </a>
                </div>
              </div>
            </article>
          @endeach
        </div>

        @if(pagination.totalPages > 1)
          <nav class="mt-9 flex flex-wrap items-center justify-center gap-2" aria-label="Nursery result pages">
            @if(pagination.previousHref)
              <a href="{{ pagination.previousHref }}" class="rounded-full border border-[#113e14]/12 bg-[#f8f5e7] px-5 py-3 text-xs font-black transition hover:bg-white">Previous</a>
            @endif
            @each(pageItem in pagination.pages)
              <a href="{{ pageItem.href }}" aria-current="{{ pageItem.current ? 'page' : 'false' }}" class="grid h-11 w-11 place-items-center rounded-full text-sm font-black transition {{ pageItem.current ? 'bg-[#113e14] text-white shadow-lg' : 'bg-[#f8f5e7] hover:bg-white' }}">
                {{ pageItem.number }}
              </a>
            @endeach
            @if(pagination.nextHref)
              <a href="{{ pagination.nextHref }}" class="rounded-full border border-[#113e14]/12 bg-[#f8f5e7] px-5 py-3 text-xs font-black transition hover:bg-white">Next</a>
            @endif
          </nav>
        @endif
      @else
        <div class="mt-9 rounded-[28px] border border-dashed border-[#113e14]/20 bg-white/45 p-10 text-center">
          <h3 class="text-2xl font-black">No nursery accounts found</h3>
          <p class="mt-2 font-semibold text-[#416543]">Try another nursery name, username, service, or location.</p>
          @if(search)
            <a href="/nurseries#nursery-accounts" class="mt-5 inline-flex rounded-full bg-[#113e14] px-6 py-3 text-sm font-black text-white">Clear search</a>
          @endif
        </div>
      @endif
