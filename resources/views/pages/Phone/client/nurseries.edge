          </h3>
          <p class="mx-auto mt-3 max-w-xl font-semibold leading-7 text-white/68">
            {{ canUseFavorites ? 'Use the favorite button on any nursery account to add it to this section.' : 'Your saved nursery list will stay connected to your Plant Bud account.' }}
          </p>
          <a href="{{ canUseFavorites ? '#nursery-accounts' : '/login' }}" class="mt-5 inline-flex rounded-full bg-[#dca15d] px-6 py-3 text-sm font-black text-[#113e14] transition hover:bg-[#ebe3a7]">
            {{ canUseFavorites ? 'Browse nurseries' : 'Sign in' }}
          </a>
        </div>
      @endif
