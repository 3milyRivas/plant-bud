              Show all places
            </button>
          </div>

          <aside class="absolute bottom-4 left-4 right-4 z-[1200] hidden rounded-[30px] border border-white/60 bg-[#f8f5e7]/95 p-4 shadow-2xl backdrop-blur-xl sm:bottom-6 sm:left-6 sm:right-auto sm:w-[390px]" data-nursery-map-preview>
          <div class="flex items-start gap-4">
            <div class="relative h-20 w-20 shrink-0">
              <img src="" alt="" class="hidden h-20 w-20 rounded-[24px] border-4 border-white bg-white object-contain p-1 shadow-md" data-nursery-preview-image>
              <span class="grid h-20 w-20 place-items-center rounded-[24px] border-4 border-white bg-[#416543] text-2xl font-black text-[#ebe3a7] shadow-md" data-nursery-preview-fallback></span>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-2">
                <span class="rounded-full bg-[#a8b841]/20 px-3 py-1 text-[9px] font-black uppercase tracking-wider text-[#416543]" data-nursery-preview-type></span>
                <button type="button" class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[#113e14]/8 text-base font-black" aria-label="Close nursery preview" data-nursery-preview-close>&times;</button>
              </div>
              <h3 class="mt-2 truncate text-xl font-black" data-nursery-preview-name></h3>
              <p class="mt-1 truncate text-xs font-bold text-[#416543]" data-nursery-preview-location></p>
              <p class="mt-1 truncate text-[11px] font-bold text-[#416543]/65" data-nursery-preview-hours></p>
