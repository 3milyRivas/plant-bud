    </section>

    <section class="grid grid-cols-3 gap-2 py-4" aria-label="Gardener tools">
      <a href="/scanner" class="flex min-h-20 flex-col items-center justify-center rounded-[1.2rem] bg-white/12 p-3 text-center text-white backdrop-blur-xl">
