                <button type="submit" {{ catalogCategories.length >= 6 ? 'disabled' : '' }} class="rounded-2xl bg-[#dca15d] px-5 text-sm font-black transition hover:bg-[#ebe3a7] disabled:cursor-not-allowed disabled:opacity-45">Add</button>
