                          <input type="checkbox" value="{{ day.key }}" class="peer sr-only" data-weekly-schedule-day {{ day.checked ? 'checked' : '' }}>
                          <span class="flex h-12 items-center justify-center rounded-2xl border border-[#a8b841] bg-white text-xs font-black text-[#113e14] shadow-sm transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">
                            {{ day.label }}
                          </span>
                        </label>
                      @endeach
