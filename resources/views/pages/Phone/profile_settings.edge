      'data-profile-settings-form': true
    })
      <section class="space-y-6">
        <div class="phone-profile-settings-preview overflow-hidden rounded-[2.5rem] border border-white/10 bg-white/12 shadow-[0_30px_90px_rgba(0,0,0,0.22)] backdrop-blur-3xl">
          <div class="relative h-56 overflow-hidden">
            <div id="banner-fallback" class="{{ bannerUrl ? 'hidden' : 'absolute inset-0' }}">
              <div class="absolute inset-0 bg-[#f7f6ea]"></div>
            </div>
            <img id="banner-preview" src="{{ bannerUrl || '' }}" alt="" class="{{ bannerUrl ? 'absolute inset-0 block h-full max-h-full w-full object-cover' : 'hidden absolute inset-0 h-full max-h-full w-full object-cover' }}">
            <label for="banner" class="absolute right-4 top-4 cursor-pointer rounded-full bg-[#dca15d] px-4 py-2 text-sm font-black text-[#113e14] shadow-lg transition hover:scale-[1.02] hover:bg-[#ebe3a7]">
              Change banner
            </label>
            <input id="banner" name="banner" type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-profile-file-input data-preview-target="banner-preview" data-preview-fallback="banner-fallback">
          </div>

          <div class="px-6 pb-6 pt-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div class="relative h-28 w-28 sm:h-32 sm:w-32">
