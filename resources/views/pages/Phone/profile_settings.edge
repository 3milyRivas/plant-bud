                <img id="avatar-preview" src="{{ avatarUrl || '' }}" alt="" class="{{ avatarUrl ? 'relative h-full w-full rounded-full border-4 border-white object-cover' : 'hidden relative h-full w-full rounded-full border-4 border-white object-cover' }}">
                <div id="avatar-fallback" class="{{ avatarUrl ? 'hidden' : 'relative flex h-full w-full items-center justify-center rounded-full border-4 border-white bg-[#113e14] text-4xl font-black text-[#ebe3a7] shadow-inner sm:text-5xl' }}">
                  {{ avatarInitial }}
                </div>
                <label for="avatar" class="absolute bottom-1 right-1 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-[#dca15d] text-lg font-black text-[#113e14] shadow-lg transition hover:bg-[#ebe3a7]" title="Change photo">
                  +
                </label>
                <input id="avatar" name="avatar" type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-avatar-input data-preview-target="avatar-preview" data-preview-fallback="avatar-fallback">
