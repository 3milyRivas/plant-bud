@layout()
@slot('title')
<title>Plant Bud - Settings</title>
@endslot

@let(old = flashMessages.get('old') || {})
@let(errors = flashMessages.get('errors') || {})
@let(displayName = accountProfile?.displayName || user.fullName || user.username)
@let(avatarUrl = accountProfile?.avatarUrl || user.profilePicture)
@let(bannerUrl = accountProfile?.bannerUrl)
@let(phoneValue = old.phone ?? user.phone ?? '')
@let(instagramHandle = old.instagram_handle ?? socialHandles.instagram ?? '')
@let(tiktokHandle = old.tiktok_handle ?? socialHandles.tiktok ?? '')
@let(facebookHandle = old.facebook_handle ?? socialHandles.facebook ?? '')
@let(publicPhoneValue = old.public_phone ?? roleProfile?.publicPhone ?? user.phone ?? '')
@let(publicEmailValue = old.public_email ?? roleProfile?.publicEmail ?? user.email ?? '')
@let(servicesValue = old.services_offered ?? profileServicesText ?? '')
@let(paymentMethodsValue = old.payment_methods ?? paymentMethodsText ?? '')
@let(paymentMethodsLower = paymentMethodsValue.toLowerCase())
@let(headlineValue = old.headline ?? roleProfile?.headline ?? '')
@let(serviceAreaValue = old.service_area ?? roleProfile?.serviceArea ?? accountProfile?.location ?? '')
@let(availabilityValue = old.availability_schedule ?? roleProfile?.availabilitySchedule ?? '')
@let(openingHoursValue = old.opening_hours ?? roleProfile?.openingHours ?? '')
@let(addressValue = old.address ?? roleProfile?.address ?? '')
@let(cityValue = old.city ?? roleProfile?.city ?? accountProfile?.location ?? '')
@let(latitudeValue = old.latitude ?? roleProfile?.latitude ?? '')
@let(longitudeValue = old.longitude ?? roleProfile?.longitude ?? '')
@let(gardenerStatusValue = old.is_available ?? (roleProfile?.isAvailable ? '1' : '0'))
@let(nurseryStatusValue = old.is_active ?? (roleProfile?.isActive ? '1' : '0'))

<div class="phone-profile-settings relative z-10 min-h-dvh overflow-hidden bg-[#416543] text-[#113e14]" data-profile-page data-phone-profile="settings" data-profile-role="{{ roleProfileKind }}">
  <div class="fixed inset-0 pointer-events-none">
    <img src="/resources/images/welcome/header3.png" alt="" class="h-full w-full object-cover opacity-20">
    <div class="absolute inset-0 bg-gradient-to-b from-[#113e14]/85 via-[#416543]/80 to-[#416543]"></div>
    <div class="absolute right-10 top-16 h-80 w-80 rounded-full bg-[#ebe3a7]/10 blur-3xl"></div>
    <div class="absolute bottom-10 left-10 h-96 w-96 rounded-full bg-white/10 blur-3xl"></div>
  </div>

  @!component('components/app-navbar', {
    section: 'Profile settings',
    active: 'settings',
    maxWidth: 'max-w-[min(1500px,calc(100vw-2rem))]',
    avatarUrl,
    avatarInitial,
    displayName,
    roleLabel: user.role,
    planLabel: accountProfile.planLabel,
  })

  <main class="phone-profile-settings-main relative z-10 mx-auto w-full max-w-[min(90rem,calc(100vw-2rem))] px-4 pb-36 pt-4 sm:px-5 lg:px-10">
    <section class="phone-profile-settings-header mb-6 rounded-[2rem] border border-white/12 bg-[#113e14]/78 p-6 text-white shadow-2xl backdrop-blur-2xl">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.2em] text-[#ebe3a7]">Profile workspace</p>
