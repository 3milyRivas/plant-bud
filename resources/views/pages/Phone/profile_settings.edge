          <p class="mt-3 max-w-2xl text-sm font-semibold leading-6 text-white/68">Update your public identity, professional details and payment preferences from one organized place.</p>
        </div>
        <a href="/profile" class="w-fit rounded-full border border-white/20 bg-white/10 px-5 py-3 text-sm font-black text-white transition hover:bg-white/18">View profile</a>
      </div>
      <nav class="mt-6 flex flex-wrap gap-2">
        <a href="#identity-settings" class="rounded-full bg-[#ebe3a7] px-4 py-2 text-xs font-black text-[#113e14]">Identity</a>
        @if(roleProfileKind === 'gardener' || roleProfileKind === 'nursery')
          <a href="#professional-settings" class="rounded-full bg-white/10 px-4 py-2 text-xs font-black text-white">Professional</a>
          @if(roleProfileKind === 'nursery')
