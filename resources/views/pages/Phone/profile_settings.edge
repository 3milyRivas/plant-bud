              <span class="text-sm font-black text-[#416543]">Display name</span>
              <input name="display_name" value="{{ old.display_name ?? displayName }}" maxlength="100" class="mt-2 h-12 w-full rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-sm font-bold text-[#113e14] outline-none transition focus:border-[#416543] focus:bg-white">
