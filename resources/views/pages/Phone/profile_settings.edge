            <h1 class="mt-5 text-3xl font-black text-white">{{ displayName }}</h1>
            <p class="mt-1 text-sm font-bold text-[#ebe3a7]">{{ '@' + user.username }}</p>

            @if(errors.avatar)
              <p class="mt-3 text-sm font-bold text-red-200">{{ errors.avatar[0] }}</p>
