                @if(accountProfile.isPremium)
                  <button type="submit" formaction="/plans/cancel" formmethod="POST" formenctype="application/x-www-form-urlencoded" formnovalidate class="inline-flex items-center justify-center rounded-full border border-[#ebe3a7]/45 bg-[#ebe3a7] px-5 py-2.5 text-sm font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5 hover:bg-white">
