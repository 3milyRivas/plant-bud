                    Upgrade
                  </a>
                @endif
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-6">
        <div id="identity-settings" class="scroll-mt-28 rounded-[2.5rem] bg-[#ebe3a7]/95 p-6 shadow-[0_24px_70px_rgba(0,0,0,0.18)]">
          <div>
            <p class="text-sm font-black uppercase tracking-[0.18em] text-[#416543]">Edit profile</p>
            <h2 class="mt-2 text-3xl font-black text-[#113e14]">Public identity</h2>
          </div>

          <div class="mt-7 grid gap-5 md:grid-cols-2">
