              @if(errors.services_offered)
                <span class="mt-2 block text-xs font-bold text-red-700">{{ errors.services_offered[0] }}</span>
              @endif
            </label>

            <div class="mt-7">
              <div class="block w-full" data-weekly-schedule>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                  <div>
                    <span class="text-sm font-black text-[#416543]">Schedule</span>
                    <p class="mt-1 text-sm font-semibold text-[#416543]/70">Select your regular days and hours. Clients will see this before requesting a service.</p>
                  </div>
                  <span class="w-fit rounded-full bg-[#416543]/10 px-4 py-2 text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Weekly hours</span>
                </div>
                <input type="hidden" name="availability_schedule" value="{{ availabilityValue }}" data-weekly-schedule-value maxlength="500">
                <div class="mt-4 rounded-[2rem] border border-[#a8b841] bg-white/70 p-5 text-[#113e14] shadow-sm sm:p-7">
                  <div class="grid gap-6" data-weekly-schedule-main>
                    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7 lg:gap-3" data-weekly-schedule-days>
                      @each(day in [
                        { key: 'mon', label: 'Lun', checked: true },
                        { key: 'tue', label: 'Mar', checked: true },
                        { key: 'wed', label: 'Mie', checked: true },
                        { key: 'thu', label: 'Jue', checked: true },
                        { key: 'fri', label: 'Vie', checked: true },
                        { key: 'sat', label: 'Sab', checked: false },
                        { key: 'sun', label: 'Dom', checked: false },
                      ])
                        <label class="cursor-pointer">
                          <input type="checkbox" value="{{ day.key }}" class="peer sr-only" data-weekly-schedule-day {{ day.checked ? 'checked' : '' }}>
                          <span class="flex h-12 items-center justify-center rounded-2xl border border-[#a8b841] bg-white/70 text-sm font-black text-[#113e14] transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">
                            {{ day.label }}
                          </span>
                        </label>
                      @endeach
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                      <label>
