                  <textarea name="description" maxlength="500" rows="4" placeholder="Size, care, presentation, or anything useful for buyers." class="mt-2 w-full resize-none rounded-2xl border border-[#416543]/20 bg-white px-4 py-3 text-sm font-bold leading-6 outline-none"></textarea>
                </label>
                <button type="submit" class="w-full rounded-full bg-[#113e14] px-6 py-3 text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-[#416543]">Publish product</button>
              </div>
            </form>
          </div>

          <div>
            <div class="mb-5">
              <p class="text-xs font-black uppercase tracking-[0.18em] text-[#dca15d]">Inventory</p>
              <h3 class="mt-2 text-2xl font-black">Published products</h3>
            </div>
            <div class="space-y-5">
              @each(category in catalogCategories)
                @let(categoryProducts = catalogProducts.filter((product) => (product.category || 'Plants').toLowerCase() === category.name.toLowerCase()))
                <section class="overflow-hidden rounded-[2rem] border border-[#416543]/10 bg-white/62 shadow-[0_14px_40px_rgba(17,62,20,0.08)]">
                  <div class="flex items-center justify-between gap-4 border-b border-[#416543]/10 bg-white px-5 py-4">
                    <div>
                      <p class="text-xs font-black uppercase tracking-[0.16em] text-[#dca15d]">{{ category.isDefault ? 'Main category' : 'Custom category' }}</p>
                      <h4 class="mt-1 text-xl font-black">{{ category.name }}</h4>
                    </div>
                    <span class="rounded-full bg-[#416543]/10 px-3 py-2 text-xs font-black text-[#416543]">{{ categoryProducts.length }} products</span>
                  </div>
                  <div class="space-y-3 p-4">
                  @each(product in categoryProducts)
                    <details class="phone-nursery-inventory-item group overflow-hidden rounded-[1.5rem] border border-[#416543]/10 bg-white shadow-sm">
                  <summary class="flex cursor-pointer list-none items-center gap-4 p-4">
                    <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl bg-[#dfe8cf]">
                      @if(product.imageUrl)
                        <img src="{{ product.imageUrl }}" alt="" loading="lazy" class="h-full w-full object-cover">
                      @else
                        <div class="flex h-full items-center justify-center text-2xl font-black text-[#113e14]/25">{{ product.name.slice(0, 1).toUpperCase() }}</div>
                      @endif
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-lg font-black">{{ product.name }}</p>
                      <p class="mt-1 text-xs font-bold text-[#416543]">{{ product.category || 'Plants' }} · {{ product.stock }} in stock</p>
                    </div>
                    <span class="{{ product.isActive ? 'bg-[#dfe8cf] text-[#113e14]' : 'bg-[#416543]/10 text-[#416543]' }} rounded-full px-3 py-2 text-xs font-black">{{ product.isActive ? 'Visible' : 'Hidden' }}</span>
                    <span class="text-xl font-black text-[#416543] transition group-open:rotate-45">+</span>
                  </summary>
                  <form method="POST" action="/profile/catalog/products/{{ product.id }}" enctype="multipart/form-data" class="border-t border-[#416543]/10 bg-[#f9f7e9] p-5">
                    {{ csrfField() }}
                    <div class="grid gap-4 sm:grid-cols-2">
                      <label class="sm:col-span-2">
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Name</span>
                        <input name="name" required value="{{ product.name }}" maxlength="120" class="mt-2 h-11 w-full rounded-xl border border-[#416543]/20 bg-white px-3 text-sm font-bold">
                      </label>
                      <label>
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Category</span>
                        <select name="category" class="mt-2 h-11 w-full rounded-xl border border-[#416543]/20 bg-white px-3 text-sm font-bold">
                          @each(category in catalogCategories)
                            <option value="{{ category.name }}" {{ (product.category || 'Plants').toLowerCase() === category.name.toLowerCase() ? 'selected' : '' }}>{{ category.name }}</option>
                          @end
                        </select>
                      </label>
                      <label>
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Replace photo</span>
                        <input type="file" name="image" accept="image/jpeg,image/png,image/webp" class="mt-2 block w-full text-xs font-bold">
                      </label>
                      <label>
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Price</span>
                        <input name="price" type="number" min="0" max="999999.99" step="0.01" value="{{ product.price ?? '' }}" class="mt-2 h-11 w-full rounded-xl border border-[#416543]/20 bg-white px-3 text-sm font-bold">
                      </label>
                      <label>
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Stock</span>
                        <input name="stock" type="number" min="0" max="999999" step="1" value="{{ product.stock }}" class="mt-2 h-11 w-full rounded-xl border border-[#416543]/20 bg-white px-3 text-sm font-bold">
                      </label>
                      <label class="sm:col-span-2">
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Description</span>
                        <textarea name="description" maxlength="500" rows="3" class="mt-2 w-full resize-none rounded-xl border border-[#416543]/20 bg-white px-3 py-3 text-sm font-bold">{{ product.description || '' }}</textarea>
                      </label>
                      <label class="flex items-center gap-3 rounded-xl bg-white px-4 py-3 sm:col-span-2">
                        <input type="checkbox" name="is_active" value="1" {{ product.isActive ? 'checked' : '' }} class="h-5 w-5 accent-[#113e14]">
                        <span class="text-sm font-black">Visible on my public profile</span>
                      </label>
                    </div>
                    <div class="mt-4 flex flex-wrap gap-2">
                      <button type="submit" class="rounded-full bg-[#113e14] px-5 py-2.5 text-xs font-black text-white">Save product</button>
                      <button type="submit" formaction="/profile/catalog/products/{{ product.id }}/delete" formnovalidate class="rounded-full bg-red-50 px-5 py-2.5 text-xs font-black text-red-700">Delete</button>
                    </div>
                  </form>
                    </details>
                  @else
                    <div class="rounded-[1.5rem] border border-dashed border-[#416543]/25 bg-[#f9f7e9] p-5 text-center">
                      <p class="text-sm font-black text-[#113e14]">No products in {{ category.name }}</p>
                      <p class="mt-1 text-xs font-semibold text-[#416543]">Choose this category when publishing the next product.</p>
                    </div>
                  @end
                  </div>
                </section>
              @end
            </div>
          </div>
        </div>
      </section>
    @endif
  </main>

  <div class="fixed inset-0 z-50 hidden items-center justify-center bg-[#113e14]/85 p-5 backdrop-blur-xl" data-avatar-cropper aria-hidden="true">
    <div class="w-full max-w-lg rounded-[2rem] bg-[#ebe3a7] p-5 text-[#113e14] shadow-[0_30px_90px_rgba(0,0,0,0.35)]">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#416543]">Profile photo</p>
          <h2 class="mt-1 text-2xl font-black">Crop square</h2>
        </div>
        <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-xl font-black text-[#113e14] shadow-sm transition hover:bg-[#ebe3a7]" data-avatar-cancel aria-label="Close cropper">
          x
        </button>
      </div>

      <div class="mt-5 rounded-[1.5rem] bg-white/60 p-3">
        <div class="relative mx-auto aspect-square w-full max-w-sm touch-none overflow-hidden rounded-[1.25rem] bg-[#113e14]/10" data-avatar-crop-frame>
          <img src="" alt="" class="absolute left-0 top-0 max-w-none select-none" data-avatar-crop-image draggable="false">
          <div class="pointer-events-none absolute inset-0 rounded-[1.25rem] ring-2 ring-white/95"></div>
        </div>
      </div>

      <label class="mt-5 block">
        <span class="text-sm font-black text-[#416543]">Zoom</span>
        <input type="range" min="1" max="3" step="0.01" value="1" class="mt-2 w-full accent-[#113e14]" data-avatar-zoom>
      </label>

      <div class="mt-5 flex justify-end gap-3">
        <button type="button" class="rounded-full bg-white px-5 py-2.5 text-sm font-black text-[#113e14] shadow-sm transition hover:bg-[#ebe3a7]" data-avatar-cancel>
          Cancel
        </button>
        <button type="button" class="rounded-full bg-[#dca15d] px-5 py-2.5 text-sm font-black text-[#113e14] shadow-lg transition hover:bg-[#ebe3a7]" data-avatar-apply>
          Apply crop
        </button>
      </div>
    </div>
  </div>
</div>
@end
