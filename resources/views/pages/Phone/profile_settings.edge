                    <input type="radio" name="is_available" value="1" class="peer sr-only" {{ gardenerStatusValue === '1' ? 'checked' : '' }}>
                    <span class="flex min-h-12 items-center justify-center rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-center text-sm font-black text-[#113e14] transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">
                      Available
                    </span>
