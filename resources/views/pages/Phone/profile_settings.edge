                      <label>
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Hasta</span>
                        <input type="time" value="15:00" class="mt-2 h-14 w-full rounded-2xl border border-[#a8b841] bg-white px-4 text-base font-black text-[#113e14] outline-none focus:border-[#416543]" data-weekly-schedule-end>
                      </label>
                    </div>
                    <div class="flex flex-wrap gap-3 border-t border-[#a8b841]/45 pt-5">
                      <button type="button" class="rounded-full bg-[#113e14] px-5 py-3 text-xs font-black text-[#ebe3a7] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#416543]" data-weekly-schedule-preset="weekdays">Lun-Vie</button>
                      <button type="button" class="rounded-full bg-white px-5 py-3 text-xs font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]" data-weekly-schedule-preset="all">Toda semana</button>
                      <button type="button" class="rounded-full bg-white px-5 py-3 text-xs font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]" data-weekly-schedule-toggle-weekend>Fin de semana</button>
