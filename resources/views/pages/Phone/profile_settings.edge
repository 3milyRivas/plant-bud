                      <button type="button" class="rounded-full bg-white px-5 py-3 text-xs font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]" data-weekly-schedule-preset="all">Toda semana</button>
                      <button type="button" class="rounded-full bg-white px-5 py-3 text-xs font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]" data-weekly-schedule-toggle-weekend>Fin de semana</button>
