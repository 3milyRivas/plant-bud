@layout()
@slot('title')
<title>Plant Bud - Notifications</title>
@endslot

<div class="phone-notifications-page min-h-screen overflow-x-hidden text-[#113e14]" data-community-page data-phone-notifications>
  @!component('components/community/top-navbar', {
    viewer,
    active: 'notification',
    section: 'Notifications'
  })

  <main class="phone-notifications-main mx-auto grid w-full max-w-[1280px] grid-cols-1 gap-7 px-4 pb-24 pt-7 sm:px-6 lg:px-8 xl:grid-cols-[minmax(0,1fr)_21rem] xl:items-start" data-community-layout>
    <section class="min-w-0 space-y-6" data-community-main>
      @if(flashMessages.get('success'))
        <div class="rounded-[1.25rem] border border-[#a8b841]/35 bg-[#ebe3a7]/94 px-5 py-4 text-sm font-black text-[#113e14] shadow-xl" role="status">
          {{ flashMessages.get('success') }}
        </div>
      @endif

      <div class="phone-notifications-hero relative overflow-hidden rounded-[2rem] border border-white/20 bg-[#113e14]/90 p-7 text-white shadow-[0_28px_80px_rgba(17,62,20,0.28)] backdrop-blur-2xl md:p-9">
        <div class="absolute -right-16 -top-20 h-56 w-56 rounded-full bg-[#dca15d]/22 blur-2xl"></div>
        <div class="absolute -bottom-24 right-28 h-48 w-48 rounded-full bg-[#a8b841]/18 blur-2xl"></div>
        <div class="relative flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.22em] text-[#ebe3a7]">Recent activity</p>
            <h1 class="mt-3 font-abril text-5xl leading-tight md:text-6xl">Notifications</h1>
            <p class="mt-4 max-w-2xl text-sm font-semibold leading-7 text-white/72">
              Keep up with followers, conversations, reactions, reviews, and service requests.
            </p>
          </div>
          <div class="phone-notifications-actions flex items-center gap-3">
            <div class="phone-notifications-count rounded-[1.25rem] border border-white/12 bg-white/10 px-5 py-3 text-center">
              <p class="text-3xl font-black">{{ unreadCount }}</p>
              <p class="text-[10px] font-black uppercase tracking-[0.16em] text-white/55">New</p>
            </div>
            @if(notifications.length)
              @form({ action: '/notification/clear', method: 'POST' })
                <button type="submit" class="rounded-full border border-white/20 bg-white/10 px-5 py-3 text-sm font-black text-white transition hover:-translate-y-0.5 hover:bg-white/20" aria-label="Clear all notifications and mark them as read">
                  Clear all
                </button>
              @end
            @endif
            <a href="/community" class="rounded-full bg-[#dca15d] px-5 py-3 text-sm font-black text-[#113e14] shadow-lg transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]">Back to feed</a>
          </div>
        </div>
      </div>

      <div class="phone-notifications-list-shell rounded-[1.75rem] border border-white/45 bg-[#f5f2df]/90 p-3 shadow-[0_20px_65px_rgba(17,62,20,0.18)] backdrop-blur-xl sm:p-4">
        <div class="phone-notifications-list space-y-3">
          @each(notification in notifications)
            <a href="{{ notification.href }}" class="phone-notification-card {{ notification.isUnread ? 'is-unread border-[#dca15d]/45 bg-[#fffaf0] ring-1 ring-[#dca15d]/15' : 'border-[#416543]/8 bg-white/72' }} group relative flex flex-col items-start gap-4 rounded-[1.25rem] border p-4 shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-[#dca15d]/35 hover:bg-white hover:shadow-lg sm:flex-row sm:items-center sm:justify-between" aria-label="{{ notification.isUnread ? 'Unread notification: ' : '' }}{{ notification.title }}. {{ notification.body }}">
              @if(notification.isUnread)
                <span class="absolute left-1.5 top-1/2 h-2 w-2 -translate-y-1/2 rounded-full bg-[#dca15d]" aria-hidden="true"></span>
              @endif
              <div class="phone-notification-content flex min-w-0 flex-1 items-center gap-3">
                @if(notification.actor && notification.actor.avatarUrl)
                  <img src="{{ notification.actor.avatarUrl }}" alt="" class="h-14 w-14 flex-none rounded-2xl border-2 border-white object-cover shadow-md">
                @elseif(notification.actor)
                  <span class="flex h-14 w-14 flex-none items-center justify-center rounded-2xl bg-[#113e14] font-black text-[#ebe3a7] shadow-md">{{ notification.actor.initial }}</span>
                @else
                  <span class="flex h-14 w-14 flex-none items-center justify-center rounded-2xl bg-[#dca15d]/24 font-black text-[#113e14] shadow-md">PB</span>
                @endif

                <span class="min-w-0">
                  <span class="block text-base font-black text-[#113e14]">{{ notification.title }}</span>
                  <span class="mt-1 block truncate text-sm font-semibold text-[#416543]">{{ notification.body }}</span>
                  @if(notification.postPreview)
                    <span class="mt-1 block truncate text-xs font-bold text-[#416543]/70">{{ notification.postPreview }}</span>
                  @endif
                </span>
              </div>

              <div class="phone-notification-meta flex flex-none flex-wrap items-center gap-3">
                <span class="rounded-full bg-[#ebe3a7]/55 px-3 py-1.5 text-xs font-black text-[#416543]">{{ notification.createdAtHuman }}</span>
                @if(notification.thumbnailUrl)
                  <img src="{{ notification.thumbnailUrl }}" alt="" class="h-12 w-12 rounded-xl object-cover">
                @else
                  <span class="h-10 w-10 rounded-full bg-[url('/resources/images/community/notifications.png')] bg-contain bg-center bg-no-repeat opacity-80 transition group-hover:scale-110"></span>
                @endif
              </div>
            </a>
          @else
            <div class="rounded-[1.5rem] border border-dashed border-[#416543]/25 bg-white/56 p-12 text-center">
              <div class="mx-auto mb-5 h-16 w-16 rounded-2xl bg-[url('/resources/images/community/notifications.png')] bg-contain bg-center bg-no-repeat"></div>
              <h2 class="text-3xl font-black text-[#113e14]">Quiet for now</h2>
              <p class="mt-3 text-sm font-bold text-[#416543]">Follows, comments, reactions, reviews, and service updates will appear here.</p>
            </div>
          @end
        </div>
      </div>
    </section>

    <aside class="phone-notifications-sidebar block min-w-0 xl:block" data-community-sidebar>
      <div class="space-y-4 xl:sticky xl:top-28">
        <details open class="rounded-[1.5rem] border border-white/50 bg-[#f5f2df]/92 p-5 text-[#113e14] shadow-xl backdrop-blur-xl">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <h2 class="text-lg font-black">Your profile</h2>
            <span class="text-xs font-bold text-[#416543]">{{ viewer.roleLabel }}</span>
          </summary>
          <div class="mt-4 flex items-center gap-3">
            @if(viewer.avatarUrl)
              <img src="{{ viewer.avatarUrl }}" alt="" class="h-14 w-14 rounded-full object-cover">
            @else
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-[#113e14] text-xl font-black text-[#ebe3a7]">{{ viewer.initial }}</span>
            @endif
            <span class="min-w-0">
              <span class="block truncate text-sm font-black">{{ viewer.displayName }}</span>
              <span class="block truncate text-xs font-bold text-[#416543]">{{ '@' + viewer.username }}</span>
            </span>
          </div>
        </details>

        <details open class="rounded-[1.5rem] border border-white/50 bg-[#ebe3a7]/92 p-5 text-[#113e14] shadow-xl backdrop-blur-xl">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <h2 class="text-sm font-black">Suggestions</h2>
            <span class="text-xs font-bold text-[#416543]">new</span>
          </summary>
          <div class="mt-4 space-y-3">
            @each(user in suggestions)
              <div class="flex items-center justify-between gap-3 rounded-2xl bg-white/48 p-3 transition hover:bg-white/78">
                <a href="/users/{{ user.username }}" class="flex min-w-0 items-center gap-3">
                  @if(user.avatarUrl)
                    <img src="{{ user.avatarUrl }}" alt="" class="h-10 w-10 rounded-full object-cover">
                  @else
                    <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-[#113e14] text-sm font-black text-[#ebe3a7]">{{ user.initial }}</span>
                  @endif
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-black">{{ user.displayName }}</span>
                    <span class="block truncate text-xs font-bold text-[#416543]">{{ '@' + user.username }}</span>
                  </span>
                </a>
                @form({
                  action: '/users/' + user.username + '/follow',
                  method: 'POST',
                  class: 'shrink-0',
                  'data-follow-form': true
                })
                  <button type="submit" class="rounded-full bg-[#dca15d] px-3 py-1.5 text-xs font-black text-[#113e14] transition hover:bg-[#ebe3a7]" data-follow-label>follow</button>
                @end
              </div>
            @else
              <p class="text-xs font-semibold text-[#416543]">No suggestions right now.</p>
            @end
          </div>
        </details>
      </div>
    </aside>
  </main>
</div>

@end
