                            <div class="w-14 h-1 bg-[#dca15d] rounded-full mt-3 mb-5"></div>

                            <div class="designer-tool-groups">
                                <div class="designer-tool-group designer-tool-group--wide">
                                    @each(tool in [
                                        { action: 'clearSelection()', icon: 'deselect.png', label: 'Deselect item' },
                                        { action: 'duplicateSelected()', icon: 'copy.png', label: 'Copy item' },
                                        { action: 'deleteSelected()', icon: 'delete.png', label: 'Delete item' },
                                        { action: 'clearAll()', icon: 'clear.png', label: 'Clear workspace' }
                                    ])
                                        <button type="button" onclick="{{ tool.action }}" class="designer-tool-button"
                                            aria-label="{{ tool.label }}" title="{{ tool.label }}">
                                            <img src="/resources/images/designer-tools/{{ tool.icon }}" alt="">
                                        </button>
                                    @end
                                </div>

                                <div class="designer-tool-row">
