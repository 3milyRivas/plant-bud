                                                <img src="/resources/images/designer-tools/{{ tool.icon }}" alt="">
                                            </button>
                                        @end
                                    </div>
                                </div>

                                <div class="designer-tool-group designer-tool-group--wide">
                                    @each(tool in [
                                        { action: 'rotateSelected()', icon: 'rotate.png', label: 'Rotate item' },
                                        { action: 'flipSelected()', icon: 'flip-x.png', label: 'Flip horizontally' },
                                        { action: 'flipYSelected()', icon: 'flip-y.png', label: 'Flip vertically' },
                                        { action: 'toggleLock()', icon: 'lock.png', label: 'Lock or unlock item' }
