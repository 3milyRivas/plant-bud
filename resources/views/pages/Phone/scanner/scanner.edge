@layout()
@slot('title')
<title>Plant Bud - Scanner</title>
@endslot

@let(scannerUsage = subscription.scannerUsage)
@let(freeScannerMonthlyLimit = subscription.freeScannerMonthlyLimit || 5)
@let(isPremium = subscription.isPremium)
@let(scanHistory = scannerHistory || [])

<div class="phone-scanner-page relative min-h-screen overflow-hidden" data-phone-scanner>
    @!component('components/app-navbar', {
        section: 'Plant scanner',
        active: 'scanner',
        maxWidth: 'max-w-[min(1500px,calc(100vw-2rem))]',
        planLabel: subscription.planLabel,
        scannerUsage,
    })
    <input id="plantUpload" type="file" accept="image/*" class="hidden">

    <main class="relative z-10 px-4 pb-10 pt-4 sm:px-6 lg:px-10">
        <div data-phone-first-content>
            @!component('components/tool-action-panel', { mode: 'scanner' })
        </div>

        @if(!isPremium)
            <section class="phone-scanner-usage mx-auto mb-6 w-full max-w-[min(90rem,calc(100vw-2rem))] overflow-hidden rounded-[1.75rem] border-2 border-[#ebe3a7]/70 bg-[#ebe3a7] text-[#113e14] shadow-[0_22px_65px_rgba(17,62,20,0.28)]" aria-label="Free scanner usage">
                <div class="grid gap-4 p-5 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:p-6">
                    <div class="grid h-20 w-20 place-items-center rounded-[1.35rem] bg-[#113e14] text-center text-[#ebe3a7] shadow-lg">
                        <strong class="text-4xl leading-none" data-scanner-remaining>{{ scannerUsage.remaining }}</strong>
                        <span class="text-[9px] font-black uppercase tracking-[0.14em]">uses left</span>
                    </div>
                    <div>
                        <p class="text-xs font-black uppercase tracking-[0.2em] text-[#416543]">Free scanner allowance</p>
                        <h2 class="mt-1 text-2xl font-black" data-scanner-remaining-summary>{{ scannerUsage.remaining }} of {{ scannerUsage.limit }} analyses available</h2>
                        <p class="mt-1 text-sm font-bold text-[#416543]" data-scanner-reset>Restores on {{ scannerUsage.resetLabel }}</p>
                    </div>
                    <a href="/plans" class="inline-flex justify-center rounded-full bg-[#dca15d] px-6 py-3 text-sm font-black text-[#113e14] shadow-md transition hover:-translate-y-0.5 hover:bg-white">Get unlimited scans</a>
                </div>
                <div class="h-2 bg-[#113e14]/12">
                    <div class="h-full bg-[#416543]" style="width: {{ (scannerUsage.remaining / scannerUsage.limit) * 100 }}%" data-scanner-progress></div>
                </div>
            </section>
        @endif

        <div id="scannerLimitBox" class="mx-auto mb-6 hidden w-full max-w-[min(90rem,calc(100vw-2rem))] rounded-[1.5rem] border border-[#dca15d]/35 bg-[#113e14]/74 px-5 py-4 text-[#ebe3a7] shadow-xl backdrop-blur-2xl">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm font-black uppercase tracking-[0.18em]">Scanner limit reached</p>
                    <p class="mt-1 text-sm font-semibold text-[#ebe3a7]/78">Free accounts include {{ freeScannerMonthlyLimit }} scans per month. Your allowance restores on <span data-scanner-reset-date>{{ scannerUsage.resetLabel }}</span>.</p>
                </div>
                <a href="/plans" class="inline-flex rounded-full bg-[#dca15d] px-5 py-2.5 text-sm font-black text-[#113e14] transition hover:bg-[#ebe3a7]">Upgrade</a>
            </div>
        </div>

        <div class="phone-scanner-layout w-full max-w-[min(90rem,calc(100vw-2rem))] mx-auto grid grid-cols-1 xl:grid-cols-[370px_1fr] gap-8 min-h-[calc(100vh-11rem)]">
            <aside class="phone-scanner-capture relative min-w-0">
                <div class="absolute -inset-2 bg-white/10 blur-2xl rounded-[2.5rem]"></div>
                <div class="relative h-full overflow-hidden bg-white/12 backdrop-blur-2xl border border-white/18 rounded-[2.5rem] p-6 shadow-[0_30px_80px_rgba(0,0,0,0.16)]">
                    <div class="absolute inset-x-6 top-0 h-1 rounded-b-full bg-[#a8b841]/60"></div>

                    <p class="text-xs font-black uppercase tracking-[0.22em] text-[#ebe3a7]">Step 1</p>
                    <h2 class="mt-2 text-white text-xl font-black">Plant health scan</h2>
                    <p class="mt-2 text-sm font-semibold leading-6 text-white/66">Upload or drop one image. After it appears here, press Analyze plant above.</p>
                    <div class="w-14 h-1 bg-[#dca15d] rounded-full mt-4 mb-6"></div>

                    <div id="previewBox"
                        data-scanner-preview
                        class="relative w-full min-h-[220px] sm:min-h-[240px] bg-white/10 border border-white/14 rounded-2xl flex items-center justify-center overflow-hidden shadow-inner shadow-[#113e14]/16">
                        <div class="absolute left-5 top-5 h-3 w-3 rounded-full bg-[#a8b841] shadow-[0_0_18px_rgba(168,184,65,0.45)]"></div>
                        <div id="dropText" class="absolute px-5 text-center">
                            <p class="text-[#ebe3a7] text-sm font-black">Drop plant image here</p>
                            <p class="mt-2 text-white/58 text-xs font-semibold">Leaves, stem, and affected areas help the scan.</p>
                        </div>
                        <img id="previewImage" class="hidden max-w-full max-h-[420px] object-contain" alt="">
                    </div>

                    <div class="phone-scanner-status mt-6 space-y-4">
                        <div class="phone-scanner-status-main p-4 bg-white/10 border border-white/14 rounded-2xl">
                            <p class="text-white/60 text-sm">Step 2 - Status</p>
                            <p id="statusText" class="text-white font-bold">Waiting</p>
                        </div>

                        <div class="phone-scanner-metrics grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <div class="p-4 bg-white/10 border border-white/14 rounded-2xl">
                                <p class="text-white/60 text-sm">Confidence</p>
                                <p id="confidenceText" class="text-[#ebe3a7] font-bold">-</p>
                            </div>

                            <div class="p-4 bg-white/10 border border-white/14 rounded-2xl">
                                <p class="text-white/60 text-sm">Reliability</p>
                                <p id="reliabilityText" class="text-white font-black">-</p>
                            </div>
                        </div>

                        <div class="{{ isPremium ? 'bg-[#ebe3a7]/14 border-[#ebe3a7]/18' : 'bg-[#ebe3a7] border-[#ebe3a7]' }} p-4 border rounded-2xl">
                            <p class="text-white/60 text-sm">Plan</p>
                            <p class="{{ isPremium ? 'text-[#ebe3a7]' : 'text-[#113e14]' }} font-black">{{ subscription.planLabel }}</p>
                            <p id="usageText" class="{{ isPremium ? 'text-white/66' : 'text-[#416543]' }} mt-1 text-sm font-black">
                                {{ scannerUsage.unlimited ? 'Unlimited scans this month' : scannerUsage.remaining + ' of ' + scannerUsage.limit + ' scans left this month' }}
                            </p>
                            @if(!isPremium)
                                <p class="mt-1 text-xs font-bold text-[#416543]" data-scanner-reset>Restores on {{ scannerUsage.resetLabel }}</p>
                            @endif
                        </div>

                        @if(isPremium)
                            <div id="historyPanel" class="p-4 bg-white/10 border border-white/14 rounded-2xl">
                                <div class="flex items-center justify-between gap-3">
                                    <div>
                                        <p class="text-white/60 text-sm">Saved history</p>
                                        <p class="text-xs font-bold text-white/46">Premium records</p>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span id="historyCount" class="rounded-full bg-[#ebe3a7] px-2.5 py-1 text-xs font-black text-[#113e14]">{{ scanHistory.length }}</span>
                                        <button type="button" id="historyToggle" class="rounded-full bg-[#113e14] px-3 py-1.5 text-xs font-black text-[#ebe3a7] transition hover:bg-[#416543]" aria-expanded="false" aria-controls="historyContent">
                                            Show
                                        </button>
                                    </div>
                                </div>
                                <div id="historyContent" class="hidden">
                                    <div id="historyList" class="mt-3 space-y-2" data-history-list>
                                        @each(scan in scanHistory.slice(0, 3))
                                            <button type="button" data-history-card data-scan-id="{{ scan.id }}" class="block w-full rounded-xl bg-white/10 px-3 py-2 text-left transition hover:bg-[#ebe3a7]/18">
                                                <span class="block truncate text-sm font-black text-white">{{ scan.display_name }}</span>
                                                <span class="mt-1 block text-xs font-bold text-[#ebe3a7]/78">{{ scan.health_status }} - {{ scan.confidence }}% - {{ scan.created_at_label }}</span>
                                            </button>
                                        @end
                                    </div>
                                    <button type="button" id="historyMoreToggle" class="{{ scanHistory.length > 3 ? '' : 'hidden' }} mt-3 w-full rounded-full bg-[#ebe3a7] px-4 py-2 text-xs font-black text-[#113e14] transition hover:bg-white">
                                        Show {{ scanHistory.length > 3 ? scanHistory.length - 3 : 0 }} more records
                                    </button>
                                    <p id="historyEmpty" class="{{ scanHistory.length ? 'hidden' : '' }} mt-3 text-xs font-semibold leading-5 text-white/58">
                                        Your saved scans will appear here after the first analysis.
                                    </p>
                                </div>
                            </div>
                        @endif
                    </div>
                </div>
            </aside>

            <section class="phone-scanner-results relative min-w-0">
                <div class="absolute -inset-2 bg-white/10 blur-2xl rounded-[3rem]"></div>

                <div
                    class="relative h-full overflow-hidden bg-white/92 backdrop-blur-2xl border border-white/55 rounded-[3rem] p-6 text-[#113e14] shadow-[0_30px_80px_rgba(17,62,20,0.18)] lg:p-10">
                    <div class="scanner-results-edge absolute right-0 top-0 h-full w-1 bg-[#dca15d]/55"></div>
                    <div class="scanner-results-wash absolute left-0 top-0 h-28 w-full bg-gradient-to-b from-[#ebe3a7]/34 to-transparent pointer-events-none"></div>

                    <div class="relative mb-6">
                        <p class="text-sm font-black uppercase tracking-[0.22em] text-[#416543]">Plant Bud Lens</p>
                        <h2 class="mt-2 text-3xl font-black text-[#113e14]">Plant Intelligence</h2>
                        <p class="text-[#416543] font-semibold mt-2">Results move from a simple summary into saved care tracking and premium comparisons.</p>
                    </div>

                    <div id="loadingState" class="hidden text-center py-16">
                        <div class="w-14 h-14 mx-auto border-4 border-[#416543]/14 border-t-[#dca15d] rounded-full animate-spin"></div>
                        <p class="text-[#416543] mt-4 font-semibold">Analyzing plant...</p>
                    </div>

                    <div id="emptyState" class="text-center py-16 text-[#416543]">
                        <div class="scanner-empty-illustration">
                            <img src="/resources/images/essential/logo.png" alt="Plant Bud">
                        </div>
                        <p class="mt-5 text-2xl font-black text-[#113e14]">Your plant report will appear here</p>
                        <p class="text-sm mt-2 font-semibold">Choose a clear photo and run the analysis to see identification, health, and care guidance.</p>
                    </div>

                    <div id="resultsBox" class="hidden space-y-6" data-scanner-results>
                        <div class="scan-result-summary overflow-hidden rounded-2xl border border-[#416543]/12 bg-[#113e14] p-6 text-white shadow-sm">
                            <div class="scan-summary-layout flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                                <div class="mobile-scan-portrait" aria-hidden="true">
                                    <img id="resultPlantImage" alt="">
                                    <span id="mobileHealthStatus">Analyzed</span>
                                </div>
                                <div class="scan-summary-copy">
                                    <p class="text-sm font-black uppercase tracking-[0.18em] text-[#ebe3a7]">Scan summary</p>
                                    <h3 id="commonName" class="mt-2 text-3xl font-black">-</h3>
                                    <p id="scientificName" class="mt-1 text-sm font-semibold text-white/68">-</p>
                                </div>
                                <div class="mobile-confidence-orbit" id="mobileConfidenceOrbit">
                                    <span id="mobileConfidence">-</span>
                                    <small>confidence</small>
                                </div>
                                <div id="summaryChips" class="flex flex-wrap gap-2"></div>
                            </div>
                            <p id="scanSummaryText" class="mt-5 max-w-3xl text-sm font-semibold leading-6 text-white/72"></p>
                            <div class="scan-summary-actions mt-4 flex flex-wrap gap-2">
                                <div id="sourceLinks" class="flex flex-wrap gap-2"></div>
                            </div>
                        </div>

                        <div id="resultOverview" class="scan-result-overview grid grid-cols-1 md:grid-cols-3 gap-6" data-result-section>
                            <div class="bg-[#ebe3a7]/45 border border-[#416543]/12 rounded-2xl p-6 shadow-sm">
                                <p class="text-[#416543] text-sm font-bold">Common name</p>
                                <p id="commonNameCard" class="text-[#113e14] text-2xl font-black mt-2">-</p>
                            </div>

                            <div class="bg-[#416543]/8 border border-[#416543]/12 rounded-2xl p-6 shadow-sm">
                                <p class="text-[#416543] text-sm font-bold">Scientific match</p>
                                <p id="species" class="text-[#113e14] text-2xl font-black mt-2">-</p>
                            </div>

                            <div class="bg-white border border-[#416543]/12 rounded-2xl p-6 shadow-sm">
                                <p class="text-[#416543] text-sm font-bold">Health</p>
                                <p id="health" class="text-[#113e14] text-2xl font-black mt-2">-</p>
                            </div>
                        </div>

                        <section id="resultMatches" class="scan-result-matches rounded-2xl border border-[#416543]/12 bg-[#416543]/8 p-6 shadow-sm" data-result-section>
                            <div class="scan-section-heading">
                                <span>01</span>
                                <div>
                                    <small>Visual alternatives and confidence</small>
                                    <h3>Other AI matches</h3>
                                </div>
                            </div>
                            <div id="matches" class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-3"></div>
                        </section>

                        <div class="scan-result-split grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
                            <details id="resultAction" class="scan-result-action scan-result-disclosure bg-white border border-[#416543]/12 rounded-2xl p-6 shadow-sm" data-scan-disclosure data-mobile-open data-result-section open>
                                <summary class="scan-disclosure-summary">
                                    <span><small>Recommended next step</small><strong>Action plan</strong></span>
                                    <span class="scan-disclosure-icon" aria-hidden="true"></span>
                                </summary>
                                <div class="scan-disclosure-content">
                                <p class="text-[#113e14] font-black mb-3">Action plan</p>
                                <div id="actionPlan" class="space-y-3 text-sm font-semibold leading-6 text-[#416543]"></div>
                                </div>
                            </details>

                            <details id="resultTechnical" class="scan-result-taxonomy scan-result-disclosure bg-[#416543]/8 border border-[#416543]/12 rounded-2xl p-6 shadow-sm" data-scan-disclosure data-result-section open>
                                <summary class="scan-disclosure-summary">
                                    <span><small>Family, genus and rank</small><strong>Technical identity</strong></span>
                                    <span class="scan-disclosure-icon" aria-hidden="true"></span>
                                </summary>
                                <div class="scan-disclosure-content">
                                <p class="text-[#113e14] font-black mb-3">Taxonomy snapshot</p>
                                <div id="taxonomyGrid" class="grid gap-3 sm:grid-cols-2"></div>
                                </div>
                            </details>
                        </div>

                        <details id="resultHealth" class="scan-result-causes scan-result-disclosure bg-white border border-[#416543]/12 rounded-2xl p-6 shadow-sm" data-scan-disclosure data-result-section open>
                            <summary class="scan-disclosure-summary">
                                <span><small>Stress signals and treatments</small><strong>Possible problems</strong></span>
                                <span class="scan-disclosure-icon" aria-hidden="true"></span>
                            </summary>
                            <div class="scan-disclosure-content">
                            <p class="text-[#416543] text-sm font-black mb-3">Possible causes</p>
                            <ul id="causes" class="text-[#113e14]/78 list-disc ml-5 space-y-1"></ul>
                            <div id="diseaseCards" class="mt-4 grid gap-3 md:grid-cols-2"></div>
                            </div>
                        </details>

                        <details id="resultKnowledge" class="scan-result-education scan-result-disclosure bg-[#ebe3a7]/42 border border-[#416543]/12 rounded-2xl p-6 shadow-sm" data-scan-disclosure data-result-section open>
                            <summary class="scan-disclosure-summary">
                                <span><small>Description, facts and context</small><strong>Learn about this plant</strong></span>
                                <span class="scan-disclosure-icon" aria-hidden="true"></span>
                            </summary>
                            <div class="scan-disclosure-content">
                            <p class="text-[#113e14] font-black mb-3">Plant education</p>
                            <div id="education" class="text-[#113e14]/78 space-y-3 text-sm"></div>
                            </div>
                        </details>

                        <details id="resultCare" class="scan-result-guide scan-result-disclosure bg-[#416543]/8 border border-[#416543]/12 rounded-2xl p-6 shadow-sm" data-scan-disclosure data-result-section open>
                            <summary class="scan-disclosure-summary">
                                <span><small>Water, light, soil and propagation</small><strong>Everyday care guide</strong></span>
                                <span class="scan-disclosure-icon" aria-hidden="true"></span>
                            </summary>
                            <div class="scan-disclosure-content">
                            <p class="text-[#113e14] font-black mb-3">Care guide</p>
                            <ul id="tips" class="text-[#416543] list-disc ml-5 space-y-1"></ul>
                            </div>
                        </details>

                        <details id="premiumInsightsBox" class="premium-scan-dashboard scan-result-disclosure hidden bg-[#113e14] border border-[#416543]/12 rounded-2xl p-6 text-white shadow-sm" data-scan-disclosure open>
                            <summary class="premium-scan-header flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                                <div>
                                    <p class="text-sm font-black uppercase tracking-[0.18em] text-[#ebe3a7]">Premium dashboard</p>
                                    <h3 class="mt-2 text-2xl font-black">Saved scan intelligence</h3>
                                    <p class="mt-2 text-sm font-semibold leading-6 text-white/62">Understand the current condition, compare progress, and plan the next check.</p>
                                </div>
                                <span class="flex items-center gap-2">
                                    <span id="careScore" class="rounded-full bg-[#ebe3a7] px-4 py-2 text-sm font-black text-[#113e14]">-</span>
                                    <span class="scan-disclosure-icon scan-disclosure-icon-light" aria-hidden="true"></span>
                                </span>
                            </summary>

                            <div class="scan-disclosure-content">
                            <section class="premium-dashboard-section">
                                <p class="premium-dashboard-label">Current signals</p>
                                <div id="premiumDashboard" class="premium-dashboard-metrics mt-3 grid gap-3 md:grid-cols-4"></div>
                            </section>

                            <section class="premium-dashboard-section">
                                <p class="premium-dashboard-label">Progress over time</p>
                                <div id="premiumTimeline" class="premium-dashboard-timeline mt-3 rounded-2xl bg-white/10 p-4"></div>
                            </section>

                            <section class="premium-dashboard-section">
                                <p class="premium-dashboard-label">Change since the previous scan</p>
                                <div id="premiumBeforeAfter" class="premium-dashboard-before-after mt-3 rounded-2xl bg-white/10 p-4"></div>
                            </section>

                            <section class="premium-dashboard-section">
                                <p class="premium-dashboard-label">Interpretation and follow-up</p>
                                <div class="premium-dashboard-follow-up mt-3 grid gap-5 md:grid-cols-2">
                                <div class="premium-dashboard-comparisons rounded-2xl bg-white/10 p-4">
                                    <p class="font-black text-[#ebe3a7]">Comparisons</p>
                                    <div id="premiumComparisons" class="mt-3 space-y-2 text-sm font-semibold text-white/75"></div>
                                </div>
                                <div class="premium-dashboard-tracking rounded-2xl bg-white/10 p-4">
                                    <p class="font-black text-[#ebe3a7]">Tracking</p>
                                    <ul id="premiumTracking" class="mt-3 list-disc space-y-1 pl-5 text-sm font-semibold text-white/75"></ul>
                                    <p id="premiumFollowUp" class="mt-4 text-sm font-black text-white"></p>
                                </div>
                                </div>
                            </section>

                            <section class="premium-dashboard-section">
                                <p class="premium-dashboard-label">Personalized insights</p>
                                <div id="premiumCards" class="premium-dashboard-cards mt-3 grid gap-3 md:grid-cols-2"></div>
                            </section>
                            </div>
                        </details>

                        @if(!isPremium)
                            <div id="freeUpgradeBox" class="bg-[#113e14] border border-[#416543]/12 rounded-2xl p-6 text-white shadow-sm">
                                <p class="text-sm font-black uppercase tracking-[0.18em] text-[#ebe3a7]">Premium scanner</p>
                                <p class="mt-2 text-sm font-semibold leading-6 text-white/72">Upgrade to unlock timeline comparisons, before/after care scoring, richer saved scan detail, and unlimited monthly scans.</p>
                                <a href="/plans" class="mt-4 inline-flex rounded-full bg-[#dca15d] px-5 py-2.5 text-sm font-black text-[#113e14] transition hover:bg-[#ebe3a7]">See plans</a>
                            </div>
                        @endif
                    </div>
                </div>
            </section>
        </div>
    </main>
</div>

<script type="application/json" id="scannerHistoryData">{{{ scannerHistoryJson || '[]' }}}</script>
<script type="application/json" id="scannerPlanData">{{{ JSON.stringify({ isPremium }) }}}</script>
<form id="scannerHistoryDeleteToken" class="hidden" aria-hidden="true">
    {{ csrfField() }}
</form>
<div id="scanHistoryModal" class="scan-history-modal fixed inset-0 z-50 hidden items-center justify-center bg-[#113e14]/86 p-5 backdrop-blur-xl" aria-hidden="true">
    <div class="scan-history-dialog max-h-[90vh] w-full max-w-5xl overflow-y-auto rounded-[2rem] bg-[#fffaf0] p-5 text-[#113e14] shadow-[0_30px_90px_rgba(0,0,0,0.34)] md:p-7">
        <div class="scan-history-header flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.18em] text-[#416543]">Saved scan detail</p>
                <h2 id="historyModalTitle" class="mt-1 text-3xl font-black">Scan</h2>
                <p id="historyModalMeta" class="mt-1 text-sm font-bold text-[#416543]"></p>
            </div>
            <div class="flex gap-2">
                <button type="button" id="historyScanDelete" class="hidden rounded-full bg-[#dca15d] px-4 py-2 text-sm font-black text-[#113e14] shadow-sm transition hover:bg-[#ebe3a7]">
                    Delete
                </button>
                <button type="button" id="historyModalClose" class="flex h-10 w-10 items-center justify-center rounded-full bg-[#113e14] text-xl font-black text-[#ebe3a7] shadow-sm transition hover:bg-[#416543]" aria-label="Close scan detail">
                    x
                </button>
            </div>
        </div>

        <div id="historyModalBody" class="scan-history-body mt-6 space-y-5"></div>
    </div>
</div>
@!component('components/phone-camera-modal')
@vite(['resources/js/scanner.js'])
@end
