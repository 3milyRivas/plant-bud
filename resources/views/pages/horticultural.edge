@layout()
@slot('title')
<title>Plant Bud</title>
@endslot
@vite([
    'resources/js/categories.js',
    'resources/js/menu-plants.js'
])


<div class="relative overflow-x-hidden">
    @!component('components/header-plants', {
    title: "Discover Horticultural Plants",
    text: "Explore elegant tropical species, connect with gardeners and create beautiful green spaces.",
    imageBg:'resources/images/h2.jpg',
    careHref: '/care2',
    })

    <div class="flex justify-center mt-4">
        <div class="flex justify-center mt-20">
            <div
                class="relative flex items-center gap-4 bg-[#ebe3a7]/60 backdrop-blur-xl px-6 py-3 rounded-full shadow-lg border border-white/30">

                <button onclick="toggleMenu()"
                    class="relative z-50 w-11 h-11 rounded-full bg-[#a8b841] flex items-center justify-center shadow-md transition-all duration-300 hover:scale-110 hover:bg-[#ebe3a7]">
                    <img src="/plants/icon.vegetables.png" class="w-6 h-6" />
                </button>

                <div id="familias" class="flex gap-2">

                    <button onclick="showCategory(event, 'amaryllidaceae')"
                        class="category-btn px-4 py-2 rounded-full bg-[#113e14] text-white font-medium shadow transition-all duration-300 hover:scale-105">
                        Amaryllidaceae
                    </button>

                    <button onclick="showCategory(event, 'brassicaceae')"
                        class="category-btn px-4 py-2 rounded-full text-[#2D2B2B] transition-all duration-300 hover:scale-105 hover:bg-white/40">
                        Brassicaceae
                    </button>

                    <button onclick="showCategory(event, 'apiaceae')"
                        class="category-btn px-4 py-2 rounded-full text-[#2D2B2B] transition-all duration-300 hover:scale-105 hover:bg-white/40">
                        Apiaceae
                    </button>

                    <button onclick="showCategory(event, 'cucurbitaceae')"
                        class="category-btn px-4 py-2 rounded-full text-[#2D2B2B] transition-all duration-300 hover:scale-105 hover:bg-white/40">
                        Cucurbitaceae
                    </button>

                    <button onclick="showCategory(event, 'solanaceae')"
                        class="category-btn px-4 py-2 rounded-full text-[#2D2B2B] transition-all duration-300 hover:scale-105 hover:bg-white/40">
                        Solanaceae
                    </button>
                </div>


                <div id="menu"
                    class="hidden absolute inset-0 flex items-center justify-center gap-8 pl-16 bg-[#a8b841]/90 backdrop-blur-xl rounded-full shadow-md border border-white/20 z-40">

                    <a href="/ornamental"
                        class="menu-item group w-12 h-12 rounded-full  bg-[#ebe3a7] flex items-center justify-center transition-all duration-300 hover:scale-110">
                        <img src="/plants/icon.flower.png" class="w-6 h-6 transition-all duration-300" />
                    </a>

                    <a href="/horticultural"
                        class="menu-item group w-12 h-12 rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110">
                        <img src="/plants/icon.vegetables.png" class="w-6 h-6 transition-all duration-300" />
                    </a>

                    <a href="/succulent"
                        class="menu-item group w-12 h-12 rounded-full  bg-[#ebe3a7] flex items-center justify-center transition-all duration-300 hover:scale-110">
                        <img src="/plants/icon.plant.png" class="w-6 h-6 transition-all duration-300" />
                    </a>
                </div>
            </div>
        </div>
    </div>



    <div class="flex justify-center pt-20 pb-20">
        <div class="max-w-[1500px] w-full px-10 mx-auto flex justify-center">
            @each((plants, familyName, index) in horticulturalPlants)
            <div id="{{ familyName }}"
                class="category-section grid justify-center gap-12 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 {{ index != 0 ? 'hidden' : '' }}">
                @each((plant, plantIndex) in plants)
                <div id="plant-{{ familyName }}-{{ plantIndex }}"
                    class="plant-catalog-anchor scroll-mt-32 rounded-[42px] transition-all duration-500"
                    data-plant-card>
                    @component('components/plants/plant-card', {
                    imageSrc: plant.image,
                    imageAlt: plant.alt,
                    title: plant.name,
                    scientificName: plant.scientificName
                    })
                    @end
                </div>
                @endeach
            </div>
            @end

        </div>
    </div>
    @end
</div>