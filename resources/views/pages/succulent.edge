@layout()
@slot('title')
<title>Plant Bud</title>
@endslot
@vite(['resources/js/categories.js'])

<div class="relative overflow-x-hidden">
    @!component('components/header-plants', {
    title: "Discover Succulent Plants",
    text: "Explore elegant tropical species, connect with gardeners and create beautiful green spaces.",
    imageBg:'resources/images/suc-4.jpg',
    careHref: '/care3',
    })

    <div class="flex justify-center mt-4">
        <div class="flex justify-center mt-18">
            <div
                class="flex gap-3 bg-[#ffff]/80 backdrop-blur-md px-3 py-2 rounded-full shadow-inner shadow-[#48AE4D]/70">

                <div class="px-5 py-2 rounded-full bg-[#6b8c6b]/50 shadow-md">

                    <button onclick="showCategory(event, 'cactaceae')"
                        class="category-btn px-5 py-2 rounded-full bg-[#113e14] text-white font-medium shadow-md inline-block transition-all duration-300">
                        Cactaceae
                    </button>

                    <button onclick="showCategory(event, 'euphorbiaceae')"
                        class="category-btn px-5 py-2 rounded-full text-[#2D2B2B] hover:bg-white/50 transition-all duration-300">
                        Euphorbiaceae
                    </button>

                    <button onclick="showCategory(event, 'asparagaceae')"
                        class="category-btn px-5 py-2 rounded-full text-[#2D2B2B] hover:bg-white/50 transition-all duration-300">
                        Asparagaceae
                    </button>

                    <button onclick="showCategory(event, 'crassulaceae')"
                        class="category-btn px-5 py-2 rounded-full text-[#2D2B2B] hover:bg-white/50 transition-all duration-300">
                        Crassulaceae
                    </button>

                    <button onclick="showCategory(event, 'asphodelaceae')"
                        class="category-btn px-5 py-2 rounded-full text-[#2D2B2B] hover:bg-white/50 transition-all duration-300">
                        Asphodelaceae
                    </button>

                </div>
            </div>
        </div>
    </div>
</div>



<div class="flex justify-center pt-12 pb-20">
    <div class="flex justify-center gap-20 max-w-[1500px] w-full px-10">

        <div
            class="sticky top-[95px] shrink-0 w-[105px] h-[400px] rounded-[50px] bg-[#D3DCD3] backdrop-blur-xl border border-white/30 shadow-[#48AE4D] flex flex-col items-center justify-around">
            <a href="/ornamental"
                class="group w-20 h-20 rounded-full bg-white/50 backdrop-blur-md flex items-center justify-center transition-all duration-500 hover:scale-110 hover:bg-[#D3DCCB]">

                <img loading="lazy" decoding="async" src="/plants/icon.flower.png"
                    class="w-10 h-10 transition-all duration-500 group-hover:scale-110" />
            </a>

            <a href="/horticultural"
                class="group w-20 h-20 rounded-full bg-white/50 backdrop-blur-md flex items-center justify-center transition-all duration-500 hover:scale-110 hover:bg-[#D3DCCB]">
                <img loading="lazy" decoding="async" src="/plants/icon.vegetables.png"
                    class="w-10 h-10 transition-all duration-500 group-hover:scale-110" />
            </a>

            <a href="/succulent"
                class="group w-20 h-20 rounded-full bg-[#6C8E6B] flex items-center justify-center transition-all duration-500 hover:scale-110 hover:rotate-6">
                <img loading="lazy" decoding="async" src="/plants/icon.plant.png"
                    class="w-10 h-10 transition-all duration-500 group-hover:scale-110" />
            </a>
        </div>



        @each((plants, familyName, index) in succulentPlants)
        <div id="{{ familyName }}" class="category-section grid grid-cols-3 gap-12 {{ index != 0 ? 'hidden' : '' }}">
            @each((plant, plantIndex) in plants)
            <div id="plant-{{ familyName }}-{{ plantIndex }}" class="plant-catalog-anchor scroll-mt-32 rounded-[42px] transition-all duration-500" data-plant-card>
                @component('components/plants/plant-card', {
                imageSrc: plant.image,
                imageAlt: plant.alt,
                title: plant.name,
                scientificName: plant.scientificName
                })
                @end
            </div>
            @endeach
        </div>
        @end

    </div>
</div>
@end
