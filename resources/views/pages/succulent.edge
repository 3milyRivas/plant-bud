@layout()
@slot('title')
<title>Plant Bud</title>
@endslot
@vite(['resources/js/categories.js'])

<div class="relative overflow-x-hidden">
    @!component('components/header-plants', {
    title: "Discover Succulent Plants",
    text: "Explore elegant tropical species, connect with gardeners and create beautiful green spaces.",
    imageBg:'resources/images/suc-4.jpg',
    careHref: '/care3',
    })

    <div class="flex justify-center mt-4">
        <div class="flex justify-center mt-18">
    <div class="relative flex items-center gap-4 bg-[#ebe3a7]/60 backdrop-blur-xl px-6 py-3 rounded-full shadow-lg border border-white/30">

        <div class="relative flex items-center">

            <button onclick="toggleMenu()"
                class="w-11 h-11 rounded-full bg-[#113e14] flex items-center justify-center shadow-md transition-all duration-300 hover:scale-110 hover:bg-[#0c2c0f]">
                <img src="/plants/icon.plant.png" class="w-6 h-6" />
            </button>

            <div id="menu"
                class="hidden absolute top-full left-2 mt-2 flex items-center gap-3 bg-[#ebe3a7]/90 backdrop-blur-xl px-4 py-2 rounded-full shadow-md border border-white/20 transition-all duration-300">

                <a href="/ornamental"
                    class="group w-12 h-12 rounded-full bg-[#ebe3a7] flex items-center justify-center transition-all duration-300 hover:scale-110 hover:bg-[#8b8410]">
                    <img src="/plants/icon.flower.png"
                        class="w-6 h-6 transition-all duration-300 group-hover:scale-110" />
                </a>

                <a href="/horticultural"
                    class="group w-12 h-12 rounded-full bg-[#ebe3a7] flex items-center justify-center transition-all duration-300 hover:scale-110 hover:bg-[#8b8410]">
                    <img src="/plants/icon.vegetables.png"
                        class="w-6 h-6 transition-all duration-300 group-hover:scale-110" />
                </a>

                <a href="/succulent"
                    class="group w-12 h-12 rounded-full bg-[#a8b841] flex items-center justify-center transition-all duration-300 hover:scale-110 hover:rotate-3">
                    <img src="/plants/icon.plant.png"
                        class="w-6 h-6 transition-all duration-300 group-hover:scale-110" />
                </a>

            </div>
        </div>

        <div class="flex gap-2">

            <button onclick="showCategory(event, 'cactaceae')"
                class="category-btn px-4 py-2 rounded-full bg-[#113e14] text-white font-medium shadow transition-all duration-300 hover:scale-105">
                Cactaceae
            </button>

            <button onclick="showCategory(event, 'euphorbiaceae')"
                class="category-btn px-4 py-2 rounded-full text-[#2D2B2B] hover:bg-white/40 transition-all duration-300 hover:scale-105">
                Euphorbiaceae
            </button>

            <button onclick="showCategory(event, 'asparagaceae')"
                class="category-btn px-4 py-2 rounded-full text-[#2D2B2B] hover:bg-white/40 transition-all duration-300 hover:scale-105">
                Asparagaceae
            </button>

            <button onclick="showCategory(event, 'crassulaceae')"
                class="category-btn px-4 py-2 rounded-full text-[#2D2B2B] hover:bg-white/40 transition-all duration-300 hover:scale-105">
                Crassulaceae
            </button>

            <button onclick="showCategory(event, 'asphodelaceae')"
                class="category-btn px-4 py-2 rounded-full text-[#2D2B2B] hover:bg-white/40 transition-all duration-300 hover:scale-105">
                Asphodelaceae
            </button>

        </div>
    </div>
</div>

<script>
    function toggleMenu() {
        const menu = document.getElementById("menu");
        menu.classList.toggle("hidden")
    }
</script>

</div>


<div class="flex justify-center pt-12 pb-20">
    <div class="flex justify-center gap-20 max-w-[1500px] w-full px-10">

        <div
            class="sticky top-[95px] shrink-0 w-[105px] h-[400px] rounded-[50px] bg-[#ebe3a7] backdrop-blur-xl border border-white/30 shadow-[#48AE4D] flex flex-col items-center justify-around">
            <a href="/ornamental"
                class="group w-20 h-20 rounded-full bg-[#ebe3a7] backdrop-blur-md flex items-center justify-center transition-all duration-500 hover:scale-110 hover:bg-[#8b8410]">

                <img loading="lazy" decoding="async" src="/plants/icon.flower.png"
                    class="w-10 h-10 transition-all duration-500 group-hover:scale-110" />
            </a>

            <a href="/horticultural"
                class="group w-20 h-20 rounded-full bg-[#ebe3a7] backdrop-blur-md flex items-center justify-center transition-all duration-500 hover:scale-110 hover:bg-[#8b8410]">
                <img loading="lazy" decoding="async" src="/plants/icon.vegetables.png"
                    class="w-10 h-10 transition-all duration-500 group-hover:scale-110" />
            </a>

            <a href="/succulent"
                class="group w-20 h-20 rounded-full bg-[#a8b841] flex items-center justify-center transition-all duration-500 hover:scale-110 hover:rotate-6">
                <img loading="lazy" decoding="async" src="/plants/icon.plant.png"
                    class="w-10 h-10 transition-all duration-500 group-hover:scale-110" />
            </a>
        </div>



        @each((plants, familyName, index) in succulentPlants)
        <div id="{{ familyName }}" class="category-section grid grid-cols-3 gap-12 {{ index != 0 ? 'hidden' : '' }}">
            @each((plant, plantIndex) in plants)
            <div id="plant-{{ familyName }}-{{ plantIndex }}" class="plant-catalog-anchor scroll-mt-32 rounded-[42px] transition-all duration-500" data-plant-card>
                @component('components/plants/plant-card', {
                imageSrc: plant.image,
                imageAlt: plant.alt,
                title: plant.name,
                scientificName: plant.scientificName
                })
                @end
            </div>
            @endeach
        </div>
        @end

    </div>
</div>
@end
