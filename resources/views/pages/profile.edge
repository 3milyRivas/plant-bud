@layout()
@slot('title')
<title>Plant Bud - Profile</title>
@endslot

@let(displayName = accountProfile?.displayName || user.fullName || user.username)
@let(publicDisplayName = roleProfileKind === 'nursery' && roleProfile?.nurseryName ? roleProfile.nurseryName : displayName)
@let(profileBio = roleProfileKind === 'gardener' && roleProfile?.bio ? roleProfile.bio : (roleProfileKind === 'nursery' && roleProfile?.description ? roleProfile.description : accountProfile?.bio))
@let(avatarUrl = accountProfile?.avatarUrl || user.profilePicture)
@let(bannerUrl = accountProfile?.bannerUrl)
@let(memberSince = user.createdAt ? user.createdAt.toFormat('LLL yyyy') : 'Recently')

<div class="relative z-10 min-h-dvh overflow-hidden bg-[#416543] text-[#113e14]">
  <div class="fixed inset-0 pointer-events-none">
    <img src="/resources/images/welcome/header3.png" alt="" class="h-full w-full object-cover opacity-25">
    <div class="absolute inset-0 bg-gradient-to-b from-[#113e14]/80 via-[#416543]/80 to-[#416543]"></div>
    <div class="absolute left-10 top-24 h-72 w-72 rounded-full bg-[#ebe3a7]/10 blur-3xl"></div>
    <div class="absolute bottom-10 right-10 h-96 w-96 rounded-full bg-white/10 blur-3xl"></div>
  </div>

  @!component('components/app-navbar', {
    section: 'Profile',
    active: 'profile',
    maxWidth: 'max-w-[min(1500px,calc(100vw-2rem))]',
    avatarUrl,
    avatarInitial,
    displayName: publicDisplayName,
    roleLabel: user.role,
    items: [
      {
        key: 'homepage',
        href: '/homepage',
        label: 'Home',
        icon: '',
      },
      {
        key: 'community',
        href: '/community',
        label: 'Community',
        icon: '',
      },
      {
        key: 'settings',
