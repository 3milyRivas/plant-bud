  <div class="fixed inset-0 z-50 hidden items-center justify-center bg-[#1E3D19]/85 p-5 backdrop-blur-xl" data-avatar-cropper aria-hidden="true">
    <div class="w-full max-w-lg rounded-[2rem] bg-[#EDE7D6] p-5 text-[#1E3D19] shadow-[0_30px_90px_rgba(0,0,0,0.35)]">
