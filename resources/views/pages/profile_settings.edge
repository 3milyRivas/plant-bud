                <img id="avatar-preview" src="{{ avatarUrl }}" alt="" class="relative h-full w-full rounded-full border-4 border-white object-cover">
                <label for="avatar" class="absolute bottom-1 right-1 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-[#1E3D19] text-lg font-black text-white shadow-lg transition hover:bg-[#315F28]" title="Change photo">
                  +
                </label>
                <input id="avatar" name="avatar" type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-avatar-input data-preview-target="avatar-preview">
              </div>

              <span class="rounded-full bg-[#EDE7D6] px-3 py-2 text-xs font-black uppercase tracking-[0.14em] text-[#1E3D19]">
