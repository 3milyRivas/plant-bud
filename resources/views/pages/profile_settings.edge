                <h2 class="mt-2 text-3xl font-black text-[#113e14]">Public details</h2>
              </div>
              <span class="rounded-full bg-white px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-[#416543]">
                {{ roleProfile?.nurseryName || displayName }}
              </span>
            </div>

            <div class="mt-7 grid gap-5 md:grid-cols-2">
              <fieldset class="block">
                <legend class="text-sm font-black text-[#416543]">Profile status</legend>
                <div class="mt-2 grid gap-2 sm:grid-cols-2">
                  <label class="cursor-pointer">
                    <input type="radio" name="is_active" value="1" class="peer sr-only" {{ nurseryStatusValue === '1' ? 'checked' : '' }}>
                    <span class="flex min-h-12 items-center justify-center rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-center text-sm font-black text-[#113e14] transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">
                      Active
                    </span>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="is_active" value="0" class="peer sr-only" {{ nurseryStatusValue === '0' ? 'checked' : '' }}>
                    <span class="flex min-h-12 items-center justify-center rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-center text-sm font-black text-[#113e14] transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">
                      Not active
                    </span>
                  </label>
                </div>
              </fieldset>

              <label class="block">
                <span class="text-sm font-black text-[#416543]">Public phone</span>
                <input name="public_phone" value="{{ publicPhoneValue }}" maxlength="20" inputmode="numeric" placeholder="0000-0000" class="mt-2 h-12 w-full rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-sm font-bold text-[#113e14] outline-none transition focus:border-[#416543] focus:bg-white" data-phone-input>
                @if(errors.public_phone)
                  <span class="mt-2 block text-xs font-bold text-red-700">{{ errors.public_phone[0] }}</span>
                @endif
              </label>

              <label class="block">
                <span class="text-sm font-black text-[#416543]">Public email</span>
                <input name="public_email" value="{{ publicEmailValue }}" maxlength="254" type="email" placeholder="hello@nursery.com" class="mt-2 h-12 w-full rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-sm font-bold text-[#113e14] outline-none transition focus:border-[#416543] focus:bg-white">
                @if(errors.public_email)
                  <span class="mt-2 block text-xs font-bold text-red-700">{{ errors.public_email[0] }}</span>
                @endif
              </label>

              <label class="block">
                <span class="text-sm font-black text-[#416543]">City</span>
                <input name="city" value="{{ cityValue }}" maxlength="120" placeholder="Santa Tecla" class="mt-2 h-12 w-full rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-sm font-bold text-[#113e14] outline-none transition focus:border-[#416543] focus:bg-white">
                @if(errors.city)
                  <span class="mt-2 block text-xs font-bold text-red-700">{{ errors.city[0] }}</span>
                @endif
              </label>
            </div>

            <label class="mt-5 block">
              <span class="text-sm font-black text-[#416543]">Address</span>
              <input name="address" value="{{ addressValue }}" maxlength="255" placeholder="Street, local reference, or pickup point" class="mt-2 h-12 w-full rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-sm font-bold text-[#113e14] outline-none transition focus:border-[#416543] focus:bg-white">
              @if(errors.address)
                <span class="mt-2 block text-xs font-bold text-red-700">{{ errors.address[0] }}</span>
              @endif
            </label>

            <div class="mt-5 grid gap-5 md:grid-cols-2">
              <label class="block">
                <span class="text-sm font-black text-[#416543]">Products and services</span>
                <textarea name="services_offered" maxlength="1200" rows="4" placeholder="Indoor plants&#10;Succulents&#10;Soil mixes&#10;Plant delivery" class="mt-2 w-full resize-none rounded-2xl border border-[#a8b841] bg-white/70 px-4 py-3 text-sm font-bold leading-6 text-[#113e14] outline-none transition focus:border-[#416543] focus:bg-white">{{ servicesValue }}</textarea>
                @if(errors.services_offered)
                  <span class="mt-2 block text-xs font-bold text-red-700">{{ errors.services_offered[0] }}</span>
                @endif
              </label>

              <div class="block" data-weekly-schedule>
                <span class="text-sm font-black text-[#416543]">Opening hours</span>
                <input type="hidden" name="opening_hours" value="{{ openingHoursValue }}" data-weekly-schedule-value maxlength="255">
                <div class="mt-2 rounded-2xl border border-[#a8b841] bg-white/70 p-3 text-[#113e14]">
                  <div class="grid gap-3" data-weekly-schedule-main>
                    <div class="grid grid-cols-7 gap-1.5" data-weekly-schedule-days>
                      @each(day in [
                        { key: 'mon', label: 'Lun', checked: true },
                        { key: 'tue', label: 'Mar', checked: true },
                        { key: 'wed', label: 'Mie', checked: true },
                        { key: 'thu', label: 'Jue', checked: true },
                        { key: 'fri', label: 'Vie', checked: true },
                        { key: 'sat', label: 'Sab', checked: false },
                        { key: 'sun', label: 'Dom', checked: false },
                      ])
                        <label class="cursor-pointer">
                          <input type="checkbox" value="{{ day.key }}" class="peer sr-only" data-weekly-schedule-day {{ day.checked ? 'checked' : '' }}>
                          <span class="flex h-10 items-center justify-center rounded-xl border border-[#a8b841] bg-white/70 text-xs font-black text-[#113e14] transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">
                            {{ day.label }}
                          </span>
                        </label>
                      @endeach
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2">
                      <label>
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Desde</span>
                        <input type="time" value="07:00" class="mt-1 h-11 w-full rounded-xl border border-[#a8b841] bg-white px-3 text-sm font-black text-[#113e14] outline-none focus:border-[#416543]" data-weekly-schedule-start>
                      </label>
                      <label>
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Hasta</span>
                        <input type="time" value="15:00" class="mt-1 h-11 w-full rounded-xl border border-[#a8b841] bg-white px-3 text-sm font-black text-[#113e14] outline-none focus:border-[#416543]" data-weekly-schedule-end>
                      </label>
                    </div>
                    <div class="flex flex-wrap gap-2">
                      <button type="button" class="rounded-full bg-[#113e14] px-4 py-2 text-xs font-black text-[#ebe3a7] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#416543]" data-weekly-schedule-preset="weekdays">Lun-Vie</button>
                      <button type="button" class="rounded-full bg-white px-4 py-2 text-xs font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]" data-weekly-schedule-preset="all">Toda semana</button>
                      <button type="button" class="rounded-full bg-white px-4 py-2 text-xs font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]" data-weekly-schedule-toggle-weekend>Fin de semana</button>
                    </div>
                  </div>

                  <div class="mt-3 hidden rounded-2xl border border-[#a8b841]/70 bg-[#ebe3a7]/55 p-3" data-weekly-schedule-weekend>
                    <div class="flex items-center justify-between gap-3">
                      <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Horario extra</span>
                      <button type="button" class="text-xs font-black text-[#113e14] underline decoration-[#dca15d] decoration-2 underline-offset-4" data-weekly-schedule-remove-weekend>Quitar</button>
                    </div>
                    <div class="mt-3 grid grid-cols-2 gap-2" data-weekly-schedule-days>
                      <label class="cursor-pointer">
                        <input type="checkbox" value="sat" class="peer sr-only" data-weekly-schedule-day checked>
                        <span class="flex h-10 items-center justify-center rounded-xl border border-[#a8b841] bg-white/70 text-xs font-black text-[#113e14] transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">Sab</span>
                      </label>
                      <label class="cursor-pointer">
                        <input type="checkbox" value="sun" class="peer sr-only" data-weekly-schedule-day checked>
                        <span class="flex h-10 items-center justify-center rounded-xl border border-[#a8b841] bg-white/70 text-xs font-black text-[#113e14] transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">Dom</span>
                      </label>
                    </div>
                    <div class="mt-3 grid gap-3 sm:grid-cols-2">
                      <label>
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Desde</span>
                        <input type="time" value="08:00" class="mt-1 h-11 w-full rounded-xl border border-[#a8b841] bg-white px-3 text-sm font-black text-[#113e14] outline-none focus:border-[#416543]" data-weekly-schedule-start>
                      </label>
                      <label>
                        <span class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]">Hasta</span>
                        <input type="time" value="12:00" class="mt-1 h-11 w-full rounded-xl border border-[#a8b841] bg-white px-3 text-sm font-black text-[#113e14] outline-none focus:border-[#416543]" data-weekly-schedule-end>
                      </label>
                    </div>
                  </div>

                  <p class="mt-3 rounded-xl bg-white px-3 py-2 text-sm font-black leading-6 text-[#416543]" data-weekly-schedule-preview>{{ openingHoursValue || 'Pendiente' }}</p>
                </div>
                @if(errors.opening_hours)
                  <span class="mt-2 block text-xs font-bold text-red-700">{{ errors.opening_hours[0] }}</span>
                @endif
              </div>
            </div>

            <div class="mt-5 block" data-payment-methods>
              <span class="text-sm font-black text-[#416543]">Payment methods</span>
              <input type="hidden" name="payment_methods" value="{{ paymentMethodsValue }}" data-payment-methods-value>
              <div class="mt-2 grid gap-2 sm:grid-cols-3">
                <label class="cursor-pointer">
                  <input type="checkbox" value="Cash" class="peer sr-only" data-payment-method-checkbox {{ paymentMethodsLower.includes('cash') ? 'checked' : '' }}>
                  <span class="flex min-h-12 items-center justify-center rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-center text-sm font-black text-[#113e14] transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">Cash</span>
                </label>
                <label class="cursor-pointer">
                  <input type="checkbox" value="Paypal" class="peer sr-only" data-payment-method-checkbox {{ paymentMethodsLower.includes('paypal') ? 'checked' : '' }}>
                  <span class="flex min-h-12 items-center justify-center rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-center text-sm font-black text-[#113e14] transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">Paypal</span>
                </label>
                <label class="cursor-pointer">
                  <input type="checkbox" value="Card" class="peer sr-only" data-payment-method-checkbox {{ paymentMethodsLower.includes('card') ? 'checked' : '' }}>
                  <span class="flex min-h-12 items-center justify-center rounded-2xl border border-[#a8b841] bg-white/70 px-4 text-center text-sm font-black text-[#113e14] transition peer-checked:border-[#113e14] peer-checked:bg-[#113e14] peer-checked:text-[#ebe3a7] peer-focus-visible:ring-2 peer-focus-visible:ring-[#dca15d]">Card</span>
                </label>
              </div>
              @if(errors.payment_methods)
                <span class="mt-2 block text-xs font-bold text-red-700">{{ errors.payment_methods[0] }}</span>
              @endif
            </div>
          </div>
        @endif

        <div class="rounded-[2.5rem] border border-white/10 bg-white/12 p-6 text-white shadow-xl backdrop-blur-2xl">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-sm font-black uppercase tracking-[0.18em] text-[#ebe3a7]">Linked accounts</p>
              <h2 class="mt-2 text-2xl font-black">Social profiles</h2>
            </div>
            <p class="max-w-sm text-sm font-semibold leading-6 text-white/70">Write only the username or paste the profile URL.</p>
          </div>

          <div class="mt-6 space-y-4">
            <label class="grid gap-3 md:grid-cols-[9rem_1fr] md:items-start">
              <span class="flex h-12 items-center rounded-2xl bg-[#ebe3a7] px-4 text-sm font-black text-[#113e14]">Instagram</span>
              <span>
                <input name="instagram_handle" value="{{ instagramHandle }}" maxlength="120" placeholder="plantbud.sv" class="h-12 w-full rounded-2xl border border-white/10 bg-white/90 px-4 text-sm font-bold text-[#113e14] outline-none focus:bg-white" data-social-handle>
                @if(errors.instagram_handle)
                  <span class="mt-2 block text-xs font-bold text-red-200">{{ errors.instagram_handle[0] }}</span>
                @endif
              </span>
            </label>

            <label class="grid gap-3 md:grid-cols-[9rem_1fr] md:items-start">
              <span class="flex h-12 items-center rounded-2xl bg-[#ebe3a7] px-4 text-sm font-black text-[#113e14]">TikTok</span>
              <span>
                <input name="tiktok_handle" value="{{ tiktokHandle }}" maxlength="120" placeholder="@plantbud" class="h-12 w-full rounded-2xl border border-white/10 bg-white/90 px-4 text-sm font-bold text-[#113e14] outline-none focus:bg-white" data-social-handle>
                @if(errors.tiktok_handle)
                  <span class="mt-2 block text-xs font-bold text-red-200">{{ errors.tiktok_handle[0] }}</span>
                @endif
              </span>
            </label>

            <label class="grid gap-3 md:grid-cols-[9rem_1fr] md:items-start">
              <span class="flex h-12 items-center rounded-2xl bg-[#ebe3a7] px-4 text-sm font-black text-[#113e14]">Facebook</span>
              <span>
                <input name="facebook_handle" value="{{ facebookHandle }}" maxlength="120" placeholder="plantbud.sv" class="h-12 w-full rounded-2xl border border-white/10 bg-white/90 px-4 text-sm font-bold text-[#113e14] outline-none focus:bg-white" data-social-handle>
                @if(errors.facebook_handle)
                  <span class="mt-2 block text-xs font-bold text-red-200">{{ errors.facebook_handle[0] }}</span>
                @endif
              </span>
            </label>
          </div>
        </div>
      </section>
    @end
  </main>

  <div class="fixed inset-0 z-50 hidden items-center justify-center bg-[#113e14]/85 p-5 backdrop-blur-xl" data-avatar-cropper aria-hidden="true">
    <div class="w-full max-w-lg rounded-[2rem] bg-[#ebe3a7] p-5 text-[#113e14] shadow-[0_30px_90px_rgba(0,0,0,0.35)]">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#416543]">Profile photo</p>
          <h2 class="mt-1 text-2xl font-black">Crop square</h2>
        </div>
        <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-xl font-black text-[#113e14] shadow-sm transition hover:bg-[#ebe3a7]" data-avatar-cancel aria-label="Close cropper">
          x
        </button>
      </div>

      <div class="mt-5 rounded-[1.5rem] bg-white/60 p-3">
        <div class="relative mx-auto aspect-square w-full max-w-sm touch-none overflow-hidden rounded-[1.25rem] bg-[#113e14]/10" data-avatar-crop-frame>
          <img src="" alt="" class="absolute left-0 top-0 max-w-none select-none" data-avatar-crop-image draggable="false">
          <div class="pointer-events-none absolute inset-0 rounded-[1.25rem] ring-2 ring-white/95"></div>
        </div>
      </div>

      <label class="mt-5 block">
        <span class="text-sm font-black text-[#416543]">Zoom</span>
        <input type="range" min="1" max="3" step="0.01" value="1" class="mt-2 w-full accent-[#113e14]" data-avatar-zoom>
      </label>

      <div class="mt-5 flex justify-end gap-3">
        <button type="button" class="rounded-full bg-white px-5 py-2.5 text-sm font-black text-[#113e14] shadow-sm transition hover:bg-[#ebe3a7]" data-avatar-cancel>
          Cancel
        </button>
        <button type="button" class="rounded-full bg-[#dca15d] px-5 py-2.5 text-sm font-black text-[#113e14] shadow-lg transition hover:bg-[#ebe3a7]" data-avatar-apply>
          Apply crop
        </button>
      </div>
    </div>
  </div>
</div>
@end
