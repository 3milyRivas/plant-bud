            </div>

            <h1 class="mt-5 text-3xl font-black text-white">{{ displayName }}</h1>
            <p class="mt-1 text-sm font-bold text-[#EDE7D6]">{{ '@' + user.username }}</p>

            @if(errors.avatar)
