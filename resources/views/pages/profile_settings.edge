      <section class="space-y-6">
        <div class="overflow-hidden rounded-[2.5rem] border border-white/10 bg-white/12 shadow-[0_30px_90px_rgba(0,0,0,0.22)] backdrop-blur-3xl">
          <div class="relative h-56 overflow-hidden">
            <img id="banner-preview" src="{{ bannerUrl }}" alt="" class="absolute inset-0 block h-full max-h-full w-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-[#1E3D19]/80 via-[#1E3D19]/10 to-transparent"></div>
            <label for="banner" class="absolute right-4 top-4 cursor-pointer rounded-full bg-[#EDE7D6] px-4 py-2 text-sm font-black text-[#1E3D19] shadow-lg transition hover:scale-[1.02]">
              Change banner
            </label>
            <input id="banner" name="banner" type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-profile-file-input data-preview-target="banner-preview">
          </div>

          <div class="px-6 pb-6 pt-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
