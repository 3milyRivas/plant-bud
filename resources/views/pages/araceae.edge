                        <img src="resources/images/plants/icon.vegetables.png" class="w-8" />
                    </div>
                </a>

                <a href="/cactaceae">
                    <img src="resources/images/plants/icon.plant.png"
                        class="absolute bottom-12 left-1/2 -translate-x-1/2 w-8" />
                </a>
            </div>


            <div class="grid grid-rows-6 gap-12">

                <div class="flex gap-12 pl-14">

                    <div
                        class="bg-[#D3DCCB] w-[240px] rounded-[50px] p-6 flex flex-col items-center relative overflow-hidden relative overflow-hidden transition-all duration-500 ease-in-out hover:-translate-y-1 hover:scale-101 active:translate-y-0 active:scale-105">

                        <div class="w-full rounded-[20px] p-[0.5]">
                            <img src="resources/images/plants/araceae/adventure.png" alt="adventure"
