                            <div class="overflow-hidden rounded-[30px] shadow-[0_12px_30px_rgba(0,0,0,0.16)]">
                                <img loading="lazy" decoding="async" src="resources/images/plants/zamiaceae/fer.png"
                                    alt="" class="w-full h-[220px] object-cover
                                 transition-all duration-700 group-hover:scale-110">
                            </div>
                        </div>
                        <div class="px-6 pb-6 flex flex-col">
                            <h3 class="text-[21px] leading-tight font-abril text-[#113e14]">
                                Byfield Fern
                            </h3>

                            <div class="mt-3 w-14 h-[3px]
                             rounded-full bg-[#48ae4d]/70">
                            </div>
                            <div class="mt-7">
                                <p class="text-[10px] uppercase tracking-[4px] text-[#636863] font-semibold">
                                    Scientific Name
                                </p>
                                <p class="mt-2 text-[15px] leading-relaxed text-[#113e14]/80">
                                    Bowenia serrulata
                                </p>
                            </div>
                            <button
                                class="mt-7 py-3.5 bg-[#113E14] font-abril text-xl text-[#D3DCD3] rounded-full transition-all duration-300 ease-in-out hover:-translate-y-1 
                                hover:scale-110 active:translate-y-0 active:scale-105 shadow-md hover:shadow-[0_0_15px_4px_rgba(72,174,77,0.6),0_0_30px_8px_rgba(72,174,77,0.4)] active:shadow-[0_0_8px_2px_rgba(72,174,77,0.5)]">
                                Acquire
                            </button>
                        </div>
                    </div>
                </div>

            </div>


        </div>
    </div>
</div>
</div>


@end