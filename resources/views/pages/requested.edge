<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Notification</title>
</head>

<body class="bg-[#6B8C6C] min-h-screen flex flex-col">

  <div class="mt-12 left-0 w-full z-50 px-10">
    <div class="backdrop-blur-xl bg-white/20 border border-white/30
              rounded-full px-8 py-4 flex items-center justify-between shadow-lg">

      <!-- Logo -->
      <div class="w-20 h-20 bg-[url('/img/img2.png')] bg-contain bg-no-repeat"></div>


      <div class="flex items-center gap-2">

        <div class="bg-white/70 rounded-full px-6 py-2 w-[350px] flex items-center">
          <input type="text" placeholder="Search plants" class="bg-transparent outline-none flex-grow
                    text-[#113E14] placeholder:text-[#6B8C6C]/70 text-sm">


        </div>
        <button class="w-8 h-8 rounded-full bg-[#113E14]
                     flex items-center justify-center hover:bg-[#1b5420]
                     transition duration-300 shadow-md ml-2">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 21l-4.35-4.35m1.85-5.65a7.5 7.5 0 11-15 0 7.5 7.5 0 0115 0z" />
          </svg>
        </button>
      </div>


      <div class="w-20 h-20 bg-[url('/img/img2.png')] bg-cover bg-center rounded-lg"></div>
    </div>
  </div>

  <div class="mx-14">
    <div class="relative bg-[url('/img/img.png')] bg-cover bg-center h-[60vh] w-full rounded-xl shadow-lg mt-8">

      <div class="absolute inset-0 flex flex-col justify-center items-start px-12 space-y-4">
        <h2 class="text-4xl font-bold text-white drop-shadow-lg">
          Discover ornamental plants.
        </h2>
        <p class="text-lg text-white max-w-xl">
          Explore elegant tropical species, connect with gardeners and create beautiful green spaces.
        </p>


        <button
          class="bg-[#113E14] text-white font-semibold px-8 py-3 rounded-full shadow-md hover:bg-[#1b5420] transition">
          Care
        </button>
      </div>
    </div>
  </div>



  <div class="flex bg-[#6C8E6B]/80 mx-12 py-10 space-x-6">

    <div class="m-8 w-full flex bg-white/70 rounded-3xl shadow-lg p-6 space-x-6 flex flex-col">
      <h1
        class="text-center font-bold text-5xl font-poppins bg-gradient-to-r from-[#667C63] to-[#1E251E] bg-clip-text text-transparent">
        Request your service</h1>


      <!-- Perfil -->
      <div class="flex flex-grow space-x-4 my-10 mx-10">
        <div
          class="w-[300px] h-[300px] bg-[url('/img/phot.jpg')] bg-cover bg-center rounded-full border-4 border-white shadow-md">
        </div>

        <div class="flex items-center p-6 space-x-6">

          <div class="w-20 h-20 bg-[url('/img/foto.png')] bg-cover bg-center rounded-full"></div>
          <div class="flex">
            <div class="w-[100px] h-[100px] bg-[url('/img/img3.png')] bg-contain bg-no-repeat"></div>
            <div class="flex flex-col">
              <div class="flex items-center space-x-2 my-5">
                <span class="text-4xl font-bold text-[#113E14]">Laura Valentina Díaz Morales</span>
              </div>


              <div class="flex items-center space-x-2 text-sm text-green-700">
                <span class="font-semibold text-lg text-[#113E14]">Garden Restoration</span>

                <div class="w-4 h-4 bg-[url('/img/punto.png')] bg-contain bg-no-repeat"></div>
                <span class="font-semibold text-lg text-[#113E14]">5 years of experience</span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <div class="flex flex-col space-y-2">
        <label class="text-black/60 font-semibold">What is your problem?</label>
        <input type="text" placeholder="Type your problem"
          class="bg-white/50 h-[150px] rounded-xl px-4 py-2 outline-none text-sm">
      </div>

      <div class="flex justify-center space-x-4">
        <div class="flex bg-[#d6ddd5] p-10 gap-16 w-full max-w-5xl">

          <div class="flex-1">
            <div class="relative w-full">
              <label class="absolute -top-2 left-3 bg-[#d6ddd5] px-1 text-[11px] text-purple-700 z-10">
                When do you need me?
              </label>


              <div class="flex items-center justify-between border-2 border-purple-600 rounded-sm px-3 py-2">
                <span class="text-sm text-gray-700">
                  08/17/2025
                </span>


                <button class="w-5 h-5 bg-[url('/img/cal.png')] bg-contain bg-center bg-no-repeat opacity-70"></button>
              </div>

              <div class="w-full mt-4 w-[250px] rounded-[28px] bg-[#f6eef8] p-5 shadow-xl">


                <div class="flex items-center justify-between mb-6">

                  <button class="w-4 h-4 bg-[url('/img/fizquielda.png')] bg-contain bg-center bg-no-repeat"></button>

                  <div class="flex items-center gap-1">

                    <span class="text-sm text-gray-700">
                      Aug
                    </span>

                    <div class="w-3 h-3 bg-[url('/img/fabajo.png')] bg-contain bg-center bg-no-repeat opacity-60">
                    </div>

                  </div>


                  <div class="flex items-center gap-1">

                    <span class="text-sm text-gray-700">
                      2025
                    </span>

                    <div class="w-3 h-3 bg-[url('/img/fabajo.png')] bg-contain bg-center bg-no-repeat opacity-60">
                    </div>

                  </div>

                  <button
                    class="w-4 h-4 bg-[url('/img/fdelecha.png')] bg-contain bg-center bg-no-repeat opacity-70"></button>

                </div>


                <div class="grid grid-cols-7 text-center text-[11px] text-gray-500 mb-4">
                  <span>S</span>
                  <span>M</span>
                  <span>T</span>
                  <span>W</span>
                  <span>T</span>
                  <span>F</span>
                  <span>S</span>
                </div>

                <div class="grid grid-cols-7 gap-y-3 text-sm text-center">


                  <span class="text-gray-300">26</span>
                  <span class="text-gray-300">27</span>
                  <span class="text-gray-300">28</span>
                  <span class="text-gray-300">29</span>
                  <span class="text-gray-300">30</span>
                  <span class="text-gray-300">31</span>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    1
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    2
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    3
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    4
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    5
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    6
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    7
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    8
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    9
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    10
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    11
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    12
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    13
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    14
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    15
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    16
                  </button>

                  <!-- SELECTED -->
                  <button class="w-8 h-8 mx-auto rounded-full bg-purple-600 text-white shadow-md">
                    17
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    18
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    19
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    20
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    21
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    22
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    23
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    24
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    25
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    26
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    27
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    28
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    29
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    30
                  </button>

                  <button class="w-8 h-8 mx-auto rounded-full hover:bg-purple-100 transition">
                    31
                  </button>


                  <span class="text-gray-300">1</span>
                  <span class="text-gray-300">2</span>
                  <span class="text-gray-300">3</span>
                  <span class="text-gray-300">4</span>
                  <span class="text-gray-300">5</span>
                  <span class="text-gray-300">6</span>

                </div>


                <div class="flex justify-end gap-7 mt-7 text-sm">

                  <button class="text-purple-600 font-medium hover:opacity-70 transition">
                    Cancel
                  </button>

                  <button class="text-purple-600 font-medium hover:opacity-70 transition">
                    OK
                  </button>

                </div>

              </div>
            </div>
          </div>

          
          <div class="flex-1 flex flex-col gap-6">


            <div>

              <p class="mb-2 text-black/60 font-semibold">
                How much budget do you have?
              </p>

              <div class="bg-white/70 rounded-xl px-4 py-3 flex items-center gap-3">

                <div class="w-6 h-6 bg-[url('/img/money.png')] bg-contain bg-center bg-no-repeat opacity-70"></div>

                <input type="text" placeholder="Type your budget" class="outline-none bg-transparent text-sm" />

              </div>
            </div>


            <div>

              <p class="mb-2 text-black/60 font-semibold">
                Where are you?
              </p>

              <div class="bg-white/70 rounded-xl px-4 py-3 flex items-center gap-3">


                <div class="w-6 h-6 bg-[url('/img/map.png')] bg-contain bg-center bg-no-repeat opacity-70">
                </div>

                <input type="text" placeholder="Type your location" class="outline-none bg-transparent text-sm" />

              </div>
            </div>


            <div class="w-64 h-64 bg-[url('/img/img2.png')] mx-auto bg-contain bg-center bg-no-repeat"></div>

          </div>
        </div>

      </div>

      <button
        class="bg-[#113E14] text-white font-semibold px-8 py-3 rounded-full shadow-md hover:bg-[#1b5420] transition self-end">
        Submit the form
      </button>
    </div>
  </div>



</body>

</html>