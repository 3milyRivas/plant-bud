@layout()
@slot('title')
<title>Service Requests</title>
@endslot

<div class="relative z-10 min-h-screen px-6 py-8 text-[#113E14]">
  <header class="mx-auto flex max-w-7xl flex-col gap-6 rounded-[34px] border border-white/40 bg-white/24 p-6 shadow-2xl backdrop-blur-2xl md:flex-row md:items-center md:justify-between">
    <a href="/homepage" class="flex items-center gap-4">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/80 shadow-lg">
        <img src="/resources/images/essential/logo.png" alt="" class="h-10 w-10 object-contain">
      </span>
      <span>
        <span class="block text-2xl font-black text-white">Plant Bud</span>
        <span class="block text-xs font-black uppercase tracking-[0.18em] text-[#EDE7D6]">Requests</span>
      </span>
    </a>

    <nav class="flex flex-wrap gap-3">
      <a href="/homepage" class="rounded-full bg-white/18 px-5 py-2.5 text-sm font-black text-white transition hover:bg-white/28">Home</a>
      <a href="/community" class="rounded-full bg-white/18 px-5 py-2.5 text-sm font-black text-white transition hover:bg-white/28">Community</a>
      <a href="/profile" class="rounded-full bg-[#EDE7D6] px-5 py-2.5 text-sm font-black text-[#113E14] transition hover:-translate-y-0.5">Profile</a>
    </nav>
  </header>

  <main class="mx-auto max-w-7xl py-10">
    <section class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="rounded-[38px] bg-[#113E14] p-8 text-white shadow-2xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-[#EDE7D6]">Today</p>
        <h1 class="mt-4 font-abril text-5xl leading-tight">Service request board</h1>
        <p class="mt-5 text-base font-semibold leading-7 text-white/76">
          Keep client requests visible, organized, and ready for follow-up before the next appointment.
        </p>

        <div class="mt-8 grid grid-cols-3 gap-3">
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="text-3xl font-black">{{ stats.pending }}</p>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-white/60">Pending</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="text-3xl font-black">{{ stats.scheduled }}</p>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-white/60">Scheduled</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="text-3xl font-black">{{ stats.thisWeek }}</p>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-white/60">This week</p>
          </div>
        </div>
      </div>

      <div class="grid gap-5">
        @each(serviceRequest in requests)
          <article class="rounded-[28px] border border-white/40 bg-white/75 p-6 shadow-xl backdrop-blur-2xl">
            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
              <div>
                <p class="text-sm font-black uppercase tracking-[0.18em] text-[#6B8C6C]">{{ serviceRequest.serviceTypeLabel }}</p>
                <h2 class="mt-2 text-2xl font-black">{{ serviceRequest.clientName }} scheduled you</h2>
                <p class="mt-3 max-w-2xl text-sm font-semibold leading-6 text-[#456143]">
                  {{ serviceRequest.notes }}
                </p>
              </div>
              <span class="{{ serviceRequest.status === 'scheduled' ? 'bg-[#113E14] text-white' : 'bg-[#EDE7D6] text-[#113E14]' }} rounded-full px-4 py-2 text-xs font-black uppercase tracking-[0.14em]">
                {{ serviceRequest.statusLabel }}
              </span>
            </div>

            <div class="mt-5 grid gap-3 text-sm font-bold text-[#456143] sm:grid-cols-3">
              <span>Budget: {{ serviceRequest.budget }}</span>
              <span>{{ serviceRequest.address }}</span>
              <span>{{ serviceRequest.scheduledFor }}</span>
            </div>

            <div class="mt-5 grid gap-3 rounded-2xl bg-white/60 p-4 text-sm font-semibold text-[#456143] sm:grid-cols-3">
              <span>Client: {{ serviceRequest.clientName }}</span>
              <span>{{ serviceRequest.clientPhone }}</span>
              <span>{{ serviceRequest.clientEmail }}</span>
            </div>

            <p class="mt-4 text-xs font-bold uppercase tracking-[0.14em] text-[#6B8C6C]">
              Requested {{ serviceRequest.createdAt }}
            </p>
          </article>
        @else
          <article class="rounded-[28px] border border-white/40 bg-white/75 p-8 text-center shadow-xl backdrop-blur-2xl">
            <h2 class="text-2xl font-black">No requests yet</h2>
            <p class="mt-3 text-sm font-semibold leading-6 text-[#456143]">
              When a client sends a request from your gardener profile, it will appear here with their contact details.
            </p>
          </article>
        @end
      </div>
    </section>
  </main>
</div>
@end
