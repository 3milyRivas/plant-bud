@layout()
@slot('title')
<title>Notifications</title>
@endslot
@vite(['resources/js/requested.js'])

<div class="bg-[#6B8C6C] min-h-screen flex flex-col">

  <div class="relative overflow-x-hidden">

    <div class="pt-10 left-0 w-full z-50 px-10">
      <div>
        <img decoding="async" src="resources/images/welcome/header3.png"
          class="absolute inset-0 w-full h-full object-cover" alt="">
        <div class="absolute inset-0 bg-black/45"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-[#1E3D19]/10 via-[#728B6F]/10 to-[#6B8C6C]"></div>
      </div>

      <div>
        <div class="backdrop-blur-xl bg-white/20 border border-white/30
            rounded-full px-8 py-4 flex items-center justify-between shadow-lg">

          <img decoding="async" src="resources/images/essential/logo.png" alt="logo"
            onclick="window.location.href='/homepage2'" class="w-14 h-14 hover:scale-105 transition duration-300">

          <div class="flex items-center gap-4">
            <div class="bg-white/70 rounded-full px-6 py-3 w-[320px]">

              <input type="text" placeholder="Search plants" class="bg-transparent outline-none w-full
                        text-[#113E14] placeholder:text-[#6B8C6C]/70">
            </div>

            <button class="w-12 h-12 rounded-full bg-[#113E14]
                    flex items-center justify-center hover:bg-[#1b5420]
                    transition duration-300 shadow-md">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">

                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M21 21l-4.35-4.35m1.85-5.65a7.5 7.5 0 11-15 0 7.5 7.5 0 0115 0z" />
              </svg>
            </button>
          </div>

          <img decoding="async" src="public\plants/logo-perfil.png" alt="profile"
            class="w-14 h-14 rounded-full hover:scale-105 transition duration-300">
        </div>
      </div>


      <section class="pt-8 px-10">
        <div class="relative rounded-[40px] overflow-hidden shadow-2xl">
          <img decoding="async" src="resources/images/plant-budd.png" alt="hero" class="w-full h-[420px] object-cover">
          <div class="absolute inset-0 bg-gradient-to-r
                from-[#113E14]/70 to-transparent"></div>

          <div class="absolute inset-0 px-16 pt-20">
            <div class="flex justify-end">

            
            </div>

            <div class="max-w-xl mt-12">
              <h1 class="text-6xl font-abril leading-none text-[#f7f5f0]">
                Recuest the service that must convince you
              </h1>

              <p class="mt-6 text-white/80 text-lg leading-relaxed max-w-md">
                Explore elegant tropical species,
                connect with gardeners and create
                beautiful green spaces.
              </p>

            </div>

          </div>
      </section>
    </div>
  </div>


  <div class="flex bg-[#6C8E6B]/80 mx-12 py-10 space-x-6">

    <div class="flex bg-[#636863]/20 mx-12 py-8 rounded-[35px] mt-10">
      <div class="w-full backdrop-blur-xl bg-[#d3dcd3]/20 border border-[#d3dcd3]/40 rounded-[35px] shadow-xl p-8">

        
        <div class="mb-10">
          <h1
            class="text-center font-bold text-5xl font-poppins bg-gradient-to-r from-[#113e14] to-[#48ae4d] bg-clip-text text-transparent">
            Request your service
          </h1>
          <p class="text-center text-[#636863] mt-4 text-lg">
            Connect with professionals and request personalized assistance.
          </p>
        </div>

        <div class="grid grid-cols-12 gap-8">

        
          <div class="col-span-8 flex flex-col gap-6">

     
            <div class="bg-white/30 border border-[#d3dcd3]/40 rounded-[30px] p-6 backdrop-blur-xl shadow-lg">
              <div class="flex gap-6 items-center">
                <div
                  class="w-[220px] h-[220px] bg-[url('/resources/img/person4.jpg')] bg-cover bg-center rounded-[30px] shadow-xl shrink-0">
                </div>
                <div class="flex flex-col justify-center flex-1">
                  <div class="flex items-center gap-4">
                    <div
                      class="w-[65px] h-[65px] bg-[url('/resources/img/img3.png')] bg-contain bg-no-repeat bg-center rounded-2xl bg-[#d3dcd3]/30">
                    </div>
                    <div>
                      <h2 class="text-4xl font-bold text-[#113e14]">
                        Laura Valentina Díaz Morales
                      </h2>
                      <div class="flex items-center gap-3 mt-4">
                        <span class="bg-[#113e14] text-white px-4 py-2 rounded-full text-sm font-semibold">
                          Garden Restoration
                        </span>
                        <div class="w-2 h-2 rounded-full bg-[#636863]"></div>
                        <span class="text-[#636863] text-sm">
                          5 years of experience
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-white/30 border border-[#d3dcd3]/40 rounded-[30px] p-6 backdrop-blur-xl shadow-lg">
              <label class="text-[#113e14] font-semibold text-xl mb-4 block">
                What is your problem?
              </label>
              <textarea placeholder="Describe your problem or the service you need..."
                class="bg-white/40 border border-[#d3dcd3]/40 w-full h-[180px] rounded-[24px] px-5 py-4 text-[#113e14] outline-none resize-none focus:border-[#48ae4d]">
          </textarea>
            </div>

            <!-- BOTTOM INPUTS -->
            <div class="grid grid-cols-2 gap-6">

              <!-- BUDGET -->
              <div class="bg-white/30 border border-[#d3dcd3]/40 rounded-[30px] p-6">
                <p class="mb-4 text-[#113e14] font-semibold text-lg">
                  How much budget do you have?
                </p>
                <div class="bg-white/40 border border-[#d3dcd3]/40 rounded-2xl px-4 py-4 flex items-center gap-4">
                  <div
                    class="w-6 h-6 bg-[url('/resources/img/money.png')] bg-contain bg-center bg-no-repeat opacity-80">
                  </div>
                  <input type="text" placeholder="Type your budget"
                    class="outline-none bg-transparent text-[#113e14] text-sm w-full" />
                </div>
              </div>

              <!-- LOCATION -->
              <div class="bg-white/30 border border-[#d3dcd3]/40 rounded-[30px] p-6">
                <p class="mb-4 text-[#113e14] font-semibold text-lg">
                  Where are you?
                </p>
                <div class="bg-white/40 border border-[#d3dcd3]/40 rounded-2xl px-4 py-4 flex items-center gap-4">
                  <div class="w-6 h-6 bg-[url('/resources/img/map.png')] bg-contain bg-center bg-no-repeat opacity-80">
                  </div>
                  <input type="text" placeholder="Type your location"
                    class="outline-none bg-transparent text-[#113e14] text-sm w-full" />
                </div>
              </div>

            </div>
          </div>

          <!-- RIGHT SIDE -->
          <div class="col-span-4 flex flex-col gap-6">

            <!-- CALENDAR -->
            <div class="bg-white/30 border border-[#d3dcd3]/60 rounded-[30px] p-6 shadow-lg">
              <h3 class="text-[#113e14] text-2xl font-bold mb-5">
                Schedule service
              </h3>

              <!-- DATE PICKER -->
              <div class="relative w-full">
                <label class="absolute -top-2 left-3 bg-[#d3dcd3] px-1 text-[11px] text-[#636863] z-10">
                  When do you need me?
                </label>

                <div id="date-picker-toggle"
                  class="flex items-center justify-between border-2 border-[#48ae4d] rounded-sm px-3 py-2 cursor-pointer">
                  <input id="selected-date-label" type="text" value="08/17/2025"
                    class="bg-transparent outline-none text-sm text-[#113e14] flex-1 min-w-0">
                  <input id="service-date-input" type="hidden" name="service_date" value="2025-08-17">
                  <button id="date-picker-button" type="button"
                    class="w-5 h-5 bg-[url('/resources/img/cal.png')] bg-contain bg-center bg-no-repeat opacity-80">
                  </button>
                </div>

                <!-- CALENDAR PANEL -->
                <div id="date-picker-panel"
                  class="w-full mt-4 rounded-[28px] bg-[#d3dcd3]/40 border border-[#d3dcd3]/60 shadow-md p-5">

                  <!-- HEADER -->
                  <div class="flex items-center justify-between mb-6">
                    <button id="previous-month-button"
                      class="w-4 h-4 bg-[url('/resources/img/fizquielda.png')] bg-contain bg-center bg-no-repeat"></button>

                    <div class="flex items-center gap-1">
                      <select id="calendar-month-select" class="bg-transparent text-sm text-[#113e14] cursor-pointer">
                        <option value="0">Jan</option>
                        <option value="1">Feb</option>
                        <option value="2">Mar</option>
                        <option value="3">Apr</option>
                        <option value="4">May</option>
                        <option value="5">Jun</option>
                        <option value="6">Jul</option>
                        <option value="7">Aug</option>
                        <option value="8">Sep</option>
                        <option value="9">Oct</option>
                        <option value="10">Nov</option>
                        <option value="11">Dec</option>
                      </select>
                    </div>

                    <div class="flex items-center gap-1">
                      <select id="calendar-year-select" class="bg-transparent text-sm text-[#113e14] cursor-pointer">
                      </select>
                    </div>

                    <button id="next-month-button"
                      class="w-4 h-4 bg-[url('/resources/img/fdelecha.png')] bg-contain bg-center bg-no-repeat"></button>
                  </div>

                  <!-- DAYS -->
                  <div class="grid grid-cols-7 text-center text-[11px] text-[#636863] mb-4">
                    <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
                  </div>

                  <!-- NUMBERS -->
                  <div id="calendar-days" class="grid grid-cols-7 gap-y-3 text-sm text-center">
                    <!-- Calendar days go here -->
                  </div>


                  <div class="flex justify-end gap-7 mt-7 text-sm">
                    <button class="text-[#636863] font-medium hover:text-[#113e14] transition">
                      Cancel
                    </button>
                    <button class="text-[#48ae4d] font-semibold hover:opacity-70 transition">
                      OK
                    </button>
                  </div>

                </div>
              </div>
            </div>
          </div>
        </div>


        <div class="flex justify-end mt-8">
          <button class="bg-[#113e14] text-white font-semibold px-10 py-4 rounded-full shadow-lg hover:bg-[#48ae4">Send
            form</button>

        </div>



      </div>
      @end