@layout()
@slot('title')
<title>Garden Designer</title>
@endslot

<div class="relative min-h-screen overflow-hidden bg-gradient-to-br from-[#1E3D19] via-[#728B6F] to-[#6B8C6C]">

    <img src="/resources/images/welcome/header3.png"
        class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none" alt="">

    <div class="absolute inset-0 bg-black/45 pointer-events-none"></div>
    <div
        class="absolute inset-0 bg-gradient-to-br from-[#1E3D19]/70 via-[#728B6F]/55 to-[#6B8C6C]/70 pointer-events-none">
    </div>

    <header class="w-full z-50 px-6 lg:px-10 pt-6">
        <div
            class="max-w-7xl mx-auto bg-white/10 backdrop-blur-xl border border-white/10 rounded-full px-6 py-4 flex items-center justify-between shadow-[0_10px_40px_rgba(0,0,0,0.15)]">

            <div class="flex items-center gap-4 select-none">
                <img src="/resources/images/essential/logo.png"
                    class="w-14 pointer-events-none select-none hover:rotate-6 transition duration-500"
                    alt="Plant Bud Logo">

                <div>
                    <h1 class="text-2xl font-black text-white tracking-wide">
                        Plant <span class="text-[#EDE7D6]">Bud</span>
                    </h1>
                    <p class="text-xs font-bold tracking-[0.25em] uppercase text-white/60">
                        Garden Designer
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3">

                <a href="/homepage"
                    class="inline-flex items-center gap-2 bg-white/10 text-white font-bold px-5 py-3 rounded-full border border-white/10 hover:bg-white/15 transition-all duration-300 select-none">
                    Exit
                </a>

                <label for="upload"
                    class="cursor-pointer inline-flex items-center gap-2 bg-white/10 text-white font-bold px-5 py-3 rounded-full border border-white/10 hover:bg-white/15 transition-all duration-300 select-none">
                    Upload
                </label>

                <input id="upload" type="file" accept="image/*" class="hidden">

                <button onclick="sendToBackend()"
                    class="inline-flex items-center gap-2 bg-[#EDE7D6] text-[#1E3D19] font-black px-6 py-3 rounded-full hover:scale-105 transition-all duration-300 shadow-lg select-none">
                    Generate AI
                </button>

            </div>

        </div>
    </header>

    <main class="relative z-10 pt-10 pb-10 px-6 lg:px-10 select-none">

        <div class="max-w-7xl mx-auto grid grid-cols-1 xl:grid-cols-[320px_1fr] gap-8 min-h-[calc(100vh-11rem)]">

            <aside class="relative">
                <div class="absolute -inset-2 bg-white/10 blur-2xl rounded-[2.5rem] opacity-70"></div>

                <div
                    class="relative h-full bg-white/10 backdrop-blur-2xl border border-white/10 rounded-[2.5rem] p-6 shadow-[0_30px_80px_rgba(0,0,0,0.25)] overflow-hidden">

                    <div class="relative space-y-8">

                        <section>
                            <h2 class="text-white text-xl font-black">Asset Search</h2>
                            <div class="w-14 h-1 bg-[#EDE7D6] rounded-full mt-3 mb-5"></div>

                            <div class="relative">
                                <input id="searchInput" type="text" placeholder="Search plants or furniture..."
                                    class="w-full bg-white/10 border border-white/10 rounded-full pl-5 pr-24 py-3 text-sm text-white placeholder:text-white/45 font-semibold outline-none focus:ring-2 focus:ring-[#EDE7D6]/40">

                                <button type="button" onclick="searchPexels()"
                                    class="absolute right-1.5 top-1/2 -translate-y-1/2 bg-[#EDE7D6] text-[#1E3D19] font-black px-4 py-2 text-xs rounded-full hover:scale-105 transition-all duration-300">
                                    Search
                                </button>
                            </div>

                            <p class="text-white/60 text-sm font-semibold leading-relaxed mt-3">
                                Search images and add them to your inventory.
                            </p>
                        </section>

                        <section>
                            <h2 class="text-white text-xl font-black">Inventory</h2>
                            <div class="w-14 h-1 bg-[#EDE7D6] rounded-full mt-3 mb-5"></div>

                            <div id="inventory"
                                class="grid grid-cols-2 gap-3 max-h-[340px] overflow-y-auto pr-1 select-none">

                                <div class="col-span-2 text-center py-8 rounded-3xl bg-white/5 border border-white/5">
                                    <p class="text-white/55 text-sm font-semibold">
                                        No assets added yet
                                    </p>
                                </div>

                            </div>
                        </section>

                        <section>
                            <h2 class="text-white text-xl font-black">Actions</h2>
                            <div class="w-14 h-1 bg-[#EDE7D6] rounded-full mt-3 mb-5"></div>

                            <div class="space-y-2">

                                <div class="grid grid-cols-2 gap-2">
                                    <button onclick="clearSelection()"
                                        class="bg-white/10 hover:bg-white/15 text-white py-3 rounded-xl">⊙
                                        Deselect</button>
                                    <button onclick="clearAll()"
                                        class="bg-white/10 hover:bg-white/15 text-white py-3 rounded-xl">🧹
                                        Clear</button>
                                </div>

                                <div class="grid grid-cols-2 gap-2">
                                    <button onclick="duplicateSelected()"
                                        class="bg-white/10 hover:bg-white/15 text-white py-3 rounded-xl">📄
                                        Copy</button>
                                    <button onclick="deleteSelected()"
                                        class="bg-white/10 hover:bg-white/15 text-white py-3 rounded-xl">🗑
                                        Delete</button>
                                </div>

                                <div class="grid grid-cols-2 gap-2">
                                    <button onclick="undo()"
                                        class="bg-[#EDE7D6] text-[#1E3D19] font-black py-3 rounded-xl">↶ Undo</button>
                                    <button onclick="redo()"
                                        class="bg-[#EDE7D6] text-[#1E3D19] font-black py-3 rounded-xl">↷ Redo</button>
                                </div>

                                <div class="grid grid-cols-2 gap-2 p-2 rounded-xl bg-white/5">
                                    <button onclick="rotateSelected()"
                                        class="bg-white/10 hover:bg-white/15 text-white py-3 rounded-xl">⟳
                                        Rotate</button>
                                    <button onclick="flipSelected()"
                                        class="bg-white/10 hover:bg-white/15 text-white py-3 rounded-xl">⇋ Flip
                                        X</button>
                                    <button onclick="flipYSelected()"
                                        class="bg-white/10 hover:bg-white/15 text-white py-3 rounded-xl">⇅ Flip
                                        Y</button>
                                    <button onclick="toggleLock()"
                                        class="bg-white/10 hover:bg-white/15 text-white py-3 rounded-xl">🔒
                                        Lock</button>
                                </div>

                                <div class="grid grid-cols-2 gap-2 p-2 rounded-xl bg-white/5">
                                    <button onclick="bringFront()"
                                        class="bg-white/10 hover:bg-white/15 text-white py-3 rounded-xl">⬆
                                        Front</button>
                                    <button onclick="sendBack()"
                                        class="bg-white/10 hover:bg-white/15 text-white py-3 rounded-xl">⬇ Back</button>
                                </div>

                            </div>
                        </section>

                    </div>
                </div>
            </aside>

            <section class="relative">
                <div class="absolute -inset-2 bg-white/10 blur-2xl rounded-[3rem] opacity-70"></div>

                <div
                    class="relative h-full bg-white/10 backdrop-blur-2xl border border-white/10 rounded-[3rem] p-5 lg:p-7 shadow-[0_30px_80px_rgba(0,0,0,0.25)] overflow-hidden">

                    <div class="relative flex flex-col h-full">

                        <div class="flex items-center justify-between gap-4 mb-6">
                            <div>
                                <h2 class="text-3xl md:text-4xl font-black text-white">
                                    Garden Workspace
                                </h2>
                                <p class="text-white/75 font-semibold mt-2">
                                    Design your outdoor space with drag and drop
                                </p>
                            </div>
                        </div>

                        <div
                            class="flex-1 min-h-[600px] rounded-[2.5rem] bg-black/15 border border-white/10 p-4 lg:p-6 overflow-auto">

                            <div id="workspace" class="w-full h-full flex items-center justify-center">

                                <div class="canvas-placeholder">

                                    <div id="canvas-container"
                                        class="relative isolate overflow-hidden inline-flex items-center justify-center bg-white/5 border border-white/10 rounded-[2rem] shadow-[0_20px_60px_rgba(0,0,0,0.35)] select-none">

                                        <img id="baseImage"
                                            class="relative z-0 block max-w-full max-h-[75vh] w-auto h-auto object-contain pointer-events-none select-none"
                                            alt="">

                                        <div id="canvas-placeholder"
                                            class="absolute inset-0 flex items-center justify-center text-center p-10 pointer-events-none z-20">

                                            <div>
                                                <h3 class="text-white text-3xl font-black">
                                                    Upload a Garden Photo
                                                </h3>
                                                <p class="text-white/70 font-semibold mt-3 max-w-md">
                                                    Start by uploading an image and add plants, furniture, and
                                                    decorations
                                                </p>
                                            </div>

                                        </div>

                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            </section>

        </div>
    </main>

    <div id="searchModal" class="hidden fixed inset-0 z-[70]">
        <div class="absolute inset-0 bg-black/75 backdrop-blur-md" onclick="closeSearchModal()"></div>

        <div class="absolute inset-0 flex items-center justify-center p-4">

            <div
                class="relative w-full max-w-6xl max-h-[90vh] bg-white/10 backdrop-blur-3xl border border-white/10 rounded-[3rem] overflow-hidden">

                <div class="relative flex items-center justify-between px-8 py-6 border-b border-white/10">
                    <h3 class="text-2xl font-black text-white">Search Results</h3>
                    <button onclick="closeSearchModal()"
                        class="w-10 h-10 rounded-full bg-white/10 text-white">×</button>
                </div>

                <div id="searchResults"
                    class="p-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 overflow-y-auto max-h-[calc(90vh-7rem)]">
                </div>

            </div>
        </div>
    </div>

    <div id="loadingText"
        class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden z-50 bg-white/10 backdrop-blur-2xl border border-white/10 rounded-full px-6 py-4 text-white font-bold">
        Processing...
    </div>

</div>
@vite(['resources/js/garden.js'])
@end
