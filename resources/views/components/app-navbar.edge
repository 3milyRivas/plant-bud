              <button type="submit" class="absolute right-1.5 flex h-8 w-8 items-center justify-center rounded-full bg-[#113e14] text-white shadow-[0_8px_18px_rgba(17,62,20,0.22)] transition hover:-translate-y-0.5 hover:bg-[#416543]" aria-label="Search plants">
