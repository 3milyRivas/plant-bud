  : 'relative z-[100000] px-3 pb-5 pt-4 sm:px-5 lg:px-8')

@let(shellClass = 'pointer-events-auto mx-auto grid ' + maxWidth + ' grid-cols-[auto_minmax(0,1fr)_auto] transform-gpu items-center gap-2 overflow-visible rounded-[1.35rem] border border-white/30 bg-white/20 px-3 py-2.5 shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(.2,.8,.2,1)] sm:gap-3 sm:rounded-full sm:px-4 lg:px-5')

<header class="{{ headerClass }}" data-community-navbar="{{ dynamic ? 'true' : 'false' }}" data-community-navbar-dynamic="{{ dynamic ? 'true' : 'false' }}">
