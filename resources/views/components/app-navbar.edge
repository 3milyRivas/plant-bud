          @let(linkClass = isActive ? 'bg-[#ebe3a7] text-[#113e14] ring-2 ring-white/35 shadow-[0_12px_28px_rgba(235,227,167,0.22)]' : (isCommunity ? 'bg-[#dca15d]/28 text-[#ffe5bd] hover:bg-[#dca15d]/38 hover:text-white' : (isHome ? 'bg-white/16 text-[#ebe3a7] hover:bg-white/24 hover:text-white' : 'bg-white/10 text-white/84 hover:bg-white/18 hover:text-[#ebe3a7]')))
          @if(item.children && item.children.length)
