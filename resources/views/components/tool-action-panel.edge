@let(mode = $props.get('mode'))
@let(isScanner = mode === 'scanner')
@let(inputId = isScanner ? 'plantUpload' : 'upload')
@let(title = isScanner ? 'Choose a plant photo' : 'Choose a garden photo')
@let(description = isScanner
  ? 'Upload a clear image first, then run the plant health analysis.'
  : 'Upload the base garden image first, build the design, then download the result.')

<section class="tool-action-panel mx-auto mb-7 w-full max-w-[min(90rem,calc(100vw-2rem))]" aria-label="{{ isScanner ? 'Scanner actions' : 'Designer actions' }}" data-tool-action-panel data-tool-mode="{{ mode }}">
  <div class="flex flex-col gap-5 rounded-[1.75rem] border border-white/28 bg-[#113e14]/82 p-5 text-white shadow-[0_22px_65px_rgba(17,62,20,0.28)] backdrop-blur-2xl lg:flex-row lg:items-center lg:justify-between">
    <div class="flex min-w-0 items-center gap-4">
      <span class="flex h-12 w-12 flex-none items-center justify-center rounded-2xl bg-[#ebe3a7] text-[#113e14] shadow-lg">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16.5V19a1 1 0 001 1h14a1 1 0 001-1v-2.5M12 4v11m0-11L8 8m4-4l4 4" />
        </svg>
      </span>
      <div class="min-w-0">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-[#dca15d]">{{ isScanner ? 'Plant scanner' : '2D garden designer' }}</p>
        <h2 class="mt-1 text-xl font-black text-[#ebe3a7]">{{ title }}</h2>
        <p class="mt-1 max-w-2xl text-sm font-semibold leading-6 text-white/68">{{ description }}</p>
      </div>
    </div>

    <div class="phone-tool-flow" aria-label="{{ isScanner ? 'Scanner workflow' : 'Designer workflow' }}">
      <span><strong>1</strong>{{ isScanner ? 'Add photo' : 'Add garden' }}</span>
      <span><strong>2</strong>{{ isScanner ? 'Review' : 'Design' }}</span>
      <span><strong>3</strong>{{ isScanner ? 'Analyze' : 'Download' }}</span>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <div class="relative" data-phone-upload-menu>
        <button type="button" class="tool-action-secondary w-full sm:w-auto" data-phone-upload-menu-button>
          Upload image
        </button>
        <div class="absolute right-0 top-[calc(100%+0.6rem)] z-[100002] hidden w-60 overflow-hidden rounded-[1.25rem] border border-white/55 bg-white/96 p-2 text-[#113e14] shadow-2xl backdrop-blur-xl" data-phone-upload-menu-panel>
          <label for="{{ inputId }}" class="block w-full cursor-pointer rounded-2xl px-4 py-3 text-left text-sm font-black transition hover:bg-[#416543]/10" data-phone-upload-computer>
            Upload from this device
          </label>
          @if(frontend === 'Phone')
            <button type="button" class="block w-full cursor-pointer rounded-2xl px-4 py-3 text-left text-sm font-black transition hover:bg-[#416543]/10" data-phone-camera-trigger data-phone-upload-input="#{{ inputId }}" data-phone-upload-tool-label="{{ isScanner ? 'Plant scanner' : 'Garden designer' }}">
              Open camera
            </button>
          @else
            <button type="button" class="block w-full cursor-pointer rounded-2xl px-4 py-3 text-left text-sm font-black transition hover:bg-[#416543]/10" data-phone-upload-trigger data-phone-upload-input="#{{ inputId }}" data-phone-upload-tool="{{ mode }}" data-phone-upload-tool-label="{{ isScanner ? 'Plant scanner' : 'Garden designer' }}">
              Upload from phone
            </button>
          @endif
        </div>
      </div>

      @if(isScanner)
        <button id="scanBtn" type="button" class="tool-action-primary w-full sm:w-auto">
          Analyze plant
        </button>
      @else
        <button type="button" onclick="sendToBackend()" class="tool-action-primary w-full sm:w-auto">
          Download design
        </button>
      @endif
    </div>
  </div>
</section>
