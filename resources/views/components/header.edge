<header class="fixed left-0 top-0 z-50 w-full px-6 pt-6 lg:px-10">
  <div class="mx-auto max-w-7xl">
    <div class="flex items-center justify-between rounded-full border border-white/20 bg-white/15 px-5 py-3 shadow-[0_10px_35px_rgba(0,0,0,0.18)] backdrop-blur-xl lg:px-8">
      <a href="/homepage" class="flex h-12 w-12 items-center justify-center rounded-full bg-white/70 shadow-lg transition hover:rotate-6 hover:bg-white/90" aria-label="Go to homepage">
        <img src="/resources/images/essential/logo.png" alt="" class="h-9 w-9 object-contain">
      </a>

      <div class="hidden items-center gap-4 md:flex">
        <a href="/araceae" class="rounded-full px-4 py-2 text-sm font-black text-white/80 transition hover:bg-white/15 hover:text-white">Catalog</a>
        <a href="/nurseries" class="rounded-full px-4 py-2 text-sm font-black text-white/80 transition hover:bg-white/15 hover:text-white">Nurseries</a>
        <a href="/community" class="rounded-full px-4 py-2 text-sm font-black text-white/80 transition hover:bg-white/15 hover:text-white">Community</a>
      </div>

      <a href="/profile" class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full border-2 border-white/40 bg-[#113E14] shadow-lg transition hover:scale-105" aria-label="Open profile">
        <img src="/resources/images/logo-perfil.png" alt="" class="h-full w-full object-cover">
      </a>
    </div>
  </div>
</header>

<div class="relative h-[620px] w-full bg-cover bg-center {{ imageBg }}">
  <div class="absolute inset-0 bg-black/20"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-[#1E3D19]/30 to-[#6B8C6C]"></div>

  <div class="relative z-10 flex h-full flex-col items-center justify-center px-6 pt-24 text-center">
    <h1 class="max-w-4xl text-5xl font-bold text-white md:text-7xl">
      {{ title }}
    </h1>
    <p class="mt-6 max-w-xl text-white/80">
      {{ text }}
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-5">
      <a href="/araceae" class="rounded-full bg-[#113E14] px-8 py-4 font-medium text-white shadow-[0_10px_30px_rgba(17,62,20,0.4)] transition duration-300 hover:scale-105 hover:bg-[#1B5420]">
        Explore Plants
      </a>

      <a href="/care1" class="rounded-full border border-white/30 bg-white/10 px-8 py-4 font-medium text-white backdrop-blur-md transition duration-300 hover:bg-white/20">
        Learn More
      </a>
    </div>
  </div>
</div>

<div class="mt-6 px-6">
  <button type="button" onclick="history.length > 1 ? history.back() : window.location.href = '/homepage'" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/15 px-6 py-2 text-white backdrop-blur-xl transition hover:bg-white/20">
    Back
  </button>
</div>
