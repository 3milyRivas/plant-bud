@let(groups = categories.map((category) => ({
  ...category,
  products: products.filter((product) => (product.category || 'Plants').toLowerCase() === category.name.toLowerCase())
})).filter((group) => group.products.length))

<section class="nursery-catalog-showcase {{ className || '' }}" id="{{ sectionId || 'nursery-catalog' }}" data-nursery-catalog data-page-size="6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.22em] text-[#dca15d]">Nursery catalog</p>
      <h2 class="mt-2 text-3xl font-black text-[#113e14] sm:text-4xl">Plants and products</h2>
      <p class="mt-2 max-w-2xl text-sm font-semibold leading-6 text-[#416543]">
        Explore what this nursery currently has available.
      </p>
    </div>
    @if(manageHref)
      <a href="{{ manageHref }}" class="rounded-full bg-[#113e14] px-5 py-3 text-center text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-[#416543]">
        Manage catalog
      </a>
    @endif
  </div>

  @if(groups.length)
    <div class="mt-7 flex flex-wrap gap-2" data-nursery-catalog-filters>
      <button type="button" class="rounded-full bg-[#113e14] px-4 py-2.5 text-xs font-black text-white shadow-sm transition" data-catalog-filter="all">
        All <span class="ml-1 opacity-65">{{ products.length }}</span>
      </button>
      @each(group in groups)
        <button type="button" class="rounded-full bg-white/75 px-4 py-2.5 text-xs font-black text-[#416543] shadow-sm transition hover:bg-white" data-catalog-filter="{{ group.name.toLowerCase() }}">
          {{ group.name }} <span class="ml-1 opacity-65">{{ group.products.length }}</span>
        </button>
      @end
    </div>

    <div class="nursery-catalog-grid mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3" data-nursery-catalog-list>
      @each(group in groups)
        @each(product in group.products)
              <article class="nursery-catalog-product group overflow-hidden rounded-[1.75rem] border border-[#416543]/12 bg-white shadow-[0_16px_45px_rgba(17,62,20,0.10)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_rgba(17,62,20,0.16)]" data-catalog-product data-catalog-category="{{ group.name.toLowerCase() }}">
                <div class="relative aspect-[4/3] overflow-hidden bg-[#dfe8cf]">
                  @if(product.imageUrl)
                    <img src="{{ product.imageUrl }}" alt="{{ product.name }}" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]">
                  @else
                    <div class="flex h-full items-center justify-center bg-gradient-to-br from-[#dfe8cf] via-[#ebe3a7] to-[#dca15d]/55 p-6 text-center">
                      <span class="text-5xl font-black text-[#113e14]/25">{{ product.name.slice(0, 1).toUpperCase() }}</span>
                    </div>
                  @endif
                  <span class="{{ product.isActive === false ? 'bg-white text-[#416543]' : 'bg-[#113e14] text-white' }} absolute left-4 top-4 rounded-full px-3 py-1.5 text-[0.68rem] font-black uppercase tracking-[0.12em] shadow-md">
                    {{ product.isActive === false ? 'Hidden' : (product.stock > 0 ? product.stock + ' available' : 'Ask availability') }}
                  </span>
                </div>
                <div class="p-5">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <p class="text-xs font-black uppercase tracking-[0.14em] text-[#dca15d]">{{ product.category || 'Plants' }}</p>
                      <h4 class="mt-1 text-xl font-black leading-6 text-[#113e14]">{{ product.name }}</h4>
                    </div>
                    @if(product.price !== null)
                      <span class="shrink-0 rounded-full bg-[#ebe3a7] px-3 py-2 text-sm font-black text-[#113e14]">${{ Number(product.price).toFixed(2) }}</span>
                    @endif
                  </div>
                  @if(product.description)
                    <p class="mt-3 line-clamp-3 text-sm font-semibold leading-6 text-[#416543]">{{ product.description }}</p>
                  @endif
                </div>
              </article>
        @end
      @end
    </div>

    <div class="mt-7 hidden flex-col gap-3 border-t border-[#416543]/12 pt-5 sm:flex-row sm:items-center sm:justify-between" data-catalog-pagination>
      <p class="text-xs font-black uppercase tracking-[0.12em] text-[#416543]" data-catalog-page-status></p>
      <div class="flex items-center gap-2">
        <button type="button" class="rounded-full bg-white px-4 py-2.5 text-xs font-black text-[#113e14] shadow-sm transition hover:bg-[#ebe3a7] disabled:cursor-not-allowed disabled:opacity-40" data-catalog-previous>Previous</button>
        <div class="flex gap-1" data-catalog-pages></div>
        <button type="button" class="rounded-full bg-[#113e14] px-4 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-[#416543] disabled:cursor-not-allowed disabled:opacity-40" data-catalog-next>Next</button>
      </div>
    </div>
  @else
    <div class="mt-7 rounded-[2rem] border border-dashed border-[#416543]/30 bg-[#ebe3a7]/45 p-8 text-center">
      <p class="text-xl font-black text-[#113e14]">The catalog is being prepared</p>
      <p class="mt-2 text-sm font-semibold text-[#416543]">Products from this nursery will appear here soon.</p>
    </div>
  @endif
</section>
