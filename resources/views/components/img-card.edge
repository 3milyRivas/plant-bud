<div class="group relative overflow-hidden rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.20)] hover:-translate-y-2 transition-all duration-500">
  <div class="absolute -inset-2 bg-[#48AE4D]/20 blur-2xl opacity-0 group-hover:opacity-100 transition duration-500">
  </div>
  <img loading="lazy" decoding="async" src="{{imageBg}}"
    class="relative w-full h-[420px] object-cover group-hover:scale-110 transition duration-700" alt="suc1">
  <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
  <div class="absolute bottom-0 left-0 p-6">
    <div class="text-white text-2xl font-bold mb-1">
      {{title}}
    </div>
    <div class="text-white/80 text-sm">
      {{text}}
    </div>
  </div>
</div>
