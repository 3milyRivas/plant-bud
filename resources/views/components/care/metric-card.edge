<div class="care-metric-card rounded-2xl border border-[#416543]/12 bg-white/75 p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:bg-[#ebe3a7]/80">
  <div class="mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-[#416543]/8">
    <img loading="lazy" decoding="async" src="{{ icon }}" alt="" class="h-7 w-7 object-contain">
  </div>
  <div class="font-black text-[#113e14]">
    {{ title }}
  </div>
  <div class="mt-1 text-sm font-semibold text-[#416543]">
    {{ text }}
  </div>
</div>
