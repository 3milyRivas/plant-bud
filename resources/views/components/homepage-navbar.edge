@!component('components/app-navbar', {
  section: 'Home',
  active: 'homepage',
  avatarUrl,
  avatarInitial,
  displayName,
  roleLabel,
  planLabel: $props.get('planLabel') ?? 'Free',
  maxWidth: 'max-w-[min(1500px,calc(100vw-2rem))]',
  items: [
    {
      key: 'tools',
      href: '/scanner',
      label: 'Tools',
      icon: '/resources/images/homepagee/scanner.png',
      eyebrow: 'Create and diagnose',
      activeKeys: ['scanner', 'designer'],
      children: [
        {
          href: '/scanner',
          label: 'Scanner',
          description: 'Identify plants and care needs.',
        },
        {
          href: '/designer',
          label: 'Designer',
          description: 'Plan a garden layout in 2D.',
        },
        {
          href: '/ornamental',
          label: 'Catalog',
          description: 'Explore plant collections and care guides.',
        },
      ],
    },
    {
      key: 'services',
      href: '/maintenance',
      label: 'Services',
      icon: '/resources/images/homepagee/tulip.png',
      eyebrow: 'Gardeners and nurseries',
      activeKeys: ['services', 'requested', 'nurseries', 'nursery'],
      children: [
        {
          href: '/maintenance',
          label: 'Gardeners',
          description: 'Find and request gardener services.',
        },
        {
          href: '/requested',
          label: 'Requested',
          description: 'Track services you sent or received.',
        },
        {
          href: '/nurseries',
          label: 'Nurseries',
          description: 'Browse plant sellers and catalogs.',
        },
      ],
    },
    {
      key: 'community',
      href: '/community',
      label: 'Community',
      icon: '/resources/images/homepagee/comunity.png',
      eyebrow: 'People and activity',
      activeKeys: ['community', 'favorites', 'notification'],
      children: [
        {
          href: '/community',
          label: 'Feed',
          description: 'Posts, polls, and profiles.',
        },
        {
          href: '/favorites',
          label: 'Saved',
          description: 'Your saved community posts.',
        },
        {
          href: '/notification',
          label: 'Alerts',
          description: 'Recent follows and interactions.',
        },
      ],
    },
  ],
})
