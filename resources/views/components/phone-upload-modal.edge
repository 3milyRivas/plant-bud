<div class="fixed inset-0 z-[100001] hidden items-center justify-center bg-[#113e14]/54 px-4 py-6 backdrop-blur-md" data-phone-upload-modal>
  <div class="w-full max-w-3xl overflow-hidden rounded-[2rem] border border-white/45 bg-white/94 text-[#113e14] shadow-2xl">
    <div class="flex items-start justify-between gap-4 border-b border-[#416543]/12 bg-[#113e14] px-6 py-5 text-[#ebe3a7]">
      <div class="flex min-w-0 items-center gap-3">
        <span class="flex h-14 w-14 flex-none items-center justify-center rounded-full bg-white/10">
          <img src="/resources/images/essential/logo.png" alt="" class="h-12 w-12 object-contain">
        </span>
        <span class="min-w-0">
          <span class="block text-xl font-black">Upload from phone</span>
          <span class="mt-0.5 block text-xs font-black uppercase tracking-[0.18em] text-[#a8b841]" data-phone-upload-tool-label>Plant Bud</span>
        </span>
      </div>
      <button type="button" class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-white/10 text-lg font-black text-[#ebe3a7] transition hover:bg-white/16" data-phone-upload-close aria-label="Close phone upload">x</button>
    </div>

    <div class="grid gap-6 p-6 lg:grid-cols-[18rem_minmax(0,1fr)]">
      <div class="rounded-[1.5rem] border border-[#416543]/12 bg-[#ebe3a7]/42 p-4">
        <div class="rounded-[1.25rem] bg-white p-4 shadow-inner" data-phone-upload-qr>
          <div class="flex aspect-square items-center justify-center rounded-2xl bg-[#416543]/8 text-center text-sm font-black text-[#416543]">
            Preparing QR...
          </div>
        </div>
      </div>

      <div class="flex flex-col justify-center">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-[#dca15d]">Before scanning</p>
        <h2 class="mt-2 text-3xl font-black leading-tight">Have your photo ready on your phone.</h2>
        <p class="mt-3 text-sm font-semibold leading-6 text-[#416543]">
          Keep both devices on the same Wi-Fi, scan this QR, choose the plant or garden image from your phone, and upload it. This QR uses a private temporary token and expires soon.
        </p>

        <div class="mt-5 rounded-2xl border border-[#416543]/12 bg-[#416543]/8 p-4">
          <p class="text-xs font-black uppercase tracking-[0.14em] text-[#416543]">Status</p>
          <p class="mt-1 text-lg font-black text-[#113e14]" data-phone-upload-status>Waiting for phone...</p>
        </div>

        <div class="mt-4 rounded-2xl border border-[#416543]/12 bg-white/60 p-3">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-xs font-black uppercase tracking-[0.14em] text-[#416543]">Manual link</p>
            <button type="button" class="rounded-full bg-[#ebe3a7]/65 px-3 py-2 text-xs font-black text-[#113e14] transition hover:bg-[#dca15d]/35" data-phone-upload-link-toggle>
              Show link
            </button>
          </div>
          <div class="mt-3 hidden" data-phone-upload-link-panel>
            <button type="button" class="w-full break-all rounded-2xl bg-white px-4 py-3 text-left text-xs font-bold text-[#416543] transition hover:bg-[#ebe3a7]/55" data-phone-upload-link>
              Generating link...
            </button>
            <p class="mt-2 hidden text-xs font-black text-[#dca15d]" data-phone-upload-copy-status>Copied to clipboard</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
