@let(viewer = $props.get('viewer'))
@let(active = $props.get('active') ?? 'community')
@let(section = $props.get('section') ?? 'Community')
@let(searchError = $props.get('searchError') ?? null)
@let(dynamic = $props.get('dynamic') ?? false)

@!component('components/app-navbar', {
  section,
  active,
  searchError,
  dynamic,
  avatarUrl: viewer.avatarUrl,
  avatarInitial: viewer.initial,
  displayName: viewer.displayName ?? 'Profile',
  roleLabel: viewer.username ? '@' + viewer.username : 'settings',
  planLabel: viewer.planLabel ?? 'Free',
  maxWidth: 'max-w-[min(1500px,calc(100vw-2rem))]',
  showProfileText: true,
})
