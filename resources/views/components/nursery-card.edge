<article class="group overflow-hidden rounded-2xl border border-white/20 bg-white/12 p-5 text-white shadow-xl backdrop-blur-lg transition duration-300 hover:-translate-y-1 hover:bg-white/16">
  <img src="{{ asset(nursery.image) }}" alt="{{ nursery.name }}" class="h-48 w-full rounded-xl object-cover shadow-lg transition duration-500 group-hover:scale-[1.02]">

  <div class="mt-5 flex items-start justify-between gap-4">
    <h3 class="text-2xl font-black leading-tight">
      {{{ nursery.name }}}
    </h3>
    <span class="rounded-full bg-[#113E14]/80 px-3 py-1 text-sm font-black text-[#EDE7D6]">
      {{ nursery.rating }}/5
    </span>
  </div>

  <p class="mt-3 min-h-[72px] text-base font-semibold leading-6 text-white/80">
    {{{ nursery.description }}}
  </p>

  <dl class="mt-5 space-y-2 text-sm font-semibold text-white/70">
    <div class="flex items-center justify-between gap-4">
      <dt class="text-white/55">Location</dt>
      <dd class="text-right">{{ nursery.location }}</dd>
    </div>
    <div class="flex items-center justify-between gap-4">
      <dt class="text-white/55">Hours</dt>
      <dd class="text-right">{{ nursery.hours }}</dd>
    </div>
  </dl>

  <div class="mt-5 flex items-center justify-between gap-3 border-t border-white/15 pt-4 text-sm font-bold text-white/75">
    <span>{{ nursery.social }}</span>
    <span>{{ nursery.phone }}</span>
  </div>
</article>
