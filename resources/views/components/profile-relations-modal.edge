@let(relations = $props.get('relations'))
@let(showFriends = $props.get('showFriends') ?? false)
@let(canManage = $props.get('canManage') ?? false)

<div class="fixed inset-0 z-[90] hidden items-center justify-center px-4 py-6" data-profile-relations-modal aria-hidden="true">
  <button type="button" class="absolute inset-0 bg-[#113e14]/72 backdrop-blur-sm" data-profile-relations-close aria-label="Close relations"></button>

  <section class="relative z-10 flex max-h-[min(720px,calc(100dvh-3rem))] w-full max-w-xl flex-col overflow-hidden rounded-[2rem] border border-white/35 bg-[#ebe3a7]/96 shadow-[0_30px_90px_rgba(17,62,20,0.34)] backdrop-blur-2xl">
    <header class="flex items-center justify-between gap-4 border-b border-[#416543]/10 px-5 py-4">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.18em] text-[#416543]">Community</p>
        <h2 class="mt-1 text-2xl font-black text-[#113e14]" data-profile-relations-title>Followers</h2>
      </div>
      <button type="button" class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-xl font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]" data-profile-relations-close aria-label="Close relations">
        &times;
      </button>
    </header>

    <div class="flex gap-2 px-5 pt-4">
      <button type="button" class="flex-1 rounded-full bg-[#113e14] px-4 py-2.5 text-sm font-black text-[#ebe3a7] shadow-md transition hover:-translate-y-0.5" data-relations-tab="followers">
        Followers
      </button>
      <button type="button" class="flex-1 rounded-full bg-white px-4 py-2.5 text-sm font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5" data-relations-tab="following">
        Following
      </button>
      @if(showFriends)
        <button type="button" class="flex-1 rounded-full bg-white px-4 py-2.5 text-sm font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5" data-relations-tab="friends">
          Friends
        </button>
      @endif
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto px-5 pb-5 pt-4">
      <div class="space-y-3" data-profile-relations-panel="followers">
        @each(person in relations.followers)
          <div class="flex items-center gap-3 rounded-[1.35rem] border border-[#416543]/10 bg-white/75 p-3 shadow-sm transition hover:-translate-y-0.5 hover:bg-white" data-relation-user-id="{{ person.id }}">
            <a href="/users/{{ person.username }}" class="flex min-w-0 flex-1 items-center gap-3">
              @if(person.avatarUrl)
                <img src="{{ person.avatarUrl }}" alt="" class="h-12 w-12 flex-none rounded-full object-cover shadow-sm">
              @else
                <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-[#113e14] text-sm font-black text-[#ebe3a7] shadow-sm">
                  {{ person.initial }}
                </span>
              @endif
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-black text-[#113e14]">{{ person.displayName }}</span>
                <span class="block truncate text-xs font-bold text-[#416543]">{{ '@' + person.username }} - {{ person.roleLabel }}{{ person.isPremium ? ' - Premium' : '' }}</span>
              </span>
            </a>
            @if(person.relationLabel)
              <span class="rounded-full bg-[#ebe3a7] px-3 py-1 text-[11px] font-black uppercase tracking-[0.12em] text-[#113e14]" data-relation-label>
                {{ person.relationLabel }}
              </span>
            @endif
          </div>
        @else
          <div class="rounded-[1.5rem] border border-dashed border-[#416543]/35 bg-white/50 p-6 text-center">
            <p class="text-sm font-black text-[#113e14]">No followers yet</p>
            <p class="mt-1 text-xs font-semibold leading-5 text-[#416543]">When someone follows this account, they will appear here.</p>
          </div>
        @end
      </div>

      <div class="hidden space-y-3" data-profile-relations-panel="following">
        @each(person in relations.following)
          <div class="flex items-center gap-3 rounded-[1.35rem] border border-[#416543]/10 bg-white/75 p-3 shadow-sm transition hover:-translate-y-0.5 hover:bg-white" data-relation-user-id="{{ person.id }}">
            <a href="/users/{{ person.username }}" class="flex min-w-0 flex-1 items-center gap-3">
              @if(person.avatarUrl)
                <img src="{{ person.avatarUrl }}" alt="" class="h-12 w-12 flex-none rounded-full object-cover shadow-sm">
              @else
                <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-[#113e14] text-sm font-black text-[#ebe3a7] shadow-sm">
                  {{ person.initial }}
                </span>
              @endif
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-black text-[#113e14]">{{ person.displayName }}</span>
                <span class="block truncate text-xs font-bold text-[#416543]">{{ '@' + person.username }} - {{ person.roleLabel }}{{ person.isPremium ? ' - Premium' : '' }}</span>
              </span>
            </a>
            @if(person.relationLabel)
              <span class="hidden rounded-full bg-[#ebe3a7] px-3 py-1 text-[11px] font-black uppercase tracking-[0.12em] text-[#113e14] sm:inline-flex" data-relation-label>
                {{ person.relationLabel }}
              </span>
            @endif
            @if(canManage)
              @form({
                action: '/users/' + person.username + '/follow',
                method: 'POST',
                'data-relation-unfollow-form': true,
                'data-relation-user-id': person.id,
                'data-was-friend': person.relationLabel === 'Friend' ? 'true' : 'false'
              })
                <button type="submit" class="rounded-full bg-[#dca15d] px-3 py-2 text-xs font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]" data-relation-unfollow-button>
                  Unfollow
                </button>
              @end
            @endif
          </div>
        @else
          <div class="rounded-[1.5rem] border border-dashed border-[#416543]/35 bg-white/50 p-6 text-center">
            <p class="text-sm font-black text-[#113e14]">Not following anyone yet</p>
            <p class="mt-1 text-xs font-semibold leading-5 text-[#416543]">Follow people from the community to build this list.</p>
          </div>
        @end
      </div>

      @if(showFriends)
        <div class="hidden space-y-3" data-profile-relations-panel="friends">
          @each(person in relations.friends)
            <div class="flex items-center gap-3 rounded-[1.35rem] border border-[#416543]/10 bg-white/75 p-3 shadow-sm transition hover:-translate-y-0.5 hover:bg-white" data-relation-user-id="{{ person.id }}">
              <a href="/users/{{ person.username }}" class="flex min-w-0 flex-1 items-center gap-3">
                @if(person.avatarUrl)
                  <img src="{{ person.avatarUrl }}" alt="" class="h-12 w-12 flex-none rounded-full object-cover shadow-sm">
                @else
                  <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-[#113e14] text-sm font-black text-[#ebe3a7] shadow-sm">
                    {{ person.initial }}
                  </span>
                @endif
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-black text-[#113e14]">{{ person.displayName }}</span>
                  <span class="block truncate text-xs font-bold text-[#416543]">{{ '@' + person.username }} - {{ person.roleLabel }}{{ person.isPremium ? ' - Premium' : '' }}</span>
                </span>
              </a>
              <span class="hidden rounded-full bg-[#ebe3a7] px-3 py-1 text-[11px] font-black uppercase tracking-[0.12em] text-[#113e14] sm:inline-flex" data-relation-label>
                Friend
              </span>
              @if(canManage)
                @form({
                  action: '/users/' + person.username + '/follow',
                  method: 'POST',
                  'data-relation-unfollow-form': true,
                  'data-relation-user-id': person.id,
                  'data-was-friend': 'true'
                })
                  <button type="submit" class="rounded-full bg-[#dca15d] px-3 py-2 text-xs font-black text-[#113e14] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#ebe3a7]" data-relation-unfollow-button>
                    Unfollow
                  </button>
                @end
              @endif
            </div>
          @else
            <div class="rounded-[1.5rem] border border-dashed border-[#416543]/35 bg-white/50 p-6 text-center">
              <p class="text-sm font-black text-[#113e14]">No friends yet</p>
              <p class="mt-1 text-xs font-semibold leading-5 text-[#416543]">Friends appear here when both accounts follow each other.</p>
            </div>
          @end
        </div>
      @endif
    </div>
  </section>
</div>
