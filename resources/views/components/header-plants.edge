@let(careHref = $props.get('careHref') ?? '/care1')

<div class="relative z-[99999] px-4 pt-6 sm:px-8 lg:px-10">
  <img decoding="async" src="/resources/images/welcome/header3.png" class="absolute inset-0 -z-20 h-full w-full object-cover" alt="">
  <div class="absolute inset-0 -z-10 bg-black/40"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-[#1E3D19]/10 via-[#728B6F]/10 to-[#6B8C6C]"></div>

  @!component('components/app-navbar', {
    section: 'Plant catalog',
    catalogSearch: true,
    maxWidth: 'max-w-[min(1500px,calc(100vw-2rem))]',
    showProfileText: false,
  })

  <section class="relative z-0 mx-auto mt-8 max-w-[1500px] pb-8">
    <div class="relative overflow-hidden rounded-[40px] shadow-2xl">
      <img decoding="async" src="/{{ imageBg }}" alt="hero" class="h-[420px] w-full object-cover">
      <div class="absolute inset-0 bg-gradient-to-r from-[#113E14]/70 to-transparent"></div>

      <div class="absolute inset-0 px-8 pt-10 sm:px-16 sm:pt-16">
        <div class="flex justify-end">
          <button onclick="window.location.href='{{ careHref }}'" class="rounded-full bg-white px-12 py-2 font-abril text-2xl text-[#113E14] shadow-[0_10px_30px_rgba(0,0,0,0.12)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:bg-[#113E14] hover:text-white sm:px-24 sm:text-3xl">
            Care
          </button>
        </div>

        <div class="mt-12 max-w-xl">
          <h1 class="font-abril text-5xl leading-none text-[#f7f5f0] sm:text-6xl">{{ title }}</h1>

          <p class="mt-6 max-w-md text-lg leading-relaxed text-white/80">
            {{ text }}
          </p>
        </div>
      </div>
    </div>
  </section>
</div>
